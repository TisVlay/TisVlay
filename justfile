# tisvlay project tasks
#
# Run `just` (or `just --list`) to see all recipes, grouped by purpose.
# This justfile is the canonical source of truth for project commands -
# prek hooks, VSCode tasks, and CI workflows all dispatch through here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Default recipe: list all available recipes, grouped.
default:
    @just --list --unsorted

# --- Quality checks (prek hooks + CI) -----------------------------------

# Format all Rust code
[group('check')]
fmt:
    cargo fmt

# Build the workspace (test profile, all targets, all features)
[group('check')]
build:
    cargo build --profile test --workspace --all-targets --all-features

# Run clippy with warnings denied
[group('check')]
clippy:
    cargo clippy --profile test --workspace --all-targets --all-features -- -D warnings

# Run the test suite with cargo-nextest (parallel, process-per-test isolation)
[group('check')]
test:
    cargo nextest run --workspace --all-features
    cargo test --workspace --all-features --doc

# Run tests under coverage instrumentation (CI): produces JUnit XML via
# the 'ci' nextest profile, coverage data, then generates lcov.info and
# checks the ratchet - all from one test run. Doc tests run separately
# without coverage (stable rustc doesn't support doctest coverage).
[group('check')]
test-ci:
    NEXTEST_PROFILE=ci cargo llvm-cov --no-report nextest --workspace --all-features
    cargo test --workspace --all-features --doc
    cargo llvm-cov report {{ cov_exclude }} --lcov --output-path lcov.info
    cargo llvm-cov report {{ cov_exclude }} --fail-under-lines {{ cov_baseline_lines }} --summary-only

# Run all fast checks in order (what prek runs)
[group('check')]
check: fmt build clippy test

# Review pending snapshot changes (insta)
[group('check')]
test-snapshot-review:
    cargo insta review

# Accept all pending snapshot changes (insta)
[group('check')]
test-snapshot-accept:
    cargo insta accept

# --- i18n / translation catalogs ---------------------------------------
#
# `i18n-extract` rebuilds `tisvlay-gui.pot` (the translation template)
# from both Rust source (via xgettext on `gettext("…")` calls) and
# Slint source (via slint-tr-extractor on `@tr("…")` literals). Run
# this whenever user-facing strings change.
#
# `i18n-update` merges the refreshed .pot into existing per-locale
# `.po` files, marking new entries fuzzy and obsoleting removed ones.
#
# `.mo` files are generated by `slint_build` at compile time, so
# there's no separate compile recipe — `cargo build` after editing a
# `.po` is enough to refresh runtime catalogs.
gui_lang_dir := "crates/tisvlay-gui/lang"
gui_pot := gui_lang_dir + "/tisvlay-gui.pot"

# Extract translatable strings from Rust + Slint into the .pot template.
[group('check')]
i18n-extract:
    @mkdir -p {{ gui_lang_dir }}
    # Rust pass: xgettext on every gettext()/ngettext() call site.
    xgettext --language=Rust --keyword=gettext --keyword=ngettext:1,2 \
        --from-code=UTF-8 --package-name=tisvlay-gui \
        --copyright-holder='TisVlay contributors' \
        --output={{ gui_pot }} \
        $(find crates/tisvlay-gui/src -name '*.rs')
    # Slint pass: append @tr() strings to the same .pot via --join-existing.
    slint-tr-extractor --join-existing --default-domain=tisvlay-gui \
        --package-name=tisvlay-gui \
        -o {{ gui_pot }} \
        $(find crates/tisvlay-gui/ui -name '*.slint')
    @echo "Wrote {{ gui_pot }} — review and commit."

# Merge the refreshed .pot into every existing per-locale .po file.
[group('check')]
i18n-update: i18n-extract
    @for po in {{ gui_lang_dir }}/*/LC_MESSAGES/tisvlay-gui.po; do \
        if [ -f "$po" ]; then \
            echo "Merging into $po"; \
            msgmerge --update --backup=none "$po" {{ gui_pot }}; \
        fi; \
    done

# --- Coverage -----------------------------------------------------------

# Baseline line-coverage percentage. Bump on PRs that improve coverage.
cov_baseline_lines := "49"

# Exclude test infrastructure from coverage reports - measure production
# code only. Matches crate names and test-only modules.
cov_exclude := "--ignore-filename-regex '(tisvlay-(test|mock|harness)/|test_server)'"

# Run tests under coverage instrumentation (shared by all cov-* recipes).
[private]
_cov-collect:
    cargo llvm-cov --no-report nextest --workspace --all-features
    cargo test --workspace --all-features --doc

# Text summary of workspace coverage
[group('coverage')]
cov: _cov-collect
    cargo llvm-cov report {{ cov_exclude }} --summary-only

# HTML coverage report (opens in browser)
[group('coverage')]
cov-html: _cov-collect
    cargo llvm-cov report {{ cov_exclude }} --html --open

# Generate lcov.info for VS Code Coverage Gutters
[group('coverage')]
cov-lcov: _cov-collect
    cargo llvm-cov report {{ cov_exclude }} --lcov --output-path lcov.info
    @echo "Wrote lcov.info - point VS Code Coverage Gutters at it."

# Ratchet check - fails if below `lines` percent (default: cov_baseline_lines)
[group('coverage')]
cov-ratchet lines=cov_baseline_lines: _cov-collect
    cargo llvm-cov report {{ cov_exclude }} --fail-under-lines {{ lines }} --summary-only

# --- Dev run targets ----------------------------------------------------

_daemon_log := "debug,zbus=warn,rustls=warn,tungstenite=warn"
_session_log := "debug,zbus=warn"
_tray_log := "debug,zbus=warn,ksni=warn"
_gui_log := "debug,zbus=warn,slint=warn,winit=warn"

# Start the daemon on the session bus (dev mode)
[group('dev')]
daemon-start:
    RUST_LOG="{{ _daemon_log }}" cargo run --bin tisvlayd -- --session --config docs/configs/daemon.toml

# Start the daemon on the system bus (requires sudo)
[group('dev')]
daemon-start-system:
    cargo build --bin tisvlayd
    RUST_LOG="{{ _daemon_log }}" sudo -E ./target/debug/tisvlayd --config docs/configs/daemon.toml

# Start the session service on the user session bus
[group('dev')]
session-start:
    RUST_LOG="{{ _session_log }}" cargo run --bin tisvlay-session -- --user --config docs/configs/session.toml

# Start the session service on the system bus
[group('dev')]
session-start-system:
    RUST_LOG="{{ _session_log }}" cargo run --bin tisvlay-session -- --config docs/configs/session.toml

# Start the tray on the user session bus
[group('dev')]
tray-start:
    RUST_LOG="{{ _tray_log }}" cargo run --bin tisvlay-tray -- --user

# Start the tray on the system bus
[group('dev')]
tray-start-system:
    RUST_LOG="{{ _tray_log }}" cargo run --bin tisvlay-tray

# Start the GUI on the user session bus (paired with `daemon-start`)
[group('dev')]
gui-start:
    RUST_LOG="{{ _gui_log }}" cargo run --bin tisvlay-gui -- --user

# Start the GUI on the system bus
[group('dev')]
gui-start-system:
    RUST_LOG="{{ _gui_log }}" cargo run --bin tisvlay-gui

# Kill all running dev processes
[group('dev')]
stop-all:
    -pkill -f 'target/debug/tisvlayd'
    -pkill -f 'target/debug/tisvlay-session'
    -pkill -f 'target/debug/tisvlay-tray'
    -pkill -f 'target/debug/tisvlay-gui'
    @echo "All stopped"

# Show CLI status (manual smoke test)
[group('dev')]
cli-status:
    cargo run --bin tisvlay -- --user status

# --- Packaging ----------------------------------------------------------

# Glibc baseline for the release build. Anything ≥ this version
# (Ubuntu 20.04, Debian 11, Fedora 33, RHEL 9, …) can install the
# resulting .deb/.rpm. Bump cautiously — older anchors widen the
# install matrix at the cost of newer libc syscalls.
glibc_baseline := "2.31"

# Build the five shipped binaries with cargo-zigbuild against an
# explicit glibc baseline. Zig is used as the linker so the resulting
# ELF interpreter is the standard `/lib64/ld-linux-x86-64.so.2`
# (no Nix-store path baked in) and the binary loads on any distro at
# or newer than `glibc_baseline`. tisvlay-gui pulls libfontconfig at
# link time and dlopens GL/Wayland/X11 at runtime; both work cleanly
# under glibc-dynamic. Output lands in target/x86_64-unknown-linux-gnu
# /release/ — zigbuild strips the version suffix when invoking cargo.
[private]
package-build:
    cargo zigbuild --release \
        --target x86_64-unknown-linux-gnu.{{ glibc_baseline }} \
        -p tisvlayd \
        -p tisvlay-cli \
        -p tisvlay-session \
        -p tisvlay-tray \
        -p tisvlay-gui

# Build .deb package
[group('package')]
package-deb: package-build
    cargo nfpm package -p tisvlayd --no-build --target x86_64-unknown-linux-gnu -f deb

# Build .rpm package
[group('package')]
package-rpm: package-build
    cargo nfpm package -p tisvlayd --no-build --target x86_64-unknown-linux-gnu -f rpm

# Build Arch Linux package
[group('package')]
package-archlinux: package-build
    cargo nfpm package -p tisvlayd --no-build --target x86_64-unknown-linux-gnu -f archlinux

# Build all package formats
[group('package')]
package-all: package-deb package-rpm package-archlinux
