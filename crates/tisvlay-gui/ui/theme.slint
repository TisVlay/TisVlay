// Design tokens for tisvlay-gui.
//
// Single source of truth, ported from the Claude Design agent's handoff
// at .claude/ui/design_handoff_tisvlay_gui/app-shell.jsx (`APP_T`). Every
// token branches on `dark-mode`; consumers reference `Theme.token-name`
// without caring which variant they get.
//
// `dark-mode` is a thin alias over `Palette.color-scheme`, which is
// driven by `xdg-desktop-portal`'s
// `org.freedesktop.appearance / color-scheme` via Slint's winit
// backend. Live DE theme changes propagate through the binding chain
// without code on our end. The app intentionally has no override —
// users get whatever the desktop reports.
//
// When adding a new token: add the property here, fall back to a sensible
// dark-mode value, and reference it via `Theme.foo` from components.

import { Palette } from "std-widgets.slint";

export global Theme {
    /// Convenience alias for `Palette.color-scheme == ColorScheme.dark`,
    /// kept so brush bindings stay short. Reactive: portal change →
    /// `Palette.color-scheme` updates → this re-evaluates → all
    /// downstream brushes re-evaluate.
    out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;

    // -- Surfaces --
    out property <brush> surface: dark-mode ? #232730 : #ffffff;
    out property <brush> surface2: dark-mode ? #2b2f39 : #f4f5f7;
    out property <brush> surface-alt: dark-mode ? #262a33 : #f9fafb;

    // -- Sidebar --
    //
    // Theme-aware: in light mode the sidebar is a tinted off-white
    // that reads as "panel chrome" against the lighter content
    // surface-alt; in dark mode it drops to a near-black that
    // frames the surface above it. Selected items always render
    // with the live `accent`; hover tints subtly toward the active
    // scheme.
    out property <brush> sidebar: dark-mode ? #14171c : #f4f5f7;
    out property <brush> sidebar-text: dark-mode ? #cfd4dc : #1a1d22;
    out property <brush> sidebar-text-dim: dark-mode ? #6f7682 : #5b626d;
    out property <color> sidebar-selected: accent;
    out property <brush> sidebar-hover: dark-mode ? #1f232b : #e6e7ea;

    // -- Borders --
    out property <brush> border: dark-mode ? #383d48 : #dcdfe4;
    out property <brush> border-strong: dark-mode ? #4a4f5b : #c2c7d0;

    // -- Text --
    out property <brush> text: dark-mode ? #eef0f3 : #1a1d22;
    out property <brush> text-dim: dark-mode ? #a4abb6 : #5b626d;
    out property <brush> text-faint: dark-mode ? #6f7682 : #8a909a;

    // -- Accent --
    //
    // `accent` is the user's DE-chosen accent color. Rust pushes it
    // here at startup and on `SettingChanged` from
    // `org.freedesktop.appearance.accent-color` (xdg-desktop-portal
    // 1.18+, supported by KDE 6 / GNOME 46+ / Cosmic / Elementary).
    // When the portal isn't available or the user has no preference,
    // the binding stays at the Breeze blue default below.
    in-out property <color> accent: #3daee9;
    // Hover / pressed state for filled accent buttons. Light mode
    // darkens, dark mode brightens, so the bg shift stays visible
    // against the surface in either scheme. Used by custom filled
    // accent surfaces (e.g. the "+" pair button) — std-widgets
    // `Button` handles its own hover via the active style.
    out property <color> accent-pressed: dark-mode
        ? accent.brighter(0.18)
        : accent.darker(0.22);
    // Selection background — accent at low alpha, alpha-composited
    // onto the surface underneath. Higher alpha in dark mode keeps
    // the tint visible against the darker bg.
    out property <color> accent-soft: dark-mode
        ? accent.with-alpha(0.25)
        : accent.with-alpha(0.15);

    // -- Status colors --
    out property <brush> success: dark-mode ? #34d399 : #10b981;
    out property <brush> success-soft: dark-mode ? #1a3a32 : #d1fae5;
    out property <brush> success-text: dark-mode ? #6ee7b7 : #047857;

    out property <brush> danger: dark-mode ? #f87171 : #dc2626;
    out property <brush> danger-soft: dark-mode ? #3a1c1c : #fee2e2;
    out property <brush> danger-text: dark-mode ? #fca5a5 : #b91c1c;
    /// Hover/pressed state for filled danger buttons. Same shape as
    /// `accent-pressed` — preserves white text legibility on hover.
    out property <brush> danger-pressed: dark-mode ? #fca5a5 : #b91c1c;

    out property <brush> warn: dark-mode ? #fbbf24 : #d97706;
    out property <brush> warn-soft: dark-mode ? #3a2e0e : #fef3c7;
    out property <brush> warn-text: dark-mode ? #fcd34d : #92400e;

    // -- Chips / inline tags --
    out property <brush> chip: dark-mode ? #323744 : #eef0f3;
    out property <brush> chip-text: dark-mode ? #cfd4dc : #374151;
    out property <brush> chip-border: dark-mode ? #3f4452 : #dcdfe4;

    // -- List rows --
    out property <brush> row-hover: dark-mode ? #2b2f39 : #f4f5f7;
    out property <brush> row-selected: dark-mode ? #1c3a4d : #e3f3fc;
    out property <brush> row-selected-text: dark-mode ? #a5d8f0 : #0e6e9c;
}
