// Design tokens — sizing, spacing, typography.
//
// Parallel to `theme.slint` (which holds color tokens). This file
// contains theme-independent metric tokens. Same naming convention as
// Theme: short, role-based identifiers; the consumer references
// `Design.token-name` without caring which value it resolves to.
//
// Typography ramp follows Fluent 2's pattern (title-1/2/3 + section +
// body/meta/helper/caption/mini) — multiple title levels rather than a
// single "page title." See https://fluent2.microsoft.design/typography
//
// When adding a new token: prefer reusing an existing one before
// introducing a new value. New tokens belong to the smallest set that
// still expresses intent at the call site.

export global Design {
    // -- Spacing --
    out property <length> pad-pane: 24px;          // pane horizontal padding
    out property <length> pad-pane-top: 28px;      // pane top padding (titles)
    out property <length> pad-card: 14px;          // Group / card body padding
    out property <length> gap-pane: 16px;          // between Groups in a pane
    out property <length> gap-row: 14px;           // between row siblings (label+control)
    out property <length> gap-form: 4px;           // helper text below control
    out property <length> gap-stack: 8px;          // related vertical items
    out property <length> gap-tight: 6px;          // chip rows, status pairs

    // -- Component sizing --
    out property <length> size-input: 32px;        // buttons, inputs, comboboxes
    out property <length> size-sidebar-item: 36px;
    out property <length> size-tile-sm: 28px;      // vendor tile in list rows
    out property <length> size-tile-md: 40px;      // vendor tile in detail header
    out property <length> size-status-dot: 6px;

    // -- Layout widths --
    out property <length> width-sidebar: 110px;
    out property <length> width-master: 160px;     // TVs master list
    out property <length> width-label-col: 110px;  // form label column
    out property <length> width-readout-col: 36px; // slider value readout

    // -- Borders / radii --
    out property <length> radius-control: 4px;     // buttons, inputs, dropdowns
    out property <length> radius-card: 6px;        // Groups, modals
    out property <length> radius-pill: 10px;       // chips
    out property <length> border-thin: 1px;

    // -- Opacity --
    out property <float> opacity-disabled: 0.4;    // dimmed disabled controls

    // -- Typography (Fluent-style ramp) --
    out property <length> font-title-1: 28px;      // hero title (About splash)
    out property <length> font-title-2: 24px;      // pane titles
    out property <length> font-title-3: 20px;      // section / modal titles
    out property <length> font-section: 18px;      // sub-section headings
    out property <length> font-body: 13px;         // default
    out property <length> font-meta: 12.5px;       // form labels
    out property <length> font-helper: 12px;       // descriptions
    out property <length> font-caption: 11.5px;    // status, captions
    out property <length> font-mini: 11px;         // chip labels
}
