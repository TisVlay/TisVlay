// AppWindow root.
//
// Architecture:
//   - Cross-pane callbacks live on globals (`Daemon`,
//     `PairingWizard`) — components call e.g. `Daemon.set-volume(...)`
//     directly instead of forwarding through every parent.
//   - Theming follows `Palette.color-scheme` (live xdg-desktop-portal),
//     no app-level appearance toggle.
//   - Convergence gating for slider values lives in Rust
//     (`tisvlay-core::ReconcilerMap`); Slint stays a thin view.
//   - Animations: see `widgets.slint` (`PulseDot`, `SpinnerArc`,
//     `ScanLine`) and the per-call-site `animate background { ... }`
//     hover transitions, all aligned with
//     `.claude/ui/pairing-wizard-motion.md`.

import { Button, VerticalBox, HorizontalBox, ListView, ScrollView, GroupBox, StandardButton } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Design } from "design.slint";
import { Daemon } from "globals/daemon.slint";
import { Tray, TrayNotificationSettings } from "globals/tray.slint";
import { PairingWizard } from "globals/pairing_wizard.slint";
import { EditPane } from "globals/edit_pane.slint";
import { Clipboard } from "globals/clipboard.slint";
import { Errors } from "globals/errors.slint";
import { Icons } from "globals/icons.slint";
import { Profiles, ProfileKind, ProfileRow, ProfileTvRef, ProfileFieldEntry } from "globals/profiles.slint";
import { Toast, ToastView } from "globals/toast.slint";
import { Help, HelpOverlay } from "globals/help.slint";
import { TvsPane, TvViewModel, WizardDiscoveredTv, VendorOption } from "components/tvs_pane.slint";
import { ProfilesPane } from "components/profiles_pane.slint";
import { SettingsPane } from "components/settings_pane.slint";
import { AboutPane, AboutComponentRow } from "components/about_pane.slint";

export { TvViewModel, Theme, WizardDiscoveredTv, VendorOption, Daemon, Tray, TrayNotificationSettings, PairingWizard, EditPane, Clipboard, Errors, Icons, Profiles, ProfileKind, ProfileRow, ProfileTvRef, ProfileFieldEntry, Toast }

export enum Pane {
    tvs,
    profiles,
    settings,
    about,
}

// Sidebar entry. Optional `icon` (a freedesktop-resolved symbolic
// SVG loaded from the user's icon theme — see `main.rs::load_themed_icon`)
// renders left-of-label, tinted to white when selected and
// `Theme.sidebar-text` otherwise. If the icon failed to resolve the
// `image` property is empty and Slint draws nothing in its slot —
// the layout degrades to label-only without surrounding rework.
component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    height: Design.size-sidebar-item;
    background: selected ? Theme.sidebar-selected
              : (touch.has-hover ? Theme.sidebar-hover : transparent);
    border-radius: 5px;
    animate background { duration: 150ms; }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 10px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.selected ? white : Theme.sidebar-text;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.selected ? white : Theme.sidebar-text;
                font-size: Design.font-body;
                font-weight: root.selected ? 600 : 500;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "TisVlay";
    preferred-width: 720px;
    preferred-height: 480px;
    min-width: 720px;
    min-height: 480px;

    // TV-state model (read-only from Slint's perspective; Rust pushes
    // updates via `app.set_tvs(...)`). Writes go through the Daemon
    // global's callbacks.
    in property <[TvViewModel]> tvs;
    // Precomputed count of TVs with `connected == true`. Pushed by
    // Rust alongside `tvs` because Slint can't aggregate over a
    // model in pure-binding context. Drives the master-list header's
    // "N/M CONNECTED" ratio.
    in property <int> tvs-connected-count;
    in property <bool> daemon-available: false;
    in property <bool> session-available: false;
    in property <bool> tray-available: false;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in property <string> gui-version;
    in property <[AboutComponentRow]> about-components;
    callback view-notices-clicked();
    in-out property <int> selected-tv-index: -1;
    in-out property <Pane> active-pane: Pane.tvs;

    // Browser-style history navigation (Alt+Left/Right, mouse back/forward).
    // `navigate` is the single choke point for pane changes (sidebar +
    // Rust click-throughs); `nav-back` / `nav-forward` replay the
    // Rust-owned history. `nav-enabled` keeps the shortcuts inert while
    // the pairing wizard or a TV config edit owns the view.
    callback navigate(Pane);
    callback nav-back();
    callback nav-forward();
    out property <bool> nav-enabled: !PairingWizard.active && EditPane.tv-uuid == "";
    forward-focus: nav-scope;

    // About-pane button callbacks (Rust handles URL launch + clipboard write).
    callback view-source-clicked();
    callback view-release-clicked();
    callback report-issue-clicked();
    callback copy-diagnostic-clicked();
    // Per-row "reveal config in file manager" callback. Rust forwards
    // the path to `org.freedesktop.FileManager1.ShowItems`.
    callback open-config-folder(string);

    // Sidebar glyphs — Rust resolves these against the user's
    // freedesktop icon theme at startup (see `main.rs`). Empty
    // images render as blank, so missing names degrade to
    // label-only without errors.
    in property <image> tvs-icon;
    in property <image> profiles-icon;
    in property <image> settings-icon;
    in property <image> about-icon;
    // App-identity glyph for the About pane header. Resolved
    // against `video-display` to match the `.desktop` entry's
    // `Icon=` and the tray's connected-state icon. Decoupled from
    // `about-icon` so the sidebar's About row keeps a distinct
    // info-style glyph (`help-about`).
    in property <image> app-logo;

    // Daemon callbacks moved to `Daemon` global (globals/daemon.slint).
    // Wizard callbacks + state moved to `PairingWizard` global
    // (globals/pairing_wizard.slint). Appearance follows
    // `Palette.color-scheme` directly — no app-level setting.

    nav-scope := FocusScope {
        width: 100%;
        height: 100%;
        // Global Alt+Left/Right history nav. As an ancestor of every
        // pane it catches the arrows bubbling up from whatever child
        // holds focus; a text input that consumes Alt+arrow (word-jump)
        // wins first, so we don't steal keys mid-edit. `nav-enabled`
        // covers the modal/edit flows that don't hold key focus.
        key-pressed(event) => {
            if (root.nav-enabled && event.modifiers.alt && event.text == Key.LeftArrow) {
                root.nav-back();
                return accept;
            }
            if (root.nav-enabled && event.modifiers.alt && event.text == Key.RightArrow) {
                root.nav-forward();
                return accept;
            }
            return reject;
        }

        HorizontalBox {
            width: 100%;
            height: 100%;
            padding: 0;
            spacing: 0;

            // Sidebar
            Rectangle {
                width: Design.width-sidebar;
                background: Theme.sidebar;

                VerticalBox {
                    padding: Design.gap-stack;
                    spacing: 2px;

                    Text {
                        text: "TisVlay";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.sidebar-text;
                        letter-spacing: 0.2px;
                        horizontal-alignment: center;
                        height: Design.size-sidebar-item;
                        vertical-alignment: center;
                    }

                    SidebarItem {
                        icon: root.tvs-icon;
                        label: @tr("TVs");
                        selected: root.active-pane == Pane.tvs;
                        accessible-id: "sidebar-tvs";
                        clicked => { root.navigate(Pane.tvs); }
                    }
                    SidebarItem {
                        icon: root.profiles-icon;
                        label: @tr("Profiles");
                        selected: root.active-pane == Pane.profiles;
                        accessible-id: "sidebar-profiles";
                        clicked => { root.navigate(Pane.profiles); }
                    }
                    SidebarItem {
                        icon: root.settings-icon;
                        label: @tr("Settings");
                        selected: root.active-pane == Pane.settings;
                        accessible-id: "sidebar-settings";
                        clicked => { root.navigate(Pane.settings); }
                    }
                    SidebarItem {
                        icon: root.about-icon;
                        label: @tr("About");
                        selected: root.active-pane == Pane.about;
                        accessible-id: "sidebar-about";
                        clicked => { root.navigate(Pane.about); }
                    }

                    // Spacer pushes status to bottom
                    Rectangle { vertical-stretch: 1; }

                    // Reload daemon config — power-user action. The daemon
                    // re-reads `~/.config/tisvlay/config.toml` from disk;
                    // useful only when someone edited the file outside the
                    // GUI. Sits above the daemon/session status because
                    // it's a daemon-scoped action.
                    Rectangle {
                        height: 28px;
                        background: reload-touch.has-hover && root.daemon-available
                            ? Theme.sidebar-hover
                            : transparent;
                        border-radius: 5px;
                        animate background { duration: 150ms; }

                        accessible-role: button;
                        accessible-label: @tr("Reload daemon config");
                        accessible-enabled: root.daemon-available;
                        accessible-id: "sidebar-reload";
                        accessible-action-default => {
                            if (root.daemon-available) {
                                Daemon.reload-config();
                            }
                        }

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: Design.gap-tight;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.reload;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.daemon-available
                                        ? Theme.sidebar-text
                                        : Theme.sidebar-text-dim;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Reload");
                                    color: root.daemon-available
                                        ? Theme.sidebar-text
                                        : Theme.sidebar-text-dim;
                                    font-size: Design.font-caption;
                                }
                            }
                        }

                        reload-touch := TouchArea {
                            enabled: root.daemon-available;
                            clicked => { Daemon.reload-config(); }
                        }
                    }

                    // Footer status block — three peer indicators (Daemon /
                    // Session / Tray) grouped together and centred within
                    // the sidebar. Each row is a single left-aligned Text
                    // (dot glyph + label), so the dots naturally share an
                    // x-coord (the row's left edge); wrapping the whole
                    // VerticalLayout in a centred HorizontalLayout shifts
                    // the block into the middle of the sidebar without
                    // disturbing per-row layout.
                    HorizontalLayout {
                        alignment: center;
                        padding-bottom: Design.gap-stack;
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 0;
                            Text {
                                text: (root.daemon-available ? "● " : "○ ") + @tr("Daemon");
                                color: root.daemon-available ? Theme.success : Theme.danger;
                                font-size: Design.font-caption;
                                horizontal-alignment: left;
                            }
                            Text {
                                text: (root.session-available ? "● " : "○ ") + @tr("Session");
                                color: root.session-available ? Theme.success : Theme.danger;
                                font-size: Design.font-caption;
                                horizontal-alignment: left;
                            }
                            Text {
                                text: (root.tray-available ? "● " : "○ ") + @tr("Tray");
                                color: root.tray-available ? Theme.success : Theme.danger;
                                font-size: Design.font-caption;
                                horizontal-alignment: left;
                            }
                        }
                    }
                }
            }

            // Content area
            Rectangle {
                background: Theme.surface-alt;
                horizontal-stretch: 1;

                // Each pane is positioned absolutely within this Rectangle.
                // Slint Rectangles don't lay out children, so panes must
                // bind width / height to the parent explicitly.
                if root.active-pane == Pane.tvs: TvsPane {
                    width: 100%;
                    height: 100%;
                    tvs: root.tvs;
                    tvs-connected-count: root.tvs-connected-count;
                    selected-index <=> root.selected-tv-index;
                    daemon-available: root.daemon-available;
                    system-profiles: root.system-profiles;
                    user-profiles: root.user-profiles;
                }
                if root.active-pane == Pane.profiles: ProfilesPane {
                    width: 100%;
                    height: 100%;
                }
                if root.active-pane == Pane.settings: SettingsPane {
                    width: 100%;
                    height: 100%;
                }
                if root.active-pane == Pane.about: AboutPane {
                    width: 100%;
                    height: 100%;
                    gui-version: root.gui-version;
                    components: root.about-components;
                    logo: root.app-logo;
                    view-source-clicked => { root.view-source-clicked(); }
                    view-release-clicked => { root.view-release-clicked(); }
                    view-notices-clicked => { root.view-notices-clicked(); }
                    report-issue-clicked => { root.report-issue-clicked(); }
                    copy-diagnostic-clicked => { root.copy-diagnostic-clicked(); }
                    open-config-folder(p) => { root.open-config-folder(p); }
                }
            }
        }
    }

    // Top-centre toast — declared after the HorizontalBox so it
    // renders on top of the panes. Positioned by `x`/`y` rather than
    // a layout because we want it to float over the chrome (titlebar
    // edge included), not inside the sidebar+pane split. Auto-clears
    // via Rust-side timer (see `show_toast` in main.rs).
    ToastView {
        x: (root.width - self.width) / 2;
        y: 24px;
    }

    // Contextual-help bubble overlay. Rendered last (top-most) and at
    // the window root so it escapes the panes' clipping ScrollView and
    // can place itself against the window bounds. Driven by the `Help`
    // global; see globals/help.slint.
    HelpOverlay { }
}
