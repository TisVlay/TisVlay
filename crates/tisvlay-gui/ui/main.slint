import { Button, VerticalBox, HorizontalBox, ListView, ScrollView, GroupBox, StandardButton } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TvsPane, TvViewModel } from "components/tvs_pane.slint";
import { ProfilesPane } from "components/profiles_pane.slint";
import { SessionPane } from "components/session_pane.slint";
import { AboutPane } from "components/about_pane.slint";

export { TvViewModel, Theme }

export enum Pane {
    tvs,
    profiles,
    session,
    about,
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 36px;
    background: selected ? Theme.sidebar-selected
              : (touch.has-hover ? Theme.sidebar-hover : transparent);
    border-radius: 5px;

    Text {
        text: label;
        color: selected ? white : Theme.sidebar-text;
        font-size: 13px;
        font-weight: selected ? 600 : 500;
        x: 12px;
        vertical-alignment: center;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "tisvlay";
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;

    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available: false;
    in property <bool> session-available: false;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in-out property <int> selected-tv-index: -1;
    in-out property <Pane> active-pane: Pane.tvs;
    /// Two-way bound to `Theme.dark-mode` so flipping this re-tints
    /// every component that reads from `Theme.*`. Set from Rust at
    /// startup; in-app toggle UI lands in a follow-up.
    in-out property <bool> dark-mode <=> Theme.dark-mode;

    callback set-volume(string, int);
    callback set-mute(string, bool);
    callback set-backlight(string, int);
    callback set-is-screen-on(string, bool);
    callback switch-input(string, string);
    callback power-on(string);
    callback power-off(string);
    callback set-managed(string, bool);
    callback set-system-profile(string, string);
    callback set-user-profile(string, string);
    callback set-primary-input(string, string);
    callback remove-tv(string);
    callback reload-config();
    callback request-pair();

    HorizontalBox {
        padding: 0;
        spacing: 0;

        // Sidebar
        Rectangle {
            width: 180px;
            background: Theme.sidebar;

            VerticalBox {
                padding: 8px;
                spacing: 2px;

                Text {
                    text: "tisvlay";
                    font-size: 16px;
                    font-weight: 700;
                    color: white;
                    letter-spacing: 0.2px;
                    horizontal-alignment: left;
                    height: 36px;
                    vertical-alignment: center;
                }

                SidebarItem {
                    label: "TVs";
                    selected: root.active-pane == Pane.tvs;
                    clicked => { root.active-pane = Pane.tvs; }
                }
                SidebarItem {
                    label: "Profiles";
                    selected: root.active-pane == Pane.profiles;
                    clicked => { root.active-pane = Pane.profiles; }
                }
                SidebarItem {
                    label: "Session";
                    selected: root.active-pane == Pane.session;
                    clicked => { root.active-pane = Pane.session; }
                }
                SidebarItem {
                    label: "About";
                    selected: root.active-pane == Pane.about;
                    clicked => { root.active-pane = Pane.about; }
                }

                // Spacer pushes status to bottom
                Rectangle { vertical-stretch: 1; }

                Text {
                    text: root.daemon-available ? "● Daemon" : "○ Daemon";
                    color: root.daemon-available ? Theme.success : Theme.danger;
                    font-size: 11.5px;
                    horizontal-alignment: left;
                }
                Text {
                    text: root.session-available ? "● Session" : "○ Session";
                    color: root.session-available ? Theme.success : Theme.danger;
                    font-size: 11.5px;
                    horizontal-alignment: left;
                }
            }
        }

        // Content area
        Rectangle {
            background: Theme.surface-alt;
            horizontal-stretch: 1;

            // Each pane is positioned absolutely within this Rectangle.
            // Slint Rectangles don't lay out children, so panes must
            // bind width / height to the parent explicitly.
            if root.active-pane == Pane.tvs: TvsPane {
                width: 100%;
                height: 100%;
                tvs: root.tvs;
                selected-index <=> root.selected-tv-index;
                daemon-available: root.daemon-available;
                system-profiles: root.system-profiles;
                user-profiles: root.user-profiles;

                set-volume(id, v) => { root.set-volume(id, v); }
                set-mute(id, m) => { root.set-mute(id, m); }
                set-backlight(id, b) => { root.set-backlight(id, b); }
                set-is-screen-on(id, s) => { root.set-is-screen-on(id, s); }
                switch-input(id, input) => { root.switch-input(id, input); }
                power-on(id) => { root.power-on(id); }
                power-off(id) => { root.power-off(id); }
                set-managed(id, m) => { root.set-managed(id, m); }
                set-system-profile(id, p) => { root.set-system-profile(id, p); }
                set-user-profile(id, p) => { root.set-user-profile(id, p); }
                set-primary-input(id, p) => { root.set-primary-input(id, p); }
                remove-tv(id) => { root.remove-tv(id); }
                reload-config => { root.reload-config(); }
                request-pair => { root.request-pair(); }
            }
            if root.active-pane == Pane.profiles: ProfilesPane {
                width: 100%;
                height: 100%;
            }
            if root.active-pane == Pane.session: SessionPane {
                width: 100%;
                height: 100%;
            }
            if root.active-pane == Pane.about: AboutPane {
                width: 100%;
                height: 100%;
                daemon-available: root.daemon-available;
                session-available: root.session-available;
            }
        }
    }
}
