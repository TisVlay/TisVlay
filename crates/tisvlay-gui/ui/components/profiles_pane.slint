// Profiles pane — master-detail with two stacked sections (System /
// User) in the left column and a single detail/editor on the right.
//
// Silhouette mirrors the TVs pane (left list + right detail), with
// two key divergences:
//
// - Sub-tabs live in the left column as stacked sections, not a top
//   segmented control. Gives the editor full vertical height; matches
//   KDE/GNOME settings sidebar idioms.
// - Detail has no live-state chrome (no power chip, no pencil/edit
//   mode); every field is instant-commit. The header carries
//   "Used by [chip][chip]" linking back to each referencing TV — the
//   "Find Usages" idiom (GitHub package "Used by", VS Code peek).
//
// Field rows land in the next commit; today the detail body is a
// placeholder so the master-detail wiring + selection model can be
// validated end-to-end first.

import { Button, ComboBox, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { Icons } from "../globals/icons.slint";
import { Profiles, ProfileKind, ProfileRow, ProfileTvRef, ProfileField } from "../globals/profiles.slint";
import { ConfirmDialog, DangerBtn, Chip, Group, IconBtn, InlineError, NameInputDialog } from "../widgets.slint";
import { Errors } from "../globals/errors.slint";

// =============================================================================
// Master list — left column, stacked System / User sections.
// =============================================================================

component ProfileListRow inherits Rectangle {
    in property <ProfileRow> entry;
    in property <bool> selected;
    callback clicked();

    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    height: 40px;
    background: selected ? Theme.row-selected
              : (touch.has-hover ? Theme.row-hover : transparent);
    animate background { duration: 150ms; }

    // 3px left accent stripe when selected — mirrors TvListRow.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: Design.gap-tight;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.entry.name;
                color: root.selected ? Theme.row-selected-text : Theme.text;
                font-size: Design.font-body;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
            }
        }

        if root.entry.is-default: VerticalLayout {
            alignment: center;
            Text {
                text: "(default)";
                color: Theme.text-dim;
                font-size: Design.font-mini;
            }
        }

        VerticalLayout {
            alignment: center;
            // Trailing reference count — "Nx" tells the user how many
            // TVs use this profile without opening the detail. Greys
            // out at zero so unreferenced profiles are visually quiet
            // ("safe to delete" cue).
            Text {
                text: root.entry.referenced-by.length + "x";
                color: root.entry.referenced-by.length == 0
                    ? Theme.text-faint
                    : Theme.text-dim;
                font-size: Design.font-mini;
                font-family: "ui-monospace, monospace";
            }
        }
    }

    // Bottom 1px separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ProfileSectionHeader inherits Rectangle {
    in property <string> title;
    /// `+` enabled flag. False when the corresponding daemon isn't
    /// reachable (no session bus → user-profile create disabled).
    in property <bool> add-enabled: true;
    callback add-clicked();

    height: 40px;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: Design.gap-stack;
        spacing: Design.gap-stack;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text-dim;
                font-size: Design.font-mini;
                font-weight: 600;
                letter-spacing: 0.6px;
            }
        }

        // "+" New-profile button — same shape as TvList's pair button.
        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: !root.add-enabled
                ? Theme.text-faint
                : (add-touch.has-hover ? Theme.accent-pressed : Theme.accent);
            animate background { duration: 150ms; }

            accessible-role: button;
            accessible-label: @tr("New profile");
            accessible-enabled: root.add-enabled;
            accessible-action-default => {
                if (root.add-enabled) {
                    root.add-clicked();
                }
            }

            Text {
                text: "+";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            add-touch := TouchArea {
                enabled: root.add-enabled;
                clicked => { root.add-clicked(); }
            }
        }
    }
}

component ProfileList inherits Rectangle {
    /// Bubble the "+" clicks up to the pane so it can open the
    /// name-input dialog. The section header itself can't host the
    /// dialog (it needs to render over the whole pane).
    callback request-create(ProfileKind);

    width: Design.width-master;
    background: Theme.surface-alt;

    // Right separator.
    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // System profiles section.
        ProfileSectionHeader {
            title: @tr("SYSTEM PROFILES");
            add-enabled: true;
            add-clicked => { root.request-create(ProfileKind.system); }
        }
        for r[i] in Profiles.system: ProfileListRow {
            entry: r;
            selected: Profiles.selected-kind == ProfileKind.system
                   && Profiles.selected-name == r.name;
            // Update the highlight state inline so the row visually
            // toggles before Rust completes the detail-fetch + push;
            // Rust then refreshes `selected-row` with the lookup.
            clicked => {
                Profiles.selected-kind = ProfileKind.system;
                Profiles.selected-name = r.name;
                Profiles.select(ProfileKind.system, r.name);
            }
        }

        // User profiles section.
        ProfileSectionHeader {
            title: @tr("USER PROFILES");
            add-enabled: Profiles.session-available;
            add-clicked => { root.request-create(ProfileKind.user); }
        }
        if !Profiles.session-available: Rectangle {
            height: 56px;
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-stack;
                Text {
                    text: @tr("Session service unavailable");
                    color: Theme.text-faint;
                    font-size: Design.font-mini;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // When the session bus isn't available, Rust pushes an empty
        // `Profiles.user` model — the repeater renders nothing and the
        // unavailable-notice above carries the message instead.
        for r[i] in Profiles.user: ProfileListRow {
            entry: r;
            selected: Profiles.selected-kind == ProfileKind.user
                   && Profiles.selected-name == r.name;
            clicked => {
                Profiles.selected-kind = ProfileKind.user;
                Profiles.selected-name = r.name;
                Profiles.select(ProfileKind.user, r.name);
            }
        }

        // Spacer pushes the lists to the top.
        Rectangle { vertical-stretch: 1; }
    }
}

// =============================================================================
// Detail — right column, fills remaining width.
// =============================================================================

component ProfileDetailHeader inherits Rectangle {
    in property <string> name;
    in property <[ProfileTvRef]> referenced-by;
    /// Disable Delete on the reserved `default` profile — the daemon
    /// rejects deletion of `default` outright. Greying the button
    /// keeps the affordance discoverable without dispatching a call
    /// the daemon will reject.
    in property <bool> can-delete: true;
    /// Bubble actions up to the pane; ProfilesPane owns the
    /// confirm-delete dialog and any disambiguation around the
    /// duplicate flow.
    callback request-delete();
    callback request-duplicate();

    height: header-layout.preferred-height;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    header-layout := VerticalLayout {
        width: 100%;
        padding-left: Design.pad-pane;
        padding-right: Design.pad-pane;
        padding-top: 18px;
        padding-bottom: Design.gap-row;
        spacing: Design.gap-form;

        // Title row: profile name (large) + per-profile action buttons.
        HorizontalLayout {
            spacing: Design.gap-row;
            alignment: stretch;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: Design.font-title-3;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Duplicate");
                    clicked => { root.request-duplicate(); }
                }
            }
            VerticalLayout {
                alignment: center;
                DangerBtn {
                    text: @tr("Delete");
                    enabled: root.can-delete;
                    clicked => { root.request-delete(); }
                }
            }
        }

        // "Used by" chip row — hidden when no TVs reference this profile.
        if root.referenced-by.length > 0: HorizontalLayout {
            spacing: Design.gap-tight;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Used by");
                    color: Theme.text-dim;
                    font-size: Design.font-meta;
                }
            }
            for tv in root.referenced-by: VerticalLayout {
                alignment: center;
                Chip {
                    label: tv.name;
                    tone: "info";
                    interactive: true;
                    clicked => { Profiles.open-tv(tv.uuid); }
                }
            }
        }
    }
}

// =============================================================================
// ProfileFieldRow — one inheritable field with gutter accent + reset glyph.
// =============================================================================
//
// Layout:
//   [ ▌ ]  [ 140px label ]  [ ComboBox flex ]  [ ↺? ]
//          locally-set?     model[0]=inherit   only when locally-set
//                                              + hover-revealed
//
// The 2 px gutter on the left fills when `entry.current-value != ""`
// (i.e. the field is locally set, overriding the inherit fallthrough).
// The reset glyph appears trailing the combobox on the same condition,
// becoming visible only while the row is hovered — keeps the
// inheriting rows visually quiet.
//
// ComboBox `model` is the full list including the inherit placeholder
// at index 0. Selecting that index OR clicking reset both surface as
// `value-edited(field-name, "")`; selecting any concrete entry
// surfaces as `value-edited(field-name, value)`.

component ProfileFieldRow inherits Rectangle {
    in property <ProfileField> entry;
    callback value-edited(string, string);

    /// True when the field has a locally-set value (i.e. is NOT
    /// inheriting). Drives gutter + reset-glyph visibility.
    property <bool> is-set: root.entry.current-value != "";

    height: row-layout.preferred-height;

    // 2 px left gutter accent — shows for locally-set fields.
    Rectangle {
        x: 0;
        width: Design.border-thin * 2;
        background: root.is-set ? Theme.accent : transparent;
    }

    row-layout := HorizontalLayout {
        width: 100%;
        padding-left: Design.gap-form;
        padding-top: Design.gap-form;
        padding-bottom: Design.gap-form;
        spacing: Design.gap-row;

        // Label column — same width token as the TVs-pane FormRow
        // so System / User editors visually align with the TV-detail
        // PROFILES section.
        VerticalLayout {
            width: Design.width-label-col;
            alignment: center;
            Text {
                text: root.entry.label;
                color: Theme.text;
                font-size: Design.font-body;
                overflow: elide;
            }
        }

        // ComboBox column. `current-value` is the literal locally-set
        // value when set; otherwise we drop back to `options[0]`, the
        // pre-built `(inherit: <X>)` placeholder string.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            ComboBox {
                model: root.entry.options;
                current-value: root.is-set
                    ? root.entry.current-value
                    : (root.entry.options.length > 0 ? root.entry.options[0] : "");
                enabled: root.entry.options.length > 0;
                selected(v) => {
                    // Normalize the inherit-placeholder back to "" so
                    // every "clear this field" path (combobox first
                    // entry, reset glyph) takes the same wire.
                    root.value-edited(
                        root.entry.field-name,
                        v == root.entry.options[0] ? "" : v,
                    );
                }
            }
        }

        // Reset glyph — only present when the field is locally set.
        // Reuses the existing reload icon (circular arrow) since
        // visually it's the same "revert to baseline" action as the
        // sidebar's reload-config button. IconBtn's ghost style
        // already dims at rest + brightens on hover, so the glyph
        // stays visually quiet until the user mouses over it — no
        // separate row-wide hover overlay needed (and a row-wide
        // TouchArea would swallow ComboBox clicks anyway).
        VerticalLayout {
            alignment: center;
            width: 28px;
            if root.is-set: IconBtn {
                source: Icons.reload;
                accessible-label: @tr("Reset to inherited");
                clicked => {
                    root.value-edited(root.entry.field-name, "");
                }
            }
        }
    }
}

component ProfileDetail inherits Rectangle {
    in property <string> name;
    in property <[ProfileTvRef]> referenced-by;
    in property <bool> can-delete: true;
    callback request-delete();
    callback request-duplicate();

    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        ProfileDetailHeader {
            name: root.name;
            referenced-by: root.referenced-by;
            can-delete: root.can-delete;
            request-delete => { root.request-delete(); }
            request-duplicate => { root.request-duplicate(); }
        }

        // Scrollable body — field rows from `Profiles.current-fields`
        // (pushed by Rust on selection + signal). When the list is
        // empty (initial fetch in flight, or a profile with no
        // inheritable fields), Slint just renders the empty Group
        // shell — no separate loading state.
        ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                width: 100%;
                padding-left: Design.pad-pane;
                padding-right: Design.pad-pane;
                padding-top: 20px;
                padding-bottom: Design.pad-pane;
                spacing: Design.gap-pane;

                Group {
                    title: @tr("FIELDS");
                    body-spacing: 0;

                    for f in Profiles.current-fields: ProfileFieldRow {
                        entry: f;
                        value-edited(name, value) => {
                            Profiles.field-edited(name, value);
                        }
                    }
                }

                // Reset-all toolbar — clears every field on the
                // editing profile in one `Update*Profile(name, {})`
                // round-trip. Disabled when nothing is locally set
                // (Rust pushes `has-any-locally-set` alongside the
                // field rows).
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Reset all to inherited");
                        enabled: Profiles.has-any-locally-set;
                        clicked => { Profiles.reset-all-to-inherited(); }
                    }
                }
            }
        }
    }
}

component ProfileDetailEmpty inherits Rectangle {
    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Design.gap-stack;

        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Select a profile");
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Pick a profile from the list, or create one with the + button.");
                color: Theme.text-dim;
                font-size: Design.font-meta;
                horizontal-alignment: center;
            }
        }
    }
}

// =============================================================================
// ProfilesPane — top-level composition.
// =============================================================================

export component ProfilesPane {
    // Detail is gated on the selected row having content — Rust
    // pushes a blank `selected-row` when the selection clears (e.g.,
    // the selected profile was deleted by another client).
    property <bool> has-selection:
           Profiles.selected-kind != ProfileKind.none
        && Profiles.selected-row.name != "";

    // --- Pending Delete-confirm dialog state ---
    property <ProfileKind> pending-delete-kind: ProfileKind.none;
    property <string> pending-delete-name;
    property <string> pending-delete-referenced-summary;

    // --- Pending New-profile dialog state ---
    property <ProfileKind> pending-new-kind: ProfileKind.none;
    property <string> pending-new-name;
    /// Filled by Slint-side validation as the user types. Empty
    /// means valid; the dialog disables Confirm while non-empty
    /// AND while the name field is empty. Duplicate-name checks
    /// happen server-side — Slint can't iterate the existing
    /// `Profiles.system` / `Profiles.user` lists from a `function`
    /// (no `for` in pure expressions), so duplicates surface as a
    /// toast from the `confirm-create` Rust handler.
    property <string> pending-new-error;

    function validate-new-name(name: string) -> string {
        if (name == "") {
            return "";
        }
        if (name == "default") {
            return @tr("'default' is reserved.");
        }
        return "";
    }

    function open-create-dialog(kind: ProfileKind) {
        root.pending-new-kind = kind;
        root.pending-new-name = "";
        root.pending-new-error = "";
    }

    function close-create-dialog() {
        root.pending-new-kind = ProfileKind.none;
        root.pending-new-name = "";
        root.pending-new-error = "";
    }

    function open-delete-dialog() {
        root.pending-delete-kind = Profiles.selected-kind;
        root.pending-delete-name = Profiles.selected-row.name;
        root.pending-delete-referenced-summary = Profiles.selected-row.referenced-by-summary;
    }

    function close-delete-dialog() {
        root.pending-delete-kind = ProfileKind.none;
        root.pending-delete-name = "";
        root.pending-delete-referenced-summary = "";
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Pane-level inline error surface — same Kirigami inline-
        // message convention the TVs pane uses, just bound to
        // `Errors.profiles`. Rust pushes `ConfigReloaded(success=
        // false)` reload failures here so the user sees them
        // without watching journald; sticky until dismissed.
        if Errors.profiles.title != "" || Errors.profiles.message != "": Rectangle {
            background: Theme.surface-alt;
            HorizontalLayout {
                width: 100%;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 0;
                InlineError {
                    tone: Errors.profiles.tone == "" ? "error" : Errors.profiles.tone;
                    title: Errors.profiles.title;
                    message: Errors.profiles.message;
                    action-label: Errors.profiles.action-label;
                    action-clicked => { Errors.profiles-action(); }
                    dismissed => {
                        Errors.profiles = { kind: "", tone: "", title: "", message: "", action-label: "" };
                    }
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            spacing: 0;
            vertical-stretch: 1;

            ProfileList {
                request-create(kind) => { root.open-create-dialog(kind); }
            }

            // Detail column — fills remaining width.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-alt;

                if !root.has-selection: ProfileDetailEmpty {
                    width: 100%;
                    height: 100%;
                }

                if root.has-selection: ProfileDetail {
                    width: 100%;
                    height: 100%;
                    name: Profiles.selected-row.name;
                    referenced-by: Profiles.selected-row.referenced-by;
                    can-delete: !Profiles.selected-row.is-default;
                    request-delete => { root.open-delete-dialog(); }
                    request-duplicate => { Profiles.duplicate-selected(); }
                }
            }
        }
    }

    // Delete-confirm dialog. When the profile is referenced by one or
    // more TVs, the dialog flips into a "cannot delete" mode: message
    // names the offending TVs, Confirm is disabled, only Cancel works.
    ConfirmDialog {
        open: root.pending-delete-kind != ProfileKind.none;
        title: @tr("Delete profile");
        message: root.pending-delete-referenced-summary != ""
            ? @tr("Cannot delete '{}': still used by {}. Remove or reassign these TVs first.",
                  root.pending-delete-name,
                  root.pending-delete-referenced-summary)
            : @tr("Delete '{}'? This action cannot be undone.", root.pending-delete-name);
        confirm-label: @tr("Delete");
        confirm-enabled: root.pending-delete-referenced-summary == "";
        confirmed => {
            Profiles.confirm-delete(root.pending-delete-kind, root.pending-delete-name);
            root.close-delete-dialog();
        }
        cancelled => { root.close-delete-dialog(); }
    }

    // New-profile name-input dialog. `kind` is set when opening; the
    // post-confirm `confirm-create` routes to either Manager1 or
    // Session1 based on it.
    NameInputDialog {
        open: root.pending-new-kind != ProfileKind.none;
        title: root.pending-new-kind == ProfileKind.system
            ? @tr("New system profile")
            : @tr("New user profile");
        prompt: @tr("Enter a name for the new profile.");
        placeholder: @tr("guest");
        confirm-label: @tr("Create");
        name <=> root.pending-new-name;
        error-message: root.pending-new-error;
        name-changed(v) => {
            root.pending-new-error = root.validate-new-name(v);
        }
        confirmed => {
            Profiles.confirm-create(root.pending-new-kind, root.pending-new-name);
            root.close-create-dialog();
        }
        cancelled => { root.close-create-dialog(); }
    }
}
