// Profiles pane — master-detail with two stacked sections (System /
// User) in the left column and a single detail header on the right.
//
// Silhouette mirrors the TVs pane (left list + right detail), with
// two key divergences:
//
// - Sub-tabs live in the left column as stacked sections, not a top
//   segmented control. Gives the editor full vertical height; matches
//   KDE/GNOME settings sidebar idioms.
// - Detail has no live-state chrome (no power chip, no pencil/edit
//   mode); the field editor commits every change instantly. The
//   header carries "Used by [chip][chip]" linking back to each
//   referencing TV — the "Find Usages" idiom (GitHub package "Used
//   by", VS Code peek).
//
// The detail-header toolbar carries the name + rename pencil +
// Delete (catalog removal). The SYSTEM PROFILE / USER PROFILE
// section title row above the FIELDS card groups catalog-body
// actions (Duplicate, Reset all) with the body they act on.

import { ScrollView } from "std-widgets.slint";
import { ThemedSelect } from "../globals/select.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { Icons } from "../globals/icons.slint";
import { Nav } from "../globals/nav.slint";
import { Profiles, ProfileKind, ProfileFieldEntry, ProfileRow, ProfileTvRef } from "../globals/profiles.slint";
import { ConfirmDialog, Chip, ContextualHelpButton, Focusable, IconBtn, LineEditField, LinkText, ListRow, NameInputDialog, ProfileTile, ThemedSpinBox, ThemedSwitch } from "../widgets.slint";
import { Help, HelpScrollView, HelpTrigger } from "../globals/help.slint";

// =============================================================================
// Master list — left column, stacked System / User sections.
// =============================================================================

component ProfileListRow inherits ListRow {
    in property <ProfileRow> entry;
    in property <ProfileKind> kind;

    height: 64px;
    background: root.selected ? Theme.row-selected
              : (root.hovered ? Theme.row-hover : transparent);

    accessible-label: root.entry.name;
    accessible-id: "profiles-row-" + root.entry.uuid;

    // 3px left accent stripe when selected — mirrors TvListRow.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            width: Design.size-tile-sm;
            alignment: center;
            ProfileTile {
                kind: root.kind;
                tile-size: Design.size-tile-sm;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            // Name row. The default-profile indicator (CHECK MARK
            // glyph appended at row-build time) lives inside
            // `display-name`, so no per-Slint-element conditional —
            // every row reads its label from the same field.
            Text {
                text: root.entry.display-name;
                color: root.selected ? Theme.row-selected-text : Theme.text;
                font-size: Design.font-body;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
                accessible-label: root.entry.is-default
                    ? @tr("{}, default profile", root.entry.name)
                    : root.entry.name;
            }

            // Status row: dot + label. 3-state classification:
            //   Unassigned (no referencing TV)
            //   Assigned (referenced, none automated)
            //   Active (referenced + ≥1 automated)
            HorizontalLayout {
                spacing: Design.gap-tight;
                alignment: start;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Design.size-status-dot;
                    height: Design.size-status-dot;
                    border-radius: 3px;
                    background: root.entry.active
                        ? Theme.success
                        : (root.entry.referenced-by.length > 0
                            ? Theme.info
                            : Theme.text-faint);
                }

                Text {
                    text: root.entry.active
                        ? @tr("Active")
                        : (root.entry.referenced-by.length > 0
                            ? @tr("Assigned")
                            : @tr("Unassigned"));
                    color: root.entry.active
                        ? Theme.success-text
                        : (root.entry.referenced-by.length > 0
                            ? Theme.info-text
                            : Theme.text-faint);
                    font-size: Design.font-mini;
                }
            }
        }
    }
}

component ProfileSectionHeader inherits Rectangle {
    in property <string> title;
    /// `+` enabled flag. False when the corresponding daemon isn't
    /// reachable (no session bus → user-profile create disabled).
    in property <bool> add-enabled: true;
    /// The `+` button's test selector (`profiles-add-<kind>`).
    in property <string> add-id;
    callback add-clicked();
    /// Focus the `+` button: the list's first stop when it has no rows.
    public function focus-add() {
        add.focus();
    }
    /// Up or Down while the `+` has focus: the list moves focus to the
    /// neighbor (`Nav.list-step-tick`).
    callback step(bool);
    property <int> step-mirror: Nav.list-step-tick;
    changed step-mirror => {
        if (add.focused) {
            root.step(Nav.list-step-forward);
        }
    }

    height: 40px;
    // Header band — a distinct surface from the surface-alt master
    // panel below, so the fill contrast sets the band off (no bottom
    // rule).
    background: Theme.surface;

    // Left / right separators. The header's fill covers the master
    // column's edge borders, so re-draw them here to keep the frame
    // continuous across the band.
    Rectangle {
        x: 0;
        width: Design.border-thin;
        background: Theme.border;
    }
    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: Design.gap-stack;
        spacing: Design.gap-stack;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text-dim;
                font-size: Design.font-mini;
                font-weight: 600;
                letter-spacing: 0.6px;
            }
        }

        // "+" New-profile button — same shape as TvList's pair button.
        add := Focusable {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            column: 1;
            enabled: root.add-enabled;
            background: !root.add-enabled
                ? Theme.text-faint
                : (add.hovered ? Theme.accent-pressed : Theme.accent);
            animate background { duration: 150ms; }

            accessible-label: @tr("Create new {} profile", root.title);
            accessible-id: root.add-id;
            // Clear the tip on activation: it opens a modal name dialog
            // the window-root tip would otherwise float over.
            activated => {
                root.add-clicked();
                add-help.hover-leave();
            }
            hover-changed(hovering) => {
                add-help.set-hover(hovering);
            }

            Text {
                text: "+";
                color: white;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            // Hover hint: clarify the "+" creates a named profile.
            add-help := HelpTrigger {
                width: 100%;
                height: 100%;
                text: @tr("Create a new profile.");
            }
        }
    }
}

component ProfileList inherits Rectangle {
    /// Bubble the "+" clicks up to the pane so it can open the
    /// name-input dialog. The section header itself can't host the
    /// dialog (it needs to render over the whole pane).
    callback request-create(ProfileKind);
    /// A row was activated (clicked, or Return on it) after selecting
    /// its profile: the pane moves focus into the detail.
    callback activated();

    // A column request for the list: the selected row, else the first
    // system row, else the first user row, else the system "+". Also
    // answers a request for the detail when nothing is selected, since
    // there's no detail to go to.
    property <ProfileKind> focus-kind;
    property <string> focus-uuid;
    property <int> focus-index;
    property <int> focus-row-tick;
    property <int> column-mirror: Nav.column-tick;
    changed column-mirror => {
        if (Nav.column-target != 0 && (Nav.column-target == 1 || Profiles.selected-uuid == "")) {
            Nav.column-served = Nav.column-tick;
            if (Profiles.selected-uuid != "") {
                root.focus-kind = Profiles.selected-kind;
                root.focus-uuid = Profiles.selected-uuid;
            } else if (Profiles.system.length > 0) {
                root.focus-row(ProfileKind.system, 0);
                return;
            } else if (Profiles.user.length > 0) {
                root.focus-row(ProfileKind.user, 0);
                return;
            } else {
                system-header.focus-add();
                return;
            }
            root.focus-row-tick += 1;
        }
    }
    function wants-row(kind: ProfileKind, uuid: string, index: int) -> bool {
        root.focus-kind == kind
            && (root.focus-uuid != "" ? root.focus-uuid == uuid : root.focus-index == index)
    }
    function focus-row(kind: ProfileKind, index: int) {
        root.focus-kind = kind;
        root.focus-uuid = "";
        root.focus-index = index;
        root.focus-row-tick += 1;
    }

    // Selection follows focus (a row's focus-in), and a click or Return
    // then enters the detail. `selected-row` is handed off here so the
    // detail header (gated on `selected-row.uuid != ""`) materializes on
    // the same frame; Rust's push would follow a state-refresh tick,
    // leaving the detail empty until the next poll.
    function select-row(kind: ProfileKind, r: ProfileRow) {
        Profiles.selected-kind = kind;
        Profiles.selected-uuid = r.uuid;
        Profiles.selected-row = r;
        Profiles.select(kind, r.uuid);
    }
    function is-selected(kind: ProfileKind, uuid: string) -> bool {
        Profiles.selected-kind == kind && Profiles.selected-uuid == uuid
    }

    // The list's stops, in order: the system "+", the system rows, the
    // user "+", the user rows. The selected row (the first, with nothing
    // selected) is the one Tab stop; Up and Down step the rest here and
    // stop at the ends. A disabled user "+" (no session service) is
    // passed over, and Rust leaves the user list empty then.
    function step-from(kind: ProfileKind, index: int, forward: bool) {
        Nav.list-step-served = Nav.list-step-tick;
        if (kind == ProfileKind.system) {
            if (forward) {
                if (index + 1 < Profiles.system.length) {
                    root.focus-row(kind, index + 1);
                } else if (Profiles.session-available) {
                    user-header.focus-add();
                } else if (Profiles.user.length > 0) {
                    root.focus-row(ProfileKind.user, 0);
                }
            } else if (index > 0) {
                root.focus-row(kind, index - 1);
            } else {
                system-header.focus-add();
            }
        } else if (forward) {
            if (index + 1 < Profiles.user.length) {
                root.focus-row(kind, index + 1);
            }
        } else if (index > 0) {
            root.focus-row(kind, index - 1);
        } else if (Profiles.session-available) {
            user-header.focus-add();
        } else if (Profiles.system.length > 0) {
            root.focus-row(ProfileKind.system, Profiles.system.length - 1);
        } else {
            system-header.focus-add();
        }
    }
    function is-first-stop-row(kind: ProfileKind, index: int) -> bool {
        Profiles.selected-uuid == "" && index == 0
            && (kind == ProfileKind.system || Profiles.system.length == 0)
    }

    width: Design.width-master;
    background: Theme.surface-alt;

    // Left separator — divides the column (and its header band) from
    // the sidebar.
    Rectangle {
        x: 0;
        width: Design.border-thin;
        background: Theme.border;
    }

    // Right separator.
    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // System profiles section — top half. Section header is
        // pinned at the top of the half; rows scroll below it once
        // they exceed the available height. The two sections both
        // claim `vertical-stretch: 1` so they split the available
        // height 50/50 regardless of how many rows each holds —
        // either list always has at least half the master column
        // to work with, with its own scroll surface for overflow.
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0;
            system-header := ProfileSectionHeader {
                title: @tr("SYSTEM PROFILES");
                add-enabled: true;
                add-id: "profiles-add-system";
                add-clicked => { root.request-create(ProfileKind.system); }
                step(forward) => {
                    Nav.list-step-served = Nav.list-step-tick;
                    if (forward) {
                        if (Profiles.system.length > 0) {
                            root.focus-row(ProfileKind.system, 0);
                        } else if (Profiles.session-available) {
                            user-header.focus-add();
                        } else if (Profiles.user.length > 0) {
                            root.focus-row(ProfileKind.user, 0);
                        }
                    }
                }
            }
            if Profiles.system-loading: Rectangle {
                height: 56px;
                VerticalLayout {
                    width: 100%;
                    alignment: center;
                    padding: Design.gap-stack;
                    Text {
                        text: @tr("Loading");
                        color: Theme.text-faint;
                        font-size: Design.font-mini;
                        horizontal-alignment: center;
                    }
                }
            }
            ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 0;
                    alignment: start;
                    for r[i] in Profiles.system: ProfileListRow {
                        entry: r;
                        kind: ProfileKind.system;
                        selected: root.is-selected(ProfileKind.system, r.uuid);
                        tab-stop: self.selected || root.is-first-stop-row(ProfileKind.system, i);
                        focus-tick: root.focus-row-tick;
                        focus-wanted: root.wants-row(ProfileKind.system, r.uuid, i);
                        focus-in => {
                            if (!self.selected) {
                                root.select-row(ProfileKind.system, r);
                            }
                        }
                        clicked => {
                            if (!self.selected) {
                                root.select-row(ProfileKind.system, r);
                            }
                            root.activated();
                        }
                        step(forward) => {
                            root.step-from(ProfileKind.system, i, forward);
                        }
                    }
                }
            }
        }

        // User profiles section — bottom half. Same shape as the
        // system half. When the session bus isn't available, Rust
        // pushes an empty `Profiles.user` model so the repeater
        // renders nothing and the unavailable-notice carries the
        // message instead.
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0;
            user-header := ProfileSectionHeader {
                title: @tr("USER PROFILES");
                add-enabled: Profiles.session-available;
                add-id: "profiles-add-user";
                add-clicked => { root.request-create(ProfileKind.user); }
                step(forward) => {
                    Nav.list-step-served = Nav.list-step-tick;
                    if (forward) {
                        if (Profiles.user.length > 0) {
                            root.focus-row(ProfileKind.user, 0);
                        }
                    } else if (Profiles.system.length > 0) {
                        root.focus-row(ProfileKind.system, Profiles.system.length - 1);
                    } else {
                        system-header.focus-add();
                    }
                }
            }
            if !Profiles.session-available: Rectangle {
                height: 56px;
                VerticalLayout {
                    width: 100%;
                    alignment: center;
                    padding: Design.gap-stack;
                    Text {
                        text: @tr("Session service unavailable");
                        color: Theme.text-faint;
                        font-size: Design.font-mini;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            if Profiles.session-available && Profiles.user-loading: Rectangle {
                height: 56px;
                VerticalLayout {
                    width: 100%;
                    alignment: center;
                    padding: Design.gap-stack;
                    Text {
                        text: @tr("Loading");
                        color: Theme.text-faint;
                        font-size: Design.font-mini;
                        horizontal-alignment: center;
                    }
                }
            }
            ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 0;
                    alignment: start;
                    for r[i] in Profiles.user: ProfileListRow {
                        entry: r;
                        kind: ProfileKind.user;
                        selected: root.is-selected(ProfileKind.user, r.uuid);
                        tab-stop: self.selected || root.is-first-stop-row(ProfileKind.user, i);
                        focus-tick: root.focus-row-tick;
                        focus-wanted: root.wants-row(ProfileKind.user, r.uuid, i);
                        focus-in => {
                            if (!self.selected) {
                                root.select-row(ProfileKind.user, r);
                            }
                        }
                        clicked => {
                            if (!self.selected) {
                                root.select-row(ProfileKind.user, r);
                            }
                            root.activated();
                        }
                        step(forward) => {
                            root.step-from(ProfileKind.user, i, forward);
                        }
                    }
                }
            }
        }
    }
}

// =============================================================================
// Field-editor rows — one per `ProfileFieldEntry`, dispatched by `kind`.
// =============================================================================
//
// Three row shapes (enum / number / bool) share the same rhythm:
//   [2 px gutter] [label] [control] [trailing: (restore · gate ·) reset]
// The gutter accent flips to `Theme.accent` when `is-locally-set`,
// signaling at a glance which fields override the inherit chain.
//
// The trailing block (`ProfileRowTrailing`) ends every row with the reset
// slot, so every reset glyph lands in the same right-edge column — aligned
// under the detail-header's reset-all button. The two toggles precede it
// only on `SessionAction` action rows; number and bool rows carry the
// reset slot alone. Reset is only interactive for locally-set rows —
// inheriting fields can't be "reset" because they already inherit.
//
// `entry.current-value` is the resolved token verbatim for enum + number;
// the inherit cue is the gutter accent + reset glyph, not a marker baked
// into the value.

// Fixed-width trailing controls, shared by every row kind so the reset
// glyphs form one vertical column. `gap-form` between the slots matches
// the detail-header's spacing between its Duplicate and Reset-all
// buttons, tying the two toolbars to the same rhythm.
//
// The reset slot is the last fixed-width column on every row, so it lands
// at the same right edge (the `alignment: end` right-anchors the block).
// Before it sits a fixed-width modifier region, reserved on EVERY row
// kind (not just action rows): it holds the two action toggles, a number
// field's unit label, or nothing. Reserving it unconditionally is what
// makes every field row's value column resolve to the same width — so the
// ThemedSpinBox and the ComboBox render one width — instead of the number
// rows borrowing the toggle-slot space and matching only by coincidence.
//
// Each slot is a fixed 24×24 box: the explicit height gives the
// `if`-gated `IconBtn` (bound `height: 100%`) a nonzero hit area — a
// bare width-only Rectangle collapses to zero height and swallows the
// click. Toggle accent (`active`) tracks "differs from the field's floor
// default", not the on/off value — the pane's locally-set visual
// language. The pressed/glyph state still reflects the value (the gate
// swaps its glyph by value). Where a toggle is meaningless it is
// `enabled: false`, which dims it and drops interactivity.
component ProfileRowTrailing inherits HorizontalLayout {
    in property <ProfileFieldEntry> entry;
    /// The field row's id for the arrows; the icons take it.
    in property <int> nav-row;
    /// The reset button is about to go (a reset clears the local
    /// value, and the button exists only while one is set); the row
    /// moves focus to its control first.
    callback reset-requested();

    spacing: Design.gap-form;
    alignment: end;

    // Modifier region — a FIXED-WIDTH column (two 24 px slots + the gap
    // between them) reserved on every row kind, so the reset glyph lands
    // at one x throughout and, crucially, every field row's value column
    // resolves to the same width. That is what makes the number rows'
    // ThemedSpinBox and the enum rows' ComboBox render one width for real
    // — not by the old coincidence of the unit label's width happening to
    // cancel the toggle-slot delta. It holds the two action toggles
    // (action rows), the number field's unit label (number rows), or
    // nothing (bool rows / unitless numbers).
    HorizontalLayout {
        width: 2 * 24px + Design.gap-form;
        spacing: Design.gap-form;
        alignment: end;

        // Restore-input toggle slot — action rows only.
        if root.entry.has-toggles: Rectangle {
            width: 24px;
            height: 24px;
            IconBtn {
                width: 100%;
                height: 100%;
                nav-row: root.nav-row;
                source: Icons.restore-input;
                enabled: root.entry.restore-enabled;
                active: root.entry.restore-differs;
                accessible-label: @tr("Land on primary input");
                tip: @tr("Land on primary input");
                clicked => {
                    Profiles.restore-edited(root.entry.field-name, !root.entry.restore-value);
                }
            }
        }

        // Stream gate slot — action rows only. The glyph swaps by
        // value (gated = network-off); the accent tracks differs-from-floor.
        if root.entry.has-toggles: Rectangle {
            width: 24px;
            height: 24px;
            IconBtn {
                width: 100%;
                height: 100%;
                nav-row: root.nav-row;
                source: root.entry.stream-gate-value
                    ? Icons.stream-gate-on
                    : Icons.stream-gate-off;
                enabled: root.entry.stream-gate-enabled;
                active: root.entry.stream-gate-differs;
                accessible-label: root.entry.stream-gate-value
                    ? @tr("Fires while streaming")
                    : @tr("Suppressed while streaming");
                tip: root.entry.stream-gate-value
                    ? @tr("Fires while streaming")
                    : @tr("Suppressed while streaming");
                clicked => {
                    Profiles.stream-gated(root.entry.field-name, !root.entry.stream-gate-value);
                }
            }
        }

        // Unit label — non-action number rows. Left-aligned against the
        // value column so it reads as the ThemedSpinBox's suffix, occupying the
        // same region the toggles do on action rows.
        if !root.entry.has-toggles && root.entry.unit != "": Text {
            horizontal-stretch: 1;
            text: root.entry.unit;
            color: Theme.text-dim;
            font-size: Design.font-meta;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    // Reset glyph — the right-edge column, aligned under the header's
    // reset-all. Interactive only for locally-set fields; a fixed 24 px
    // box whether populated or not so the rhythm stays consistent.
    Rectangle {
        width: 24px;
        height: 24px;
        if root.entry.is-locally-set: IconBtn {
            width: 100%;
            height: 100%;
            nav-row: root.nav-row;
            source: Icons.reload;
            accessible-label: @tr("Reset {} to default", root.entry.label);
            accessible-id: "profiles-field-" + root.entry.field-name + "-reset";
            tip: @tr("Reset field");
            clicked => {
                root.reset-requested();
                Profiles.reset-field(root.entry.field-name);
            }
        }
    }
}

// A row of the editor's FIELDS card, whatever its control: the field's
// entry, a row id for the arrows, and Menu relayed to the section's
// toolbar "i", since the row has none of its own.
component ProfileFieldRow inherits Rectangle {
    in property <ProfileFieldEntry> entry;
    out property <int> row-id;
    /// The section toolbar's row: its "i" answers Menu on this row.
    in property <int> section-row;
    property <int> menu-mirror: Help.menu-tick;
    changed menu-mirror => {
        if (Help.menu-row == root.row-id) {
            Help.menu-toggle(root.section-row);
        }
    }
    init => {
        root.row-id = Nav.next-row-id();
    }
}

component ProfileFieldRowEnum inherits ProfileFieldRow {
    height: row-layout.preferred-height;

    HorizontalLayout {
        width: 100%;
        spacing: 0;
        alignment: stretch;

        // 2 px gutter — accent when the field is locally set,
        // transparent otherwise. Visual cue distinct from the
        // reset glyph so the row reads as "overridden" even when
        // the user isn't hovering the glyph.
        Rectangle {
            width: 2px;
            background: root.entry.is-locally-set ? Theme.accent : transparent;
        }

        row-layout := HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: Design.gap-row;
            padding-right: Design.gap-row;
            padding-top: Design.gap-stack;
            padding-bottom: Design.gap-stack;
            spacing: Design.gap-row;
            alignment: stretch;

            VerticalLayout {
                width: Design.width-label-col-profile;
                alignment: center;
                Text {
                    text: root.entry.label;
                    color: Theme.text;
                    font-size: Design.font-meta;
                    font-weight: 500;
                    // Wrap rather than clip when a label exceeds the
                    // column width (long fields, localization
                    // expansion). The fixed column still keeps every
                    // ComboBox / ThemedSpinBox aligned at the same x; only
                    // the affected row grows taller.
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                enum-control := ThemedSelect {
                    nav-row: root.row-id;
                    accessible-id: "profiles-field-" + root.entry.field-name;
                    model: root.entry.options;
                    current-value: root.entry.current-value;
                    selected(v) => { Profiles.value-edited(root.entry.field-name, v); }
                }
            }

            VerticalLayout {
                alignment: center;
                ProfileRowTrailing {
                    entry: root.entry;
                    nav-row: root.row-id;
                    reset-requested => { enum-control.focus(); }
                }
            }
        }
    }
}

component ProfileFieldRowNumber inherits ProfileFieldRow {
    height: row-layout.preferred-height;

    HorizontalLayout {
        width: 100%;
        spacing: 0;
        alignment: stretch;

        Rectangle {
            width: 2px;
            background: root.entry.is-locally-set ? Theme.accent : transparent;
        }

        row-layout := HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: Design.gap-row;
            padding-right: Design.gap-row;
            padding-top: Design.gap-stack;
            padding-bottom: Design.gap-stack;
            spacing: Design.gap-row;
            alignment: stretch;

            VerticalLayout {
                width: Design.width-label-col-profile;
                // Center the label against the input — same as the enum
                // row. There's no helper line to top-align to here.
                alignment: center;
                Text {
                    text: root.entry.label;
                    color: Theme.text;
                    font-size: Design.font-meta;
                    font-weight: 500;
                    // Wrap rather than clip when a label exceeds the
                    // column width (long fields, localization
                    // expansion). The fixed column still keeps every
                    // ComboBox / ThemedSpinBox aligned at the same x; only
                    // the affected row grows taller.
                    wrap: word-wrap;
                }
            }

            // Value column — the ThemedSpinBox alone, mirroring the enum
            // row's ComboBox column, so the two render one width. The unit
            // label is NOT here: it lives in the trailing modifier region
            // (ProfileRowTrailing), sized to the same width as the action
            // rows' toggle slots, which is what makes this value column
            // equal the enum row's (rather than the old coincidence where
            // the unit's width happened to cancel the toggle-slot delta).
            // The deferred-commit-on-blur logic now lives inside
            // ThemedSpinBox (see widgets.slint).
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                number-control := ThemedSpinBox {
                    nav-row: root.row-id;
                    accessible-id: "profiles-field-" + root.entry.field-name;
                    value: root.entry.number-value;
                    minimum: root.entry.min-value;
                    maximum: root.entry.max-value;
                    step: root.entry.step;
                    committed(v) => { Profiles.value-edited-number(root.entry.field-name, v); }
                }
            }

            // Same trailing block as the enum row. On a number row its
            // modifier region carries the unit label (where action rows
            // carry their toggles), so the reset glyph shares the enum
            // rows' right-edge column.
            VerticalLayout {
                alignment: center;
                ProfileRowTrailing {
                    entry: root.entry;
                    nav-row: root.row-id;
                    reset-requested => { number-control.focus(); }
                }
            }
        }
    }
}

component ProfileFieldRowBool inherits ProfileFieldRow {
    height: row-layout.preferred-height;

    HorizontalLayout {
        width: 100%;
        spacing: 0;
        alignment: stretch;

        Rectangle {
            width: 2px;
            background: root.entry.is-locally-set ? Theme.accent : transparent;
        }

        row-layout := HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: Design.gap-row;
            padding-right: Design.gap-row;
            padding-top: Design.gap-stack;
            padding-bottom: Design.gap-stack;
            spacing: Design.gap-row;
            alignment: stretch;

            VerticalLayout {
                width: Design.width-label-col-profile;
                alignment: center;
                Text {
                    text: root.entry.label;
                    color: Theme.text;
                    font-size: Design.font-meta;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                bool-control := ThemedSwitch {
                    nav-row: root.row-id;
                    accessible-id: "profiles-field-" + root.entry.field-name;
                    checked: root.entry.bool-value;
                    accessible-label: root.entry.label;
                    toggled => {
                        Profiles.value-edited-bool(root.entry.field-name, self.checked);
                    }
                }
            }

            // Shared trailing block — on the screencast-arms switch row it
            // resolves to the reset slot alone (no action modifiers), so
            // its reset glyph joins the same right-edge column as the
            // action rows.
            VerticalLayout {
                alignment: center;
                ProfileRowTrailing {
                    entry: root.entry;
                    nav-row: root.row-id;
                    reset-requested => { bool-control.focus(); }
                }
            }
        }
    }
}

// =============================================================================
// Detail — right column, fills remaining width.
// =============================================================================

component ProfileDetailHeader inherits Rectangle {
    /// Bare name as the daemon stores it. Used by the rename-pencil
    /// field's prefill (the daemon validates the name; the
    /// default-indicator glyph is not a legal name character, so the
    /// buffer must start from the bare value).
    in property <string> name;
    /// Localized, indicator-suffixed display form. Used by the
    /// read-only Text in view mode. Synthesized by
    /// `state.rs::display_profile_name`.
    in property <string> display-name;
    in property <ProfileKind> kind;
    in property <[ProfileTvRef]> referenced-by;
    // Two rows for the arrows: the title row's buttons (or the rename
    // field with its two), and the Used-by links.
    property <int> title-row;
    property <int> usedby-row;
    init => {
        root.title-row = Nav.next-row-id();
        root.usedby-row = Nav.next-row-id();
    }
    /// True iff at least one referencing TV is currently automated.
    /// Drives the Active/Inactive status badge.
    in property <bool> active;
    /// Disable Delete on the reserved default profile — the daemon
    /// rejects deletion of the default UUID outright. Greying the
    /// button keeps the affordance discoverable without dispatching
    /// a call the daemon will reject.
    in property <bool> can-delete: true;
    /// Bubble actions up to the pane; ProfilesPane owns the
    /// confirm-delete dialog and the duplicate dialog.
    callback request-delete();
    /// Bubble a friendly-name rename request up. ProfilesPane forwards
    /// to `Profiles.rename-selected(...)`. The daemon validates the
    /// new name (non-empty, reserved-name rules, uniqueness); failures
    /// surface as a toast from Rust.
    callback request-rename(string);

    // --- Inline-edit state ---
    //
    // Address-book / VS Code "F2 rename" pattern: the name renders as
    // a plain Text by default with a pencil glyph trailing it; clicking
    // the pencil flips this header into edit mode, swapping the Text
    // for a LineEditField and the pencil + Duplicate / Delete buttons
    // for ✓ / ✗. Commits ride a `name`-only body patch through
    // `UpdateSystemProfile` / `UpdateUserProfile`; the echoed
    // `SystemProfileChanged` / `UserProfileChanged` signal redraws
    // `root.name` automatically.
    //
    // The pencil is only rendered while a profile is selected (the
    // header itself doesn't render in the empty state — its only call
    // site is gated on `has-selection` in `ProfilesPane`).
    property <bool> editing-name: false;
    /// Field-text buffer for the inline edit. Initialized from
    /// `root.name` on every transition into edit mode; never written
    /// back through to `root.name` — that channel belongs to the
    /// daemon's signal echo.
    property <string> pending-name;

    /// Set when the rename ends by key: the Rename button that replaces
    /// the field takes focus on creation.
    property <bool> focus-rename-when-shown;

    /// Enter edit mode: snapshot the current name into the buffer +
    /// flip the inline-edit toggle. The `LineEditField` is `if`-gated
    /// on `editing-name`, so the widget materializes here and takes
    /// keyboard focus from its `init` block; nothing else needs to
    /// reach into it.
    function begin-rename() {
        root.focus-rename-when-shown = false;
        root.pending-name = root.name;
        root.editing-name = true;
    }

    /// Commit the typed name: fire the rename callback + leave edit
    /// mode. We flip the toggle unconditionally — the daemon's
    /// validation outcome surfaces asynchronously through a toast, so
    /// the editor doesn't sit in edit mode waiting for a verdict that
    /// the user can't see from this widget.
    function commit-rename() {
        if (!root.editing-name) {
            return;
        }
        root.editing-name = false;
        root.request-rename(root.pending-name);
    }

    /// Discard the typed name + leave edit mode without firing the
    /// callback. The displayed `root.name` is unchanged because we
    /// only ever touched `pending-name`.
    function cancel-rename() {
        root.editing-name = false;
        root.pending-name = "";
    }

    height: header-layout.preferred-height;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    // Three-column shape mirroring `TvDetailHeader`:
    //   [ tile ] [ name + actions, Used-by ticker below ] [ status badges ]
    // Padding tokens shared with `TvDetailHeader` so the two pane
    // headers visually match by construction.
    header-layout := HorizontalLayout {
        width: 100%;
        padding-left: Design.pad-pane;
        padding-right: Design.pad-pane;
        padding-top: Design.pad-header-top;
        padding-bottom: Design.gap-row;
        spacing: Design.gap-row;
        alignment: stretch;

        // Col 1: identity tile.
        VerticalLayout {
            width: Design.size-tile-md;
            alignment: center;
            ProfileTile {
                kind: root.kind;
                tile-size: Design.size-tile-md;
            }
        }

        // Col 2: name + action icons row, with the Used-by chip
        // ticker below.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Design.gap-form;

            // Title row. Two layouts share the name slot:
            //   - View mode: Text + pencil + Duplicate + Delete.
            //   - Edit mode: LineEditField + ✓ + ✗.
            HorizontalLayout {
                spacing: Design.gap-row;
                alignment: stretch;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    if !root.editing-name: Text {
                        // `display-name` carries the localized "default"
                        // form + default-indicator glyph; `name` is the
                        // bare wire-truth that feeds the rename buffer.
                        text: root.display-name;
                        color: Theme.text;
                        font-size: Design.font-title-3;
                        font-weight: 700;
                        overflow: elide;
                        accessible-label: root.can-delete
                            ? root.name
                            : @tr("{}, default profile", root.name);
                    }
                    // Wrap the field in a FocusScope so Escape (which
                    // the field lets bubble out once it isn't editing;
                    // only printable text and Enter are consumed)
                    // reaches `cancel-rename()`. Enter still rides
                    // `LineEditField.accepted(...)` and routes to
                    // `commit-rename()` directly.
                    if root.editing-name: FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.focus-rename-when-shown = true;
                                root.cancel-rename();
                                return accept;
                            }
                            return reject;
                        }

                        LineEditField {
                            nav-row: root.title-row;
                            placeholder-text: @tr("Profile name");
                            text <=> root.pending-name;
                            accessible-id: "profile-rename-field";
                            accepted(v) => {
                                root.focus-rename-when-shown = true;
                                root.commit-rename();
                            }
                            // A rename is what the user just asked
                            // for: the field edits as it appears.
                            init => {
                                self.focus-input();
                            }
                        }
                    }
                }

                // Rename + Delete share the same enabled predicate:
                // the reserved-default profile rejects body mutations
                // that change its name (the daemon's
                // `UpdateSystemProfile` / `UpdateUserProfile`
                // validators force `body.name == "default"` for the
                // default UUID) AND rejects Delete outright. Greying
                // each button keeps the affordance discoverable
                // without dispatching a call the daemon will reject.
                if !root.editing-name: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        nav-row: root.title-row;
                        source: Icons.edit;
                        accessible-label: @tr("Rename profile");
                        accessible-id: "profile-rename-button";
                        tip: @tr("Rename profile");
                        enabled: root.can-delete;
                        clicked => { root.begin-rename(); }
                        init => {
                            if (root.focus-rename-when-shown) {
                                self.focus();
                            }
                        }
                    }
                }
                if !root.editing-name: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        nav-row: root.title-row;
                        source: Icons.delete;
                        accessible-label: @tr("Delete profile");
                        accessible-id: "profiles-delete-button";
                        tip: @tr("Delete profile");
                        enabled: root.can-delete;
                        clicked => { root.request-delete(); }
                    }
                }
                if root.editing-name: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        nav-row: root.title-row;
                        source: Icons.save;
                        accessible-label: @tr("Save rename");
                        clicked => {
                            root.focus-rename-when-shown = self.focused;
                            root.commit-rename();
                        }
                    }
                }
                if root.editing-name: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        nav-row: root.title-row;
                        source: Icons.cancel;
                        accessible-label: @tr("Cancel rename");
                        clicked => {
                            root.focus-rename-when-shown = self.focused;
                            root.cancel-rename();
                        }
                    }
                }
            }

            // Used-by row. Plain Text spans + middot separators
            // matching the TVs-pane descriptor row — chips would
            // run ~5 px taller (border + padding) and push the
            // header noticeably above the TVs-pane header. Each
            // TV's `LinkText` tint matches the 3-state classifi-
            // cation the master-list row dot/label uses for the
            // row-level aggregate: `success-text` when the TV is
            // currently automated (Active), `info-text` when only
            // referenced (Assigned). The Unassigned state can't
            // appear here because `references_of` only returns
            // referencing TVs by construction. Per-TV
            // `accessible-label-override` carries the same status
            // word so screen readers announce "{name}, automated"
            // alongside the visual tint — WCAG 1.4.1 mitigation
            // for the color-only state encoding.
            // Always renders so the header height is stable across
            // assigned + unassigned states (matches TVs-pane row 2
            // which falls back to `—` when the descriptor values
            // are empty); wrapped in a Flickable so a wide list
            // scrolls sideways (drag) instead of clipping into the
            // status-badges column. The Flickable clips, so it
            // overhangs a box of the row's own height by a focus
            // ring's room: a link's ring isn't cut, and the header
            // keeps the height the TVs pane's has.
            usedby-box := Rectangle {
                height: usedby-row.preferred-height;
                property <length> ring-room: Design.ring-offset + Design.ring-width;
                Flickable {
                    x: -usedby-box.ring-room;
                    y: -usedby-box.ring-room;
                    width: usedby-box.width + 2 * usedby-box.ring-room;
                    height: usedby-box.height + 2 * usedby-box.ring-room;
                    content-width: usedby-row.preferred-width + 2 * usedby-box.ring-room;
                    content-height: self.height;
                    usedby-row := HorizontalLayout {
                        x: usedby-box.ring-room;
                        y: usedby-box.ring-room;
                        spacing: Design.gap-meta;
                        alignment: start;
                        Text {
                            text: @tr("Used by:");
                            color: Theme.text-dim;
                            font-size: Design.font-helper;
                        }
                        if root.referenced-by.length == 0: Text {
                            text: "—";
                            color: Theme.text-dim;
                            font-size: Design.font-helper;
                        }
                        for tv[i] in root.referenced-by: HorizontalLayout {
                            spacing: Design.gap-meta;
                            alignment: start;
                            if i > 0: Text {
                                text: "·";
                                color: Theme.text-dim;
                                font-size: Design.font-helper;
                            }
                            LinkText {
                                nav-row: root.usedby-row;
                                text: tv.name;
                                tip: @tr("Edit {} config", tv.name);
                                text-color: tv.automated
                                    ? Theme.success-text
                                    : Theme.info-text;
                                accessible-label-override: tv.automated
                                    ? @tr("{}, automated", tv.name)
                                    : "";
                                clicked => { Profiles.open-tv(tv.uuid); }
                            }
                        }
                    }
                }
            }
        }

        // Col 3: status badges. Same shape `TvDetailHeader` uses for
        // its Connected/Disconnected + Managed-state pair.
        VerticalLayout {
            alignment: center;
            spacing: Design.gap-tight;
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: root.referenced-by.length > 0
                        ? @tr("Assigned")
                        : @tr("Unassigned");
                    tone: root.referenced-by.length > 0 ? "info" : "neutral";
                }
            }
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: root.active ? @tr("Active") : @tr("Inactive");
                    tone: root.active ? "success" : "neutral";
                }
            }
        }
    }
}

component ProfileDetail inherits Rectangle {
    /// Bare name (forwarded into the header's rename buffer).
    in property <string> name;
    /// Localized + indicator-suffixed display form (forwarded into
    /// the header's read-only Text).
    in property <string> display-name;
    in property <ProfileKind> kind;
    in property <[ProfileTvRef]> referenced-by;
    in property <bool> active;
    in property <bool> can-delete: true;
    callback request-delete();
    callback request-duplicate();
    callback request-reset-all();

    /// Bumped by the pane when a list row is activated: the detail
    /// takes focus. Its entry stop is Duplicate, the first control that
    /// isn't inside a conditional (the header's Rename and Delete
    /// buttons swap with the rename field, so they can't be a
    /// `forward-focus` target).
    ///
    /// The first selection creates this detail on the activation that
    /// bumps the tick, so it's born with the new value and sees no
    /// change: `init` takes the request too. `focus-done` is the pane's
    /// record of the last request served, so a detail recreated later
    /// (a reselection from Rust) doesn't take focus for an old one.
    in property <int> focus-tick;
    in-out property <int> focus-done;
    function take-requested-focus() {
        if (root.focus-tick != root.focus-done) {
            root.focus-done = root.focus-tick;
            root.focus();
        }
    }
    init => {
        root.take-requested-focus();
        root.fields-row = Nav.next-row-id();
        root.from-tv-row = Nav.next-row-id();
        root.stream-row = Nav.next-row-id();
    }
    changed focus-tick => {
        root.take-requested-focus();
    }
    forward-focus: duplicate-button;
    // The three section toolbars are rows for the arrows: the "i",
    // then Duplicate and Reset profile on the first.
    property <int> fields-row;
    property <int> from-tv-row;
    property <int> stream-row;

    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        ProfileDetailHeader {
            name: root.name;
            display-name: root.display-name;
            kind: root.kind;
            referenced-by: root.referenced-by;
            active: root.active;
            can-delete: root.can-delete;
            request-delete => { root.request-delete(); }
            request-rename(new-name) => { Profiles.rename-selected(new-name); }
        }

        // Field editor surface. The detail header carries the name +
        // rename pencil + Delete (catalog-removal scope); the catalog-
        // body actions (Duplicate, Reset all) live on the title row
        // above the FIELDS card so they group with the body they act
        // on. Section label calls out the kind explicitly
        // ("SYSTEM PROFILE" / "USER PROFILE") so a user who arrived
        // via the TVs-pane pencil pane-hop sees the context without
        // relying on the col-1 tile glyph alone.
        // HelpScrollView pins content-width and confines help bubbles to
        // this viewport on scroll/resize — bubbles anchored outside it (the
        // header rename/delete tips) are left to the window. See
        // globals/help.slint.
        HelpScrollView {
            VerticalLayout {
                width: 100%;
                padding-left: Design.pad-pane;
                padding-right: Design.pad-pane;
                padding-top: Design.pad-body-top;
                padding-bottom: Design.pad-pane;
                spacing: Design.gap-pane;
                alignment: start;

                // FIELDS section — title row + card. A sibling of the
                // STREAMING section below; the body's `gap-pane`
                // sets the section-to-section rhythm, matching the TVs
                // pane's stacked `Group`s. Each section keeps its own
                // `spacing: 0` so the title's `padding-bottom` (gap-stack)
                // is the only title-to-card gap, exactly as `Group` does.
                VerticalLayout {
                    spacing: 0;

                    // Title row — section label on the left, catalog-
                    // body action toolbar (Duplicate + Reset all) on
                    // the right.
                    HorizontalLayout {
                        padding-left: 2px;
                        padding-bottom: Design.gap-stack;
                        spacing: Design.gap-form;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.kind == ProfileKind.user
                                    ? @tr("USER PROFILE")
                                    : @tr("SYSTEM PROFILE");
                                color: Theme.text-dim;
                                font-size: Design.font-mini;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ContextualHelpButton {
                                nav-row: root.fields-row;
                                accessible-id: "profiles-fields-help";
                                text: @tr("Profile automation maps events to actions. Unset fields inherit from default.");
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            duplicate-button := IconBtn {
                                nav-row: root.fields-row;
                                source: Icons.copy;
                                accessible-label: @tr("Duplicate profile");
                                accessible-id: "profiles-duplicate-button";
                                tip: @tr("Duplicate profile");
                                clicked => { root.request-duplicate(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                nav-row: root.fields-row;
                                source: Icons.reload;
                                accessible-label: @tr("Reset profile");
                                accessible-id: "profiles-reset-all-button";
                                tip: @tr("Reset profile");
                                enabled: Profiles.editor-can-reset-all;
                                clicked => { root.request-reset-all(); }
                            }
                        }
                    }

                    // Card — same surface treatment as `Group`'s
                    // body. Repeats `Profiles.editor-fields`, picking
                    // a row shape per `entry.kind` (`"enum"` /
                    // `"number"`). Empty model renders an empty card
                    // — Rust pushes the model whenever the selection
                    // changes, so a blank card means "no selection"
                    // (the empty-state branch above handles that
                    // case at the pane level) or "this profile has
                    // no editor fields" (currently never true; the
                    // tables always emit at least one row).
                    Rectangle {
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: Design.border-thin;
                        border-radius: Design.radius-card;

                        VerticalLayout {
                            width: 100%;
                            // Rows run full-bleed horizontally (the 2 px
                            // gutter accent meets the card's inner edge),
                            // so the card carries no horizontal body
                            // padding. Vertically, each row self-pads by
                            // `gap-stack`; add the remainder up to
                            // `pad-card` here so the first/last row clear
                            // the card border by the same inset a `Group`
                            // card uses in the TVs pane.
                            padding-top: Design.pad-card - Design.gap-stack;
                            padding-bottom: Design.pad-card - Design.gap-stack;
                            spacing: 0;
                            alignment: start;
                            for entry[i] in Profiles.editor-fields: VerticalLayout {
                                if entry.kind == "enum": ProfileFieldRowEnum {
                                    section-row: root.fields-row;
                                    entry: entry;
                                }
                                if entry.kind == "number": ProfileFieldRowNumber {
                                    section-row: root.fields-row;
                                    entry: entry;
                                }
                                if entry.kind == "bool": ProfileFieldRowBool {
                                    section-row: root.fields-row;
                                    entry: entry;
                                }
                            }
                        }
                    }
                }

                // FROM THE TV section — what the PC does when the TV
                // powers off by itself or its remote's power key is
                // aimed at the PC. A sibling of the FIELDS section, with
                // the same surface + full-bleed row treatment.
                if Profiles.editor-from-tv-fields.length > 0: VerticalLayout {
                    spacing: 0;
                    HorizontalLayout {
                        padding-left: 2px;
                        padding-bottom: Design.gap-stack;
                        spacing: Design.gap-form;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("FROM THE TV");
                                color: Theme.text-dim;
                                font-size: Design.font-mini;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ContextualHelpButton {
                                nav-row: root.from-tv-row;
                                accessible-id: "profiles-from-tv-help";
                                text: @tr("What this PC does when the TV powers off by itself, or when the TV's remote powers this PC off, whether the TV powering on wakes this PC, and whether the remote's keys reach the desktop. TisVlay's own power-offs never count, and neither event acts while a stream arms the TV. The TV's pane shows what its connection supports.");
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle {
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: Design.border-thin;
                        border-radius: Design.radius-card;

                        VerticalLayout {
                            width: 100%;
                            padding-top: Design.pad-card - Design.gap-stack;
                            padding-bottom: Design.pad-card - Design.gap-stack;
                            spacing: 0;
                            alignment: start;
                            for entry[i] in Profiles.editor-from-tv-fields: VerticalLayout {
                                if entry.kind == "enum": ProfileFieldRowEnum {
                                    section-row: root.from-tv-row;
                                    entry: entry;
                                }
                                if entry.kind == "bool": ProfileFieldRowBool {
                                    section-row: root.from-tv-row;
                                    entry: entry;
                                }
                            }
                        }
                    }
                }

                // STREAMING section — the screencast-arming switch
                // (user profiles only). The per-event suppression gate
                // rides each action row in the FIELDS card as a toggle,
                // not a card row, so the system pane pushes no rows here
                // and the section hides. A sibling of the FIELDS section:
                // the body's `gap-pane` sets the gap between them. Same
                // surface + full-bleed row treatment as the FIELDS card.
                if Profiles.editor-stream-fields.length > 0: VerticalLayout {
                    spacing: 0;
                    HorizontalLayout {
                        padding-left: 2px;
                        padding-bottom: Design.gap-stack;
                        spacing: Design.gap-form;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("STREAMING");
                                color: Theme.text-dim;
                                font-size: Design.font-mini;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ContextualHelpButton {
                                nav-row: root.stream-row;
                                accessible-id: "profiles-stream-help";
                                text: @tr("What counts as a stream, so events can be suppressed for an empty room. Suppress an individual event with the network toggle on its row in FIELDS above.");
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle {
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: Design.border-thin;
                        border-radius: Design.radius-card;

                        VerticalLayout {
                            width: 100%;
                            padding-top: Design.pad-card - Design.gap-stack;
                            padding-bottom: Design.pad-card - Design.gap-stack;
                            spacing: 0;
                            alignment: start;
                            for entry[i] in Profiles.editor-stream-fields: VerticalLayout {
                                if entry.kind == "enum": ProfileFieldRowEnum {
                                    section-row: root.stream-row;
                                    entry: entry;
                                }
                                if entry.kind == "number": ProfileFieldRowNumber {
                                    section-row: root.stream-row;
                                    entry: entry;
                                }
                                if entry.kind == "bool": ProfileFieldRowBool {
                                    section-row: root.stream-row;
                                    entry: entry;
                                }
                                // Helper copy under the screencast-arms
                                // switch: what always arms vs. what the
                                // switch adds.
                                if entry.field-name == "screencast_arms": VerticalLayout {
                                    padding-left: Design.gap-row;
                                    padding-right: Design.gap-row;
                                    padding-bottom: Design.gap-stack;
                                    spacing: 2px;
                                    Text {
                                        text: @tr("Streaming apps, hooks and remote logins always arm.");
                                        color: Theme.text-dim;
                                        font-size: Design.font-meta;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: @tr("On: any screen capture (OBS, browser tab-share) also arms.");
                                        color: Theme.text-dim;
                                        font-size: Design.font-meta;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component ProfileDetailEmpty inherits Rectangle {
    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Design.gap-stack;

        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Select a profile");
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Pick a profile from the list, or create one with the + button.");
                color: Theme.text-dim;
                font-size: Design.font-meta;
                horizontal-alignment: center;
            }
        }
    }
}

// =============================================================================
// ProfilesPane — top-level composition.
// =============================================================================

export component ProfilesPane {
    // Detail is gated on the selected row having a non-empty UUID —
    // Rust pushes a blank `selected-row` when the selection clears
    // (e.g. the selected profile was deleted by another client).
    property <bool> has-selection:
           Profiles.selected-kind != ProfileKind.none
        && Profiles.selected-row.uuid != "";

    // --- Pending Delete-confirm dialog state ---
    property <ProfileKind> pending-delete-kind: ProfileKind.none;
    property <string> pending-delete-uuid;
    property <string> pending-delete-name;
    property <string> pending-delete-referenced-summary;

    // --- Pending New-profile dialog state ---
    property <ProfileKind> pending-new-kind: ProfileKind.none;
    property <string> pending-new-name;
    /// Filled by Slint-side validation as the user types. Empty
    /// means valid; the dialog disables Confirm while non-empty.
    /// Duplicate-name checks happen server-side — Slint can't
    /// iterate the existing `Profiles.system` / `Profiles.user`
    /// lists from a `function` (no `for` in pure expressions), so
    /// duplicates surface as a toast from the `confirm-create`
    /// Rust handler.
    property <string> pending-new-error;

    // --- Pending Duplicate dialog state ---
    // Bumped when a list row is activated; the detail takes focus and
    // records the request it served in `focus-detail-done`. A column
    // request for the detail does the same while a profile is selected
    // (the list answers it otherwise).
    property <int> focus-detail-tick;
    property <int> focus-detail-done;
    property <int> column-mirror: Nav.column-tick;
    changed column-mirror => {
        if (Nav.column-target == 2 && root.has-selection) {
            Nav.column-served = Nav.column-tick;
            root.focus-detail-tick += 1;
        }
    }
    // The detail went away under focus (its profile was deleted, here
    // or by another client): the list takes over.
    changed has-selection => {
        if (!root.has-selection && Nav.column == 2) {
            Nav.request-column(1);
        }
    }
    property <ProfileKind> pending-duplicate-kind: ProfileKind.none;
    property <string> pending-duplicate-source-uuid;
    property <string> pending-duplicate-name;
    property <string> pending-duplicate-error;

    // --- Pending Reset-all dialog state ---
    //
    // Open when the user clicks the reload glyph in the detail-header
    // toolbar. Snapshots the selected profile's display name so the
    // dialog wording stays stable if a concurrent rename lands during
    // the prompt.
    property <ProfileKind> pending-reset-all-kind: ProfileKind.none;
    property <string> pending-reset-all-name;

    function validate-new-name(name: string) -> string {
        if (name == "") {
            return "";
        }
        if (name == "default") {
            return @tr("'default' is reserved.");
        }
        return "";
    }

    function open-create-dialog(kind: ProfileKind) {
        root.pending-new-kind = kind;
        root.pending-new-name = "";
        root.pending-new-error = "";
    }

    function close-create-dialog() {
        root.pending-new-kind = ProfileKind.none;
        root.pending-new-name = "";
        root.pending-new-error = "";
    }

    function open-delete-dialog() {
        root.pending-delete-kind = Profiles.selected-kind;
        root.pending-delete-uuid = Profiles.selected-row.uuid;
        root.pending-delete-name = Profiles.selected-row.name;
        root.pending-delete-referenced-summary = Profiles.selected-row.referenced-by-summary;
    }

    function close-delete-dialog() {
        root.pending-delete-kind = ProfileKind.none;
        root.pending-delete-uuid = "";
        root.pending-delete-name = "";
        root.pending-delete-referenced-summary = "";
    }

    function open-duplicate-dialog() {
        root.pending-duplicate-kind = Profiles.selected-kind;
        root.pending-duplicate-source-uuid = Profiles.selected-row.uuid;
        // Pre-populate with a suggested name. The user can edit before
        // committing; the daemon enforces uniqueness server-side.
        root.pending-duplicate-name = @tr("{} (copy)", Profiles.selected-row.name);
        root.pending-duplicate-error = root.validate-new-name(root.pending-duplicate-name);
    }

    function close-duplicate-dialog() {
        root.pending-duplicate-kind = ProfileKind.none;
        root.pending-duplicate-source-uuid = "";
        root.pending-duplicate-name = "";
        root.pending-duplicate-error = "";
    }

    function open-reset-all-dialog() {
        root.pending-reset-all-kind = Profiles.selected-kind;
        root.pending-reset-all-name = Profiles.selected-row.name;
    }

    function close-reset-all-dialog() {
        root.pending-reset-all-kind = ProfileKind.none;
        root.pending-reset-all-name = "";
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        HorizontalLayout {
            width: 100%;
            spacing: 0;
            vertical-stretch: 1;

            ProfileList {
                request-create(kind) => { root.open-create-dialog(kind); }
                activated => { root.focus-detail-tick += 1; }
            }

            // Detail column — fills remaining width.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-alt;

                if !root.has-selection: ProfileDetailEmpty {
                    width: 100%;
                    height: 100%;
                }

                if root.has-selection: ProfileDetail {
                    width: 100%;
                    height: 100%;
                    name: Profiles.selected-row.name;
                    display-name: Profiles.selected-row.display-name;
                    kind: Profiles.selected-kind;
                    referenced-by: Profiles.selected-row.referenced-by;
                    active: Profiles.selected-row.active;
                    can-delete: !Profiles.selected-row.is-default;
                    focus-tick: root.focus-detail-tick;
                    focus-done <=> root.focus-detail-done;
                    request-delete => { root.open-delete-dialog(); }
                    request-duplicate => { root.open-duplicate-dialog(); }
                    request-reset-all => { root.open-reset-all-dialog(); }
                }
            }
        }
    }

    // Delete-confirm dialog. When the profile is referenced by one
    // or more TVs the dialog flips into "cannot delete" mode:
    // message names the offending TVs, Confirm is disabled, only
    // Cancel works. The reference list is computed client-side via
    // the shared `references_of` helper at master-list build time —
    // no extra round-trip.
    ConfirmDialog {
        open: root.pending-delete-kind != ProfileKind.none;
        title: @tr("Delete profile");
        message: root.pending-delete-referenced-summary != ""
            ? @tr("Cannot delete '{}': still used by {}. Remove or reassign these TVs first.",
                  root.pending-delete-name,
                  root.pending-delete-referenced-summary)
            : @tr("Delete '{}'? This action cannot be undone.", root.pending-delete-name);
        confirm-label: @tr("Delete");
        confirm-enabled: root.pending-delete-referenced-summary == "";
        confirmed => {
            Profiles.confirm-delete(root.pending-delete-kind, root.pending-delete-uuid);
            root.close-delete-dialog();
        }
        cancelled => { root.close-delete-dialog(); }
    }

    // New-profile name-input dialog. `kind` is set when opening; the
    // post-confirm `confirm-create` routes to either Manager1 or
    // Session1 based on it.
    NameInputDialog {
        open: root.pending-new-kind != ProfileKind.none;
        title: root.pending-new-kind == ProfileKind.system
            ? @tr("New system profile")
            : @tr("New user profile");
        prompt: @tr("Enter a name for the new profile.");
        placeholder: @tr("guest");
        confirm-label: @tr("Create");
        name <=> root.pending-new-name;
        error-message: root.pending-new-error;
        name-changed(v) => {
            root.pending-new-error = root.validate-new-name(v);
        }
        confirmed => {
            Profiles.confirm-create(root.pending-new-kind, root.pending-new-name);
            root.close-create-dialog();
        }
        cancelled => { root.close-create-dialog(); }
    }

    // Duplicate-profile name-input dialog. Pre-populated with
    // "<source name> (copy)"; the daemon enforces uniqueness server-
    // side (no client-side iteration of existing names available in
    // Slint pure expressions).
    NameInputDialog {
        open: root.pending-duplicate-kind != ProfileKind.none;
        title: @tr("Duplicate profile");
        prompt: @tr("Enter a name for the new profile.");
        placeholder: @tr("guest");
        confirm-label: @tr("Duplicate");
        name <=> root.pending-duplicate-name;
        error-message: root.pending-duplicate-error;
        name-changed(v) => {
            root.pending-duplicate-error = root.validate-new-name(v);
        }
        confirmed => {
            Profiles.confirm-duplicate(
                root.pending-duplicate-kind,
                root.pending-duplicate-source-uuid,
                root.pending-duplicate-name,
            );
            root.close-duplicate-dialog();
        }
        cancelled => { root.close-duplicate-dialog(); }
    }

    // Reset-all confirm dialog. Bulk field clear is destructive
    // enough that the user gets one chance to back out — symmetric
    // with the delete-confirm dialog. Single round-trip on confirm.
    ConfirmDialog {
        open: root.pending-reset-all-kind != ProfileKind.none;
        title: @tr("Reset all fields");
        message: @tr("Clear every locally-set field on '{}'? Inheriting values resume from the default profile.",
                     root.pending-reset-all-name);
        confirm-label: @tr("Reset all");
        confirmed => {
            Profiles.reset-all();
            root.close-reset-all-dialog();
        }
        cancelled => { root.close-reset-all-dialog(); }
    }
}
