import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component ProfilesPane inherits Rectangle {
    background: Theme.surface-alt;

    VerticalBox {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 6px;

        HorizontalBox {
            alignment: center;
            Text {
                text: "Profiles";
                font-size: 24px;
                font-weight: 600;
                color: Theme.text;
            }
        }
        HorizontalBox {
            alignment: center;
            Text {
                text: "System and user profile editing arrives in M4.";
                color: Theme.text-dim;
                font-size: 13px;
            }
        }
    }
}
