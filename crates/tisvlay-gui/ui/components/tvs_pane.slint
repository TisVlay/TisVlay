// TVs pane — master/detail layout.
//
// Implements the design at
//   .claude/ui/design_handoff_tisvlay_gui/tvs-pane.jsx
// using the global Theme tokens from ../theme.slint. Stick to stock
// std-widgets (Button, Switch, Slider, ComboBox, ScrollView, ListView)
// plus a handful of bespoke primitives below (Chip, VendorTile, Group,
// FormRow) — no exotic styling.

import { ListView, ScrollView, VerticalBox, HorizontalBox, Button, Slider, ComboBox, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct TvViewModel {
    id: string,
    name: string,
    vendor: string,
    ip: string,
    connected: bool,
    power-state: string,
    is-screen-on: bool,
    volume: int,
    muted: bool,
    backlight: int,
    current-input: string,
    available-input-ids: [string],
    system-profile: string,
    user-profile: string,
    primary-input: string,
    managed: bool,
    automated: bool,
    hw-manufacturer: string,
    hw-model: string,
    hw-serial: string,
    desktop-connector: string,
    /// Empty when no power-on is in flight; otherwise the latest
    /// phase string from `Tv1.Power.PowerCycleProgress`
    /// ("wol_sent" / "connecting" / "connected" / "failed").
    power-cycle-phase: string,
}

// =============================================================================
// Vendor tile — colored square with two-letter code.
// =============================================================================
//
// Hardcoded vendor → (letters, bg, fg) map. Decorative; not pulled from
// theme tokens. Same map used in app-shell.jsx (uploads/app-shell.jsx).

component VendorTile inherits Rectangle {
    in property <string> vendor;
    in property <length> tile-size: 28px;

    width: tile-size;
    height: tile-size;
    border-radius: 5px;

    property <bool> is-lg: vendor == "lg";
    property <bool> is-samsung: vendor == "samsung";
    property <bool> is-sony: vendor == "sony";
    property <bool> is-known: is-lg || is-samsung || is-sony;

    background: is-lg ? #a50034
              : is-samsung ? #1428a0
              : is-sony ? #111111
              : Theme.chip;
    border-width: is-known ? 0 : 1px;
    border-color: Theme.border;

    Text {
        text: root.is-lg ? "LG"
            : root.is-samsung ? "SS"
            : root.is-sony ? "SY"
            : "MK";
        color: root.is-known ? white : Theme.chip-text;
        font-size: root.tile-size * 0.40;
        font-weight: 700;
        letter-spacing: 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// =============================================================================
// Chip — small status pill (Connected, Managed, Unmanaged, etc.).
// =============================================================================
//
// `tone` selects the color palette. Defaults to neutral.

export component Chip inherits Rectangle {
    in property <string> label;
    /// One of: "neutral", "success", "danger", "warn", "accent".
    in property <string> tone: "neutral";

    property <brush> bg-color: tone == "success" ? Theme.success-soft
                              : tone == "danger" ? Theme.danger-soft
                              : tone == "warn" ? Theme.warn-soft
                              : tone == "accent" ? Theme.accent-soft
                              : Theme.chip;
    property <brush> fg-color: tone == "success" ? Theme.success-text
                              : tone == "danger" ? Theme.danger-text
                              : tone == "warn" ? Theme.warn-text
                              : tone == "accent" ? Theme.accent
                              : Theme.chip-text;
    property <brush> br-color: tone == "success" ? Theme.success
                              : tone == "danger" ? Theme.danger
                              : tone == "warn" ? Theme.warn
                              : tone == "accent" ? Theme.accent
                              : Theme.chip-border;

    background: bg-color;
    border-color: br-color;
    border-width: 1px;
    border-radius: 10px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text {
            text: root.label;
            color: root.fg-color;
            font-size: 11px;
            font-weight: 600;
        }
    }
}

// =============================================================================
// Group — design-system replacement for std-widgets GroupBox.
// =============================================================================
//
// Uppercase 11px title above a card with 1px border, 6px radius, 14px
// padding. Mirrors the JSX `AppGroup`. Children supply their own
// vertical layout.

export component Group {
    in property <string> title;
    in property <length> body-padding: 14px;

    VerticalLayout {
        width: 100%;
        spacing: 0;

        // Title
        HorizontalLayout {
            padding-left: 2px;
            padding-bottom: 8px;
            Text {
                text: root.title;
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.6px;
            }
        }

        // Card
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                width: 100%;
                padding: root.body-padding;
                spacing: 12px;
                @children
            }
        }
    }
}

// =============================================================================
// FormRow — labeled config row with optional helper text below.
// =============================================================================
//
// Layout:
//   [ 140px label ] [ control flex ]
//                   [ helper      ]

component FormRow {
    in property <string> label;
    in property <string> helper;
    in property <length> label-width: 140px;

    HorizontalLayout {
        width: 100%;
        spacing: 14px;
        alignment: stretch;

        VerticalLayout {
            width: root.label-width;
            alignment: start;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: top;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;

            HorizontalLayout {
                width: 100%;
                @children
            }

            if root.helper != "": Text {
                text: root.helper;
                color: Theme.text-faint;
                font-size: 11px;
            }
        }
    }
}

// =============================================================================
// Master list — left column, 260px.
// =============================================================================

component TvListRow inherits Rectangle {
    in property <TvViewModel> tv;
    in property <bool> selected;
    callback clicked();

    height: 64px;
    background: selected ? Theme.row-selected
              : (touch.has-hover ? Theme.row-hover : transparent);

    // 3px left accent stripe when selected.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            width: 28px;
            alignment: center;
            VendorTile {
                vendor: root.tv.vendor;
                tile-size: 28px;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.tv.name;
                color: root.selected ? Theme.row-selected-text : Theme.text;
                font-size: 13px;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                // Connection status dot.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.tv.connected ? Theme.success : Theme.text-faint;
                }
                Text {
                    text: !root.tv.connected ? "Standby"
                        : (root.tv.is-screen-on ? "On" : "Screen off");
                    color: Theme.text-dim;
                    font-size: 11px;
                }
                if !root.tv.managed: Text {
                    text: "· unmanaged";
                    color: Theme.warn-text;
                    font-size: 11px;
                }
            }
        }
    }

    // Bottom 1px separator.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TvList inherits Rectangle {
    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available;
    in-out property <int> selected-index;
    callback request-pair();
    callback reload-config();

    width: 260px;
    background: Theme.surface-alt;

    // Right separator.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        // -- Header band --
        Rectangle {
            height: 40px;
            background: Theme.surface;

            // Bottom separator.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: stretch;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.tvs.length == 1
                            ? "1 CONFIGURED"
                            : root.tvs.length + " CONFIGURED";
                        color: Theme.text-dim;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                    }
                }

                // "+" Pair-new-TV button.
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: pair-touch.has-hover ? #2c8fc4 : Theme.accent;

                    Text {
                        text: "+";
                        color: white;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    pair-touch := TouchArea {
                        clicked => { root.request-pair(); }
                    }
                }
            }
        }

        // -- Empty / offline / list states --
        if root.tvs.length == 0 && !root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: 16px;
                Text {
                    text: "Daemon offline";
                    color: Theme.danger-text;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        if root.tvs.length == 0 && root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: 16px;
                Text {
                    text: "No TVs configured";
                    color: Theme.text-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        ListView {
            for tv[i] in root.tvs: TvListRow {
                tv: tv;
                selected: i == root.selected-index;
                clicked => { root.selected-index = i; }
            }
        }

        // -- Footer: Reload Config --
        Rectangle {
            height: 48px;
            background: Theme.surface2;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 8px;
                Button {
                    text: "Reload config";
                    clicked => { root.reload-config(); }
                }
            }
        }
    }
}

// =============================================================================
// Detail — right column, fills remaining width.
// =============================================================================

component LabeledRow {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;

    HorizontalLayout {
        width: 100%;
        spacing: 8px;
        padding-top: 4px;
        padding-bottom: 4px;

        VerticalLayout {
            width: 140px;
            alignment: start;
            Text {
                text: root.label;
                color: Theme.text-dim;
                font-size: 12.5px;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            Text {
                text: root.value == "" ? "—" : root.value;
                color: Theme.text;
                font-size: 12.5px;
                font-family: root.mono ? "ui-monospace, monospace" : "";
                overflow: elide;
            }
        }
    }
}

component TvDetailHeader inherits Rectangle {
    in property <TvViewModel> tv;
    callback request-remove();

    height: header-layout.preferred-height;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    header-layout := HorizontalLayout {
        width: 100%;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 14px;
        alignment: stretch;

        VerticalLayout {
            width: 40px;
            alignment: center;
            VendorTile {
                vendor: root.tv.vendor;
                tile-size: 40px;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.tv.name;
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.tv.ip == "" ? "—" : root.tv.ip;
                    color: Theme.text-dim;
                    font-size: 12px;
                    font-family: "ui-monospace, monospace";
                }
                Text {
                    text: "·";
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                Text {
                    text: root.tv.hw-model == "" ? "—" : root.tv.hw-model;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
            }
        }

        // Status badges.
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Chip {
                    label: root.tv.connected ? "Connected" : "Disconnected";
                    tone: root.tv.connected ? "success" : "neutral";
                }
                Chip {
                    label: !root.tv.managed
                        ? "Unmanaged"
                        : (root.tv.automated ? "Automated" : "Managed");
                    tone: !root.tv.managed
                        ? "warn"
                        : (root.tv.automated ? "accent" : "neutral");
                }
            }
        }
    }
}

component TvDetail inherits Rectangle {
    in property <TvViewModel> tv;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;

    callback set-volume(int);
    callback set-mute(bool);
    callback set-backlight(int);
    callback set-is-screen-on(bool);
    callback switch-input(string);
    callback power-on();
    callback power-off();
    callback set-managed(bool);
    callback set-system-profile(string);
    callback set-user-profile(string);
    callback set-primary-input(string);
    callback request-remove();

    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Sticky-ish header.
        TvDetailHeader {
            tv: root.tv;
        }

        // Scrollable body.
        ScrollView {
            VerticalLayout {
                width: 100%;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 24px;
                spacing: 16px;

                // -- Power --
                Group {
                    title: "POWER";

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: stretch;

                        Button {
                            text: root.tv.connected ? "Power off" : "Power on";
                            primary: !root.tv.connected;
                            // Disable while a power-cycle is in flight (any
                            // non-empty phase that isn't "connected" / "failed").
                            enabled: root.tv.power-cycle-phase == ""
                                  || root.tv.power-cycle-phase == "connected"
                                  || root.tv.power-cycle-phase == "failed";
                            clicked => {
                                if (root.tv.connected) {
                                    root.power-off();
                                } else {
                                    root.power-on();
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.tv.power-cycle-phase == "wol_sent" ? "Sending wake-up…"
                                    : root.tv.power-cycle-phase == "connecting" ? "Connecting…"
                                    : root.tv.power-cycle-phase == "connected" ? "Connected"
                                    : root.tv.power-cycle-phase == "failed" ? "Wake failed"
                                    : root.tv.connected
                                        ? ("Power state: " + root.tv.power-state)
                                        : "Wake this TV with WoL and reconnect.";
                                color: root.tv.power-cycle-phase == "failed" ? Theme.danger-text
                                     : root.tv.power-cycle-phase == "connected" ? Theme.success-text
                                     : Theme.text-dim;
                                font-size: 12px;
                            }
                        }
                    }

                    // 1px divider.
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: stretch;

                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: "Screen";
                                color: Theme.text;
                                font-size: 13px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked: root.tv.is-screen-on;
                                enabled: root.tv.connected;
                                toggled => { root.set-is-screen-on(self.checked); }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Blanks the panel without powering off (OLED-safe, instant resume).";
                                color: Theme.text-faint;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // -- Audio --
                Group {
                    title: "AUDIO";

                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: "Volume";
                                color: Theme.text;
                                font-size: 13px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Slider {
                                minimum: 0;
                                maximum: 100;
                                value: root.tv.volume;
                                enabled: root.tv.connected && !root.tv.muted;
                                changed(v) => { root.set-volume(round(v)); }
                            }
                        }
                        VerticalLayout {
                            width: 36px;
                            alignment: center;
                            Text {
                                text: root.tv.connected ? root.tv.volume : "—";
                                color: root.tv.connected ? Theme.text : Theme.text-faint;
                                font-size: 13px;
                                horizontal-alignment: right;
                                width: 100%;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: "Mute";
                                color: Theme.text;
                                font-size: 13px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                checked: root.tv.muted;
                                enabled: root.tv.connected;
                                toggled => { root.set-mute(self.checked); }
                            }
                        }
                    }
                }

                // -- Picture --
                Group {
                    title: "PICTURE";

                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: "Backlight";
                                color: Theme.text;
                                font-size: 13px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Slider {
                                minimum: 0;
                                maximum: 100;
                                value: root.tv.backlight;
                                enabled: root.tv.connected;
                                changed(v) => { root.set-backlight(round(v)); }
                            }
                        }
                        VerticalLayout {
                            width: 36px;
                            alignment: center;
                            Text {
                                text: root.tv.connected ? root.tv.backlight : "—";
                                color: root.tv.connected ? Theme.text : Theme.text-faint;
                                font-size: 13px;
                                horizontal-alignment: right;
                                width: 100%;
                            }
                        }
                    }
                }

                // -- Input --
                Group {
                    title: "INPUT";

                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: "Current";
                                color: Theme.text;
                                font-size: 13px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            ComboBox {
                                model: root.tv.available-input-ids;
                                current-value: root.tv.current-input;
                                enabled: root.tv.connected
                                      && root.tv.available-input-ids.length > 0;
                                selected(v) => { root.switch-input(v); }
                            }
                        }
                    }
                }

                // -- Configuration --
                Group {
                    title: "CONFIGURATION";

                    FormRow {
                        label: "Managed";
                        helper: "Participates in boot, sleep, and session automation.";
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.tv.managed;
                                    toggled => { root.set-managed(self.checked); }
                                }
                            }
                            if root.tv.automated: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "● automated now";
                                    color: Theme.accent;
                                    font-size: 11.5px;
                                    font-weight: 500;
                                }
                            }
                        }
                    }

                    FormRow {
                        label: "System profile";
                        helper: "Drives daemon lifecycle (boot/shutdown/sleep).";
                        ComboBox {
                            model: root.system-profiles;
                            current-value: root.tv.system-profile;
                            enabled: root.system-profiles.length > 0;
                            selected(v) => { root.set-system-profile(v); }
                        }
                    }

                    FormRow {
                        label: "User profile";
                        helper: "Drives session events (lock/unlock/idle).";
                        ComboBox {
                            model: root.user-profiles;
                            current-value: root.tv.user-profile;
                            enabled: root.user-profiles.length > 0;
                            selected(v) => { root.set-user-profile(v); }
                        }
                    }

                    FormRow {
                        label: "Primary input";
                        helper: "Which input this PC uses; affects on-primary automation.";
                        ComboBox {
                            model: root.tv.available-input-ids;
                            current-value: root.tv.primary-input;
                            enabled: root.tv.available-input-ids.length > 0;
                            selected(v) => { root.set-primary-input(v); }
                        }
                    }
                }

                // -- Hardware identity --
                Group {
                    title: "HARDWARE IDENTITY";

                    LabeledRow { label: "TV ID"; value: root.tv.id; mono: true; }
                    LabeledRow { label: "Manufacturer"; value: root.tv.hw-manufacturer; }
                    LabeledRow { label: "Model"; value: root.tv.hw-model; }
                    LabeledRow { label: "Serial"; value: root.tv.hw-serial; mono: true; }
                    LabeledRow { label: "DRM connector"; value: root.tv.desktop-connector; mono: true; }
                }

                // -- Danger zone --
                Group {
                    title: "DANGER ZONE";

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Removes this TV from the daemon's configuration. Pairing must be redone.";
                                color: Theme.text-dim;
                                font-size: 12.5px;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Remove TV";
                                clicked => { root.request-remove(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component TvDetailEmpty inherits Rectangle {
    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 8px;

        HorizontalLayout {
            alignment: center;
            Text {
                text: "Select a TV";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: "Pick a TV from the list, or pair a new one with the + button.";
                color: Theme.text-dim;
                font-size: 12.5px;
                horizontal-alignment: center;
            }
        }
    }
}

// =============================================================================
// Confirm-remove modal (shared with the TVs pane).
// =============================================================================

component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "OK";
    callback confirmed();
    callback cancelled();

    visible: open;
    background: #00000080;
    width: 100%;
    height: 100%;

    TouchArea {
        clicked => { root.cancelled(); }
    }

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;
        border-color: Theme.border;
        border-width: 1px;
        width: 380px;
        height: 170px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        TouchArea {}

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 18px;
            spacing: 12px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: root.message;
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: root.confirm-label;
                    primary: true;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

// =============================================================================
// TvsPane — top-level pane composition.
// =============================================================================

export component TvsPane {
    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in-out property <int> selected-index: -1;

    callback set-volume(string, int);
    callback set-mute(string, bool);
    callback set-backlight(string, int);
    callback set-is-screen-on(string, bool);
    callback switch-input(string, string);
    callback power-on(string);
    callback power-off(string);
    callback set-managed(string, bool);
    callback set-system-profile(string, string);
    callback set-user-profile(string, string);
    callback set-primary-input(string, string);
    callback remove-tv(string);
    callback reload-config();
    callback request-pair();

    property <string> pending-remove-id: "";
    property <string> pending-remove-name: "";

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        TvList {
            tvs: root.tvs;
            daemon-available: root.daemon-available;
            selected-index <=> root.selected-index;
            request-pair => { root.request-pair(); }
            reload-config => { root.reload-config(); }
        }

        // Detail column — fills remaining width.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface-alt;

            // Empty placeholder when no TV selected.
            if root.selected-index < 0 || root.selected-index >= root.tvs.length: TvDetailEmpty {
                width: 100%;
                height: 100%;
            }

            // One TvDetail per TV, only the selected one is visible. Keeps
            // per-TV state (slider scroll position, etc.) intact when
            // switching selections.
            for tv[i] in root.tvs: TvDetail {
                width: parent.width;
                height: parent.height;
                visible: i == root.selected-index;
                tv: tv;
                system-profiles: root.system-profiles;
                user-profiles: root.user-profiles;

                set-volume(v) => { root.set-volume(tv.id, v); }
                set-mute(m) => { root.set-mute(tv.id, m); }
                set-backlight(b) => { root.set-backlight(tv.id, b); }
                set-is-screen-on(s) => { root.set-is-screen-on(tv.id, s); }
                switch-input(input) => { root.switch-input(tv.id, input); }
                power-on => { root.power-on(tv.id); }
                power-off => { root.power-off(tv.id); }
                set-managed(m) => { root.set-managed(tv.id, m); }
                set-system-profile(p) => { root.set-system-profile(tv.id, p); }
                set-user-profile(p) => { root.set-user-profile(tv.id, p); }
                set-primary-input(p) => { root.set-primary-input(tv.id, p); }
                request-remove => {
                    root.pending-remove-id = tv.id;
                    root.pending-remove-name = tv.name;
                }
            }
        }
    }

    ConfirmDialog {
        open: root.pending-remove-id != "";
        title: "Remove TV";
        message: "Remove '" + root.pending-remove-name
            + "' from the daemon's configuration? Pairing must be redone if you re-add it.";
        confirm-label: "Remove";
        confirmed => {
            root.remove-tv(root.pending-remove-id);
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
        cancelled => {
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
    }
}
