import { ListView, ScrollView, GroupBox, VerticalBox, HorizontalBox, Button, Slider, CheckBox, ComboBox, Switch } from "std-widgets.slint";

export struct TvViewModel {
    id: string,
    name: string,
    connected: bool,
    power-state: string,
    is-screen-on: bool,
    volume: int,
    muted: bool,
    backlight: int,
    current-input: string,
    /// IDs of available inputs as flat strings (e.g. ["HDMI_1", ...]).
    /// Used as the model for the input-switcher ComboBox. Slint
    /// expressions can't transform a struct-array into a string-array,
    /// so we materialize it on the Rust side and ship it parallel to
    /// the live state.
    available-input-ids: [string],
    system-profile: string,
    user-profile: string,
    primary-input: string,
    managed: bool,
    automated: bool,
    hw-manufacturer: string,
    hw-model: string,
    hw-serial: string,
    desktop-connector: string,
    /// Empty when no power-on is in flight; otherwise the latest
    /// phase string from `Tv1.Power.PowerCycleProgress`
    /// ("wol_sent" / "connecting" / "connected" / "failed").
    power-cycle-phase: string,
}

component StatusBadge inherits Rectangle {
    in property <bool> ok;
    in property <string> label-on;
    in property <string> label-off;

    background: ok ? #10b98120 : #ef444420;
    border-radius: 4px;
    border-width: 1px;
    border-color: ok ? #10b981 : #ef4444;
    horizontal-stretch: 0;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: ok ? root.label-on : root.label-off;
            color: ok ? #047857 : #b91c1c;
            font-size: 11px;
            font-weight: 600;
        }
    }
}

component LabeledRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: row-layout.preferred-height;

    row-layout := HorizontalBox {
        width: 100%;
        padding: 4px;
        spacing: 8px;

        Text {
            text: root.label;
            color: #6b7280;
            font-size: 12px;
            width: 140px;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            color: #111827;
            font-size: 12px;
            horizontal-stretch: 1;
        }
    }
}

component TvListItem inherits Rectangle {
    in property <string> name;
    in property <bool> connected;
    in property <bool> selected;
    callback clicked();

    height: 56px;
    background: selected ? #dbeafe : (touch.has-hover ? #f3f4f6 : transparent);

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: connected ? #10b981 : #9ca3af;
        }
        Text {
            text: name;
            color: #111827;
            font-size: 14px;
            font-weight: selected ? 600 : 400;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }

    // Bottom separator (Slint Rectangle has no per-side border).
    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: #e5e7eb;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TvDetail inherits ScrollView {
    in property <TvViewModel> tv;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    /// Lookup model for the input switcher / primary-input dropdowns.
    /// Comes from `tv.available-inputs[*].id`.
    in property <[string]> available-input-ids;

    callback set-volume(int);
    callback set-mute(bool);
    callback set-backlight(int);
    callback set-is-screen-on(bool);
    callback switch-input(string);
    callback power-on();
    callback power-off();
    callback set-managed(bool);
    callback set-system-profile(string);
    callback set-user-profile(string);
    callback set-primary-input(string);
    callback request-remove();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Header
        HorizontalBox {
            spacing: 12px;
            alignment: center;

            Text {
                text: tv.name;
                font-size: 20px;
                font-weight: 700;
                color: #111827;
                horizontal-stretch: 1;
            }
            StatusBadge {
                ok: tv.connected;
                label-on: "Connected";
                label-off: "Disconnected";
            }
            StatusBadge {
                ok: tv.managed;
                label-on: "Managed";
                label-off: "Unmanaged";
            }
            Button {
                text: "Remove";
                clicked => { root.request-remove(); }
            }
        }

        // Power
        GroupBox {
            title: "Power";
            VerticalLayout {
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Button {
                        text: tv.connected ? "Power Off" : "Power On";
                        // Disable while a power-cycle is in flight (any
                        // non-empty phase that isn't "connected" / "failed").
                        enabled: tv.power-cycle-phase == ""
                              || tv.power-cycle-phase == "connected"
                              || tv.power-cycle-phase == "failed";
                        clicked => {
                            if (tv.connected) {
                                root.power-off();
                            } else {
                                root.power-on();
                            }
                        }
                    }
                    Text {
                        // Live phase indicator. Empty when idle.
                        text: tv.power-cycle-phase == "wol_sent" ? "Sending wake-up..."
                            : tv.power-cycle-phase == "connecting" ? "Connecting..."
                            : tv.power-cycle-phase == "connected" ? "Connected"
                            : tv.power-cycle-phase == "failed" ? "Wake failed"
                            : "";
                        color: tv.power-cycle-phase == "failed" ? #b91c1c : #6b7280;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Screen";
                        width: 100px;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked: tv.is-screen-on;
                        enabled: tv.connected;
                        toggled => { root.set-is-screen-on(self.checked); }
                    }
                    Text {
                        text: "(blanks the panel without powering off)";
                        color: #9ca3af;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Audio
        GroupBox {
            title: "Audio";
            VerticalLayout {
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Volume";
                        width: 100px;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 0;
                        maximum: 100;
                        value: tv.volume;
                        enabled: tv.connected && !tv.muted;
                        changed(v) => { root.set-volume(round(v)); }
                    }
                    Text {
                        text: tv.connected ? tv.volume : "—";
                        width: 32px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Mute";
                        width: 100px;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked: tv.muted;
                        enabled: tv.connected;
                        toggled => { root.set-mute(self.checked); }
                    }
                }
            }
        }

        // Picture
        GroupBox {
            title: "Picture";
            HorizontalBox {
                spacing: 8px;
                Text {
                    text: "Backlight";
                    width: 100px;
                    vertical-alignment: center;
                }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value: tv.backlight;
                    enabled: tv.connected;
                    changed(v) => { root.set-backlight(round(v)); }
                }
                Text {
                    text: tv.connected ? tv.backlight : "—";
                    width: 32px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        // Input
        GroupBox {
            title: "Input";
            HorizontalBox {
                spacing: 8px;
                Text {
                    text: "Current";
                    width: 100px;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.available-input-ids;
                    current-value: tv.current-input;
                    enabled: tv.connected && root.available-input-ids.length > 0;
                    selected(v) => { root.switch-input(v); }
                }
            }
        }

        // Configuration
        GroupBox {
            title: "Configuration";
            VerticalLayout {
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Managed";
                        width: 140px;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked: tv.managed;
                        toggled => { root.set-managed(self.checked); }
                    }
                    Text {
                        text: tv.automated ? "(automated now)" : "";
                        color: #9ca3af;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "System profile";
                        width: 140px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.system-profiles;
                        current-value: tv.system-profile;
                        enabled: root.system-profiles.length > 0;
                        selected(v) => { root.set-system-profile(v); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "User profile";
                        width: 140px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.user-profiles;
                        current-value: tv.user-profile;
                        enabled: root.user-profiles.length > 0;
                        selected(v) => { root.set-user-profile(v); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Primary input";
                        width: 140px;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.available-input-ids;
                        current-value: tv.primary-input;
                        enabled: root.available-input-ids.length > 0;
                        selected(v) => { root.set-primary-input(v); }
                    }
                }

                LabeledRow { label: "TV ID"; value: root.tv.id; }
            }
        }

        // Hardware identity
        GroupBox {
            title: "Hardware identity";
            VerticalLayout {
                spacing: 2px;
                LabeledRow { label: "Manufacturer"; value: root.tv.hw-manufacturer; }
                LabeledRow { label: "Model"; value: root.tv.hw-model; }
                LabeledRow { label: "Serial"; value: root.tv.hw-serial; }
                LabeledRow { label: "DRM connector"; value: root.tv.desktop-connector; }
            }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "OK";
    callback confirmed();
    callback cancelled();

    visible: open;
    background: #00000080;
    width: 100%;
    height: 100%;

    // Block clicks behind the dialog.
    TouchArea {
        clicked => { root.cancelled(); }
    }

    Rectangle {
        background: white;
        border-radius: 6px;
        width: 360px;
        height: 160px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Block clicks from propagating to the backdrop.
        TouchArea {}

        VerticalBox {
            width: 100%;
            height: 100%;
            padding: 16px;
            spacing: 12px;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: #111827;
            }
            Text {
                text: root.message;
                wrap: word-wrap;
                color: #374151;
            }
            HorizontalBox {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: root.confirm-label;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

export component TvsPane {
    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in-out property <int> selected-index: -1;

    callback set-volume(string, int);
    callback set-mute(string, bool);
    callback set-backlight(string, int);
    callback set-is-screen-on(string, bool);
    callback switch-input(string, string);
    callback power-on(string);
    callback power-off(string);
    callback set-managed(string, bool);
    callback set-system-profile(string, string);
    callback set-user-profile(string, string);
    callback set-primary-input(string, string);
    callback remove-tv(string);
    callback reload-config();

    // The id of the TV pending removal confirmation. Empty when no
    // dialog is open.
    property <string> pending-remove-id: "";
    property <string> pending-remove-name: "";

    HorizontalLayout {
        // Slint Rectangles don't lay out children, so any
        // HorizontalLayout / VerticalLayout that lives inside one needs
        // explicit fill. The parent of TvsPane is a no-layout Rectangle
        // in main.slint.
        width: 100%;
        height: 100%;
        spacing: 0;

        // Master: TV list + footer
        Rectangle {
            width: 260px;
            background: white;

            // Right separator
            Rectangle {
                width: 1px;
                x: parent.width - 1px;
                background: #e5e7eb;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                Rectangle {
                    height: 36px;
                    background: #f9fafb;
                    Text {
                        text: "TVs";
                        x: 12px;
                        vertical-alignment: center;
                        height: parent.height;
                        color: #374151;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    // Bottom separator
                    Rectangle {
                        height: 1px;
                        y: parent.height - 1px;
                        background: #e5e7eb;
                    }
                }

                if root.tvs.length == 0 && !root.daemon-available: Text {
                    text: "Daemon offline";
                    color: #ef4444;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    font-size: 13px;
                    height: 60px;
                }

                if root.tvs.length == 0 && root.daemon-available: Text {
                    text: "No TVs configured";
                    color: #9ca3af;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    font-size: 13px;
                    height: 60px;
                }

                ListView {
                    for tv[i] in root.tvs: TvListItem {
                        name: tv.name;
                        connected: tv.connected;
                        selected: i == root.selected-index;
                        clicked => { root.selected-index = i; }
                    }
                }

                // Footer: Reload Config
                Rectangle {
                    height: 48px;
                    background: #f9fafb;
                    // Top separator (anchored at y=0 of the footer)
                    Rectangle {
                        height: 1px;
                        y: 0;
                        background: #e5e7eb;
                    }
                    HorizontalBox {
                        width: 100%;
                        height: 100%;
                        padding: 8px;
                        alignment: stretch;
                        Button {
                            text: "Reload Config";
                            clicked => { root.reload-config(); }
                        }
                    }
                }
            }
        }

        // Detail: selected TV
        Rectangle {
            background: #f9fafb;
            horizontal-stretch: 1;

            if root.selected-index < 0 || root.selected-index >= root.tvs.length: Text {
                text: root.tvs.length == 0 ? "" : "Select a TV from the list";
                color: #9ca3af;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }

            for tv[i] in root.tvs: TvDetail {
                width: parent.width;
                height: parent.height;
                visible: i == root.selected-index;
                tv: tv;
                system-profiles: root.system-profiles;
                user-profiles: root.user-profiles;
                available-input-ids: tv.available-input-ids;

                set-volume(v) => { root.set-volume(tv.id, v); }
                set-mute(m) => { root.set-mute(tv.id, m); }
                set-backlight(b) => { root.set-backlight(tv.id, b); }
                set-is-screen-on(s) => { root.set-is-screen-on(tv.id, s); }
                switch-input(input) => { root.switch-input(tv.id, input); }
                power-on => { root.power-on(tv.id); }
                power-off => { root.power-off(tv.id); }
                set-managed(m) => { root.set-managed(tv.id, m); }
                set-system-profile(p) => { root.set-system-profile(tv.id, p); }
                set-user-profile(p) => { root.set-user-profile(tv.id, p); }
                set-primary-input(p) => { root.set-primary-input(tv.id, p); }
                request-remove => {
                    root.pending-remove-id = tv.id;
                    root.pending-remove-name = tv.name;
                }
            }
        }
    }

    // Confirm-remove dialog (overlay).
    ConfirmDialog {
        open: root.pending-remove-id != "";
        title: "Remove TV";
        message: "Remove '" + root.pending-remove-name + "' from the daemon's configuration?";
        confirm-label: "Remove";
        confirmed => {
            root.remove-tv(root.pending-remove-id);
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
        cancelled => {
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
    }
}
