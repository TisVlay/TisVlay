// TVs pane — master/detail layout.
//
// Implements the design at
//   .claude/ui/design_handoff_tisvlay_gui/tvs-pane.jsx
// using the global Theme tokens from ../theme.slint. Stick to stock
// std-widgets (Button, Switch, Slider, ComboBox, ScrollView, ListView)
// plus a handful of bespoke primitives below (Chip, VendorTile, Group,
// FormRow) — no exotic styling.

import { Button, ComboBox, ListView, ScrollView, VerticalBox, HorizontalBox, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { Daemon } from "../globals/daemon.slint";
import { PairingWizard, WizardDiscoveredTv, VendorOption } from "../globals/pairing_wizard.slint";
import { DangerBtn, Chip, Group, OptimisticSlider, CopyBtn } from "../widgets.slint";
import { PairingWizardPane } from "pairing_wizard.slint";

export { WizardDiscoveredTv, VendorOption, DangerBtn, Chip, Group }

export struct TvViewModel {
    id: string,
    name: string,
    vendor: string,
    ip: string,
    connected: bool,
    power-state: string,
    is-screen-on: bool,
    volume: int,
    muted: bool,
    backlight: int,
    current-input: string,
    available-input-ids: [string],
    system-profile: string,
    user-profile: string,
    primary-input: string,
    managed: bool,
    automated: bool,
    hw-manufacturer: string,
    hw-model: string,
    hw-serial: string,
    desktop-connector: string,
    /// Empty when no power-on is in flight; otherwise the latest
    /// phase string from `Tv1.Power.PowerCycleProgress`
    /// ("wol_sent" / "connecting" / "connected" / "failed").
    power-cycle-phase: string,
}

// =============================================================================
// Vendor tile — colored square with two-letter code.
// =============================================================================
//
// Hardcoded vendor → (letters, bg, fg) map. Decorative; not pulled from
// theme tokens. Same map used in app-shell.jsx (uploads/app-shell.jsx).

component VendorTile inherits Rectangle {
    in property <string> vendor;
    in property <length> tile-size: 28px;

    width: tile-size;
    height: tile-size;
    border-radius: 5px;

    property <bool> is-lg: vendor == "lg";
    property <bool> is-samsung: vendor == "samsung";
    property <bool> is-sony: vendor == "sony";
    property <bool> is-known: is-lg || is-samsung || is-sony;

    background: is-lg ? #a50034
              : is-samsung ? #1428a0
              : is-sony ? #111111
              : Theme.chip;
    border-width: is-known ? 0 : Design.border-thin;
    border-color: Theme.border;

    Text {
        text: root.is-lg ? "LG"
            : root.is-samsung ? "SS"
            : root.is-sony ? "SY"
            : "MK";
        color: root.is-known ? white : Theme.chip-text;
        font-size: root.tile-size * 0.40;
        font-weight: 700;
        letter-spacing: 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// =============================================================================
// FormRow — labeled config row with optional helper text below.
// =============================================================================
//
// Layout:
//   [ 140px label ] [ control flex ]
//                   [ helper      ]

component FormRow {
    in property <string> label;
    in property <string> helper;
    in property <length> label-width: Design.width-label-col;

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-row;

        VerticalLayout {
            width: root.label-width;
            alignment: start;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Design.font-body;
                vertical-alignment: top;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Design.gap-form;

            // No `width: 100%` here. Verified via minimal repro
            // (HorizontalLayout/VerticalLayout chain, MCP element
            // tree): a `width: 100%` binding sets `min_percent: 100`,
            // which the parent layout's `box_layout_info_ortho` merge
            // bubbles up to the wrapping VL, then `solve_box_layout`
            // converts back to absolute via `min_percent * content_size
            // / 100` — yielding an effective min equal to the full
            // row width. The right column then claims the whole row,
            // overshooting by exactly the label-width. Layouts already
            // fill their parent's available width by default, so the
            // explicit `width: 100%` is both unnecessary and harmful.
            HorizontalLayout {
                @children
            }

            if root.helper != "": Text {
                text: root.helper;
                color: Theme.text-faint;
                font-size: Design.font-mini;
                wrap: word-wrap;
            }
        }
    }
}

// =============================================================================
// Master list — left column, 260px.
// =============================================================================

component TvListRow inherits Rectangle {
    in property <TvViewModel> tv;
    in property <bool> selected;
    callback clicked();

    height: 64px;
    background: selected ? Theme.row-selected
              : (touch.has-hover ? Theme.row-hover : transparent);
    animate background { duration: 150ms; }

    // 3px left accent stripe when selected.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            width: Design.size-tile-sm;
            alignment: center;
            VendorTile {
                vendor: root.tv.vendor;
                tile-size: Design.size-tile-sm;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.tv.name;
                color: root.selected ? Theme.row-selected-text : Theme.text;
                font-size: Design.font-body;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Design.gap-tight;
                alignment: start;

                // Connection status dot — mirrors the detail-header
                // "Connected" chip: green when connected, dimmed when
                // not.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Design.size-status-dot;
                    height: Design.size-status-dot;
                    border-radius: 3px;
                    background: root.tv.connected ? Theme.success : Theme.text-faint;
                }

                // Management state — mirrors the detail-header
                // "Managed/Automated/Unmanaged" chip's color scheme.
                Text {
                    text: !root.tv.managed
                        ? "Unmanaged"
                        : (root.tv.automated ? "Automated" : "Managed");
                    color: !root.tv.managed
                        ? Theme.warn-text
                        : (root.tv.automated ? Theme.success-text : Theme.info-text);
                    font-size: Design.font-mini;
                }
            }
        }
    }

    // Bottom 1px separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TvList inherits Rectangle {
    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available;
    in-out property <int> selected-index;

    width: Design.width-master;
    background: Theme.surface-alt;

    // Right separator.
    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        // -- Header band --
        Rectangle {
            height: 40px;
            background: Theme.surface;

            // Bottom separator.
            Rectangle {
                y: parent.height - 1px;
                height: Design.border-thin;
                background: Theme.border;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 12px;
                padding-right: Design.gap-stack;
                spacing: Design.gap-stack;
                alignment: stretch;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.tvs.length == 1
                            ? "1 CONFIGURED"
                            : root.tvs.length + " CONFIGURED";
                        color: Theme.text-dim;
                        font-size: Design.font-mini;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                    }
                }

                // "+" Pair-new-TV button. Disabled when the daemon is
                // offline — pairing requires an active daemon
                // connection, so without one the wizard is futile.
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: !root.daemon-available
                        ? Theme.text-faint
                        : (pair-touch.has-hover ? Theme.accent-pressed : Theme.accent);
                    animate background { duration: 150ms; }

                    Text {
                        text: "+";
                        color: white;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    pair-touch := TouchArea {
                        enabled: root.daemon-available;
                        mouse-cursor: root.daemon-available ? pointer : default;
                        clicked => { Daemon.request-pair(); }
                    }
                }
            }
        }

        // -- Empty / offline / list states --
        if root.tvs.length == 0 && !root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-pane;
                Text {
                    text: "Daemon offline";
                    color: Theme.danger-text;
                    font-size: Design.font-body;
                    horizontal-alignment: center;
                }
            }
        }

        if root.tvs.length == 0 && root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-pane;
                Text {
                    text: "No TVs configured";
                    color: Theme.text-faint;
                    font-size: Design.font-body;
                    horizontal-alignment: center;
                }
            }
        }

        ListView {
            for tv[i] in root.tvs: TvListRow {
                tv: tv;
                selected: i == root.selected-index;
                clicked => { root.selected-index = i; }
            }
        }

    }
}

// =============================================================================
// Detail — right column, fills remaining width.
// =============================================================================

component LabeledRow {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-stack;
        padding-top: Design.gap-form;
        padding-bottom: Design.gap-form;

        VerticalLayout {
            width: 140px;
            alignment: start;
            Text {
                text: root.label;
                color: Theme.text-dim;
                font-size: Design.font-meta;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            Text {
                text: root.value == "" ? "—" : root.value;
                color: Theme.text;
                font-size: Design.font-meta;
                font-family: root.mono ? "ui-monospace, monospace" : "";
                overflow: elide;
            }
        }

        // Copy button — only when there's a real value to copy
        // ("—" placeholder for empty fields gets nothing).
        if root.value != "": VerticalLayout {
            alignment: center;
            CopyBtn {
                value: root.value;
            }
        }
    }
}

component TvDetailHeader inherits Rectangle {
    in property <TvViewModel> tv;
    callback request-remove();

    height: header-layout.preferred-height;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    header-layout := HorizontalLayout {
        width: 100%;
        padding-left: Design.pad-pane;
        padding-right: Design.pad-pane;
        padding-top: 18px;
        padding-bottom: Design.gap-row;
        spacing: Design.gap-row;
        alignment: stretch;

        VerticalLayout {
            width: Design.size-tile-md;
            alignment: center;
            VendorTile {
                vendor: root.tv.vendor;
                tile-size: Design.size-tile-md;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Design.gap-form;

            Text {
                text: root.tv.name;
                color: Theme.text;
                font-size: Design.font-title-3;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.tv.ip == "" ? "—" : root.tv.ip;
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                    font-family: "ui-monospace, monospace";
                }
                Text {
                    text: "·";
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                }
                Text {
                    text: root.tv.hw-model == "" ? "—" : root.tv.hw-model;
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                }
            }
        }

        // Status badges.
        VerticalLayout {
            alignment: center;
            spacing: Design.gap-tight;
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: root.tv.connected ? "Connected" : "Disconnected";
                    tone: root.tv.connected ? "success" : "neutral";
                }
            }
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: !root.tv.managed
                        ? "Unmanaged"
                        : (root.tv.automated ? "Automated" : "Managed");
                    tone: !root.tv.managed
                        ? "warn"
                        : (root.tv.automated ? "success" : "info");
                }
            }
        }
    }
}

component TvDetail inherits Rectangle {
    in property <TvViewModel> tv;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;

    /// Local — fires when the user hits "Remove TV". TvsPane catches
    /// this and shows the confirm-remove dialog (which calls
    /// `Daemon.remove-tv(...)` on confirm). All other writes go
    /// straight to the Daemon global from the leaf widgets.
    callback request-remove();

    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Sticky-ish header.
        TvDetailHeader {
            tv: root.tv;
        }

        // Scrollable body. Pin viewport-width to visible-width so the
        // content cannot scroll horizontally; without this, a row whose
        // preferred width exceeds the visible viewport (e.g. a Slider
        // stretched via FormRow) lets the viewport grow to fit and the
        // overflow clips at the window edge instead of the card.
        ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                width: 100%;
                padding-left: Design.pad-pane;
                padding-right: Design.pad-pane;
                padding-top: 20px;
                padding-bottom: Design.pad-pane;
                spacing: Design.gap-pane;

                // -- Status --
                Group {
                    title: "STATUS";

                    HorizontalLayout {
                        spacing: Design.gap-row;
                        alignment: stretch;

                        Button {
                            text: root.tv.connected ? "Power off" : "Power on";
                            primary: !root.tv.connected;
                            // Disable while a power-cycle is in flight (any
                            // non-empty phase that isn't "connected" / "failed").
                            enabled: root.tv.power-cycle-phase == ""
                                  || root.tv.power-cycle-phase == "connected"
                                  || root.tv.power-cycle-phase == "failed";
                            clicked => {
                                if (root.tv.connected) {
                                    Daemon.power-off(root.tv.id);
                                } else {
                                    Daemon.power-on(root.tv.id);
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.tv.power-cycle-phase == "wol_sent" ? "Sending wake-up…"
                                    : root.tv.power-cycle-phase == "connecting" ? "Connecting…"
                                    : root.tv.power-cycle-phase == "connected" ? "Connected"
                                    : root.tv.power-cycle-phase == "failed" ? "Wake failed"
                                    : root.tv.connected
                                        ? ("Power state: " + root.tv.power-state)
                                        : "Wake this TV with WoL and reconnect.";
                                color: root.tv.power-cycle-phase == "failed" ? Theme.danger-text
                                     : root.tv.power-cycle-phase == "connected" ? Theme.success-text
                                     : Theme.text-dim;
                                font-size: Design.font-helper;
                            }
                        }
                    }

                    FormRow {
                        label: "Managed";
                        // helper: "Participates in boot, sleep, and session automation.";
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.tv.managed;
                                    toggled => { Daemon.set-managed(root.tv.id, self.checked); }
                                }
                            }
                            // if root.tv.automated: VerticalLayout {
                            //     alignment: center;
                            //     Text {
                            //         text: "● automated now";
                            //         color: Theme.accent;
                            //         font-size: Design.font-caption;
                            //         font-weight: 500;
                            //     }
                            // }
                        }
                    }
                }

                // -- Profiles --
                Group {
                    title: "PROFILES";

                    FormRow {
                        label: "System";
                        // helper: "Drives daemon lifecycle (boot/shutdown/sleep).";
                        ComboBox {
                            model: root.system-profiles;
                            current-value: root.tv.system-profile == "" ? "default" : root.tv.system-profile;
                            enabled: root.system-profiles.length > 0;
                            selected(v) => { Daemon.set-system-profile(root.tv.id, v); }
                        }
                    }

                    FormRow {
                        label: "User";
                        // helper: "Drives session events (lock/unlock/idle).";
                        ComboBox {
                            model: root.user-profiles;
                            current-value: root.tv.user-profile == "" ? "default" : root.tv.user-profile;
                            enabled: root.user-profiles.length > 0;
                            selected(v) => { Daemon.set-user-profile(root.tv.id, v); }
                        }
                    }
                }

                // -- Audio --
                Group {
                    title: "AUDIO";

                    FormRow {
                        label: "Volume";
                        OptimisticSlider {
                            model-value: root.tv.volume;
                            enabled: root.tv.connected && !root.tv.muted;
                            value-visible: root.tv.connected;
                            committed(v) => { Daemon.set-volume(root.tv.id, v); }
                        }
                    }

                    HorizontalLayout {
                        width: 100%;
                        spacing: Design.gap-row;
                        VerticalLayout {
                            width: Design.width-label-col;
                            alignment: center;
                            Text {
                                text: "Mute";
                                color: Theme.text;
                                font-size: Design.font-body;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Switch {
                                checked: root.tv.muted;
                                enabled: root.tv.connected;
                                toggled => { Daemon.set-mute(root.tv.id, self.checked); }
                            }
                        }
                    }
                }

                // -- Picture --
                Group {
                    title: "PICTURE";

                    FormRow {
                        label: "Backlight";
                        OptimisticSlider {
                            model-value: root.tv.backlight;
                            enabled: root.tv.connected;
                            value-visible: root.tv.connected;
                            committed(v) => { Daemon.set-backlight(root.tv.id, v); }
                        }
                    }

                    FormRow {
                        label: "Screen";
                        // helper: "Blanks the panel without powering off (OLED-safe, instant resume).";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.tv.is-screen-on;
                                    enabled: root.tv.connected;
                                    toggled => { Daemon.set-screen(root.tv.id, self.checked); }
                                }
                            }
                        }
                    }
                }

                // -- Input --
                Group {
                    title: "INPUT";

                    HorizontalLayout {
                        width: 100%;
                        spacing: Design.gap-row;
                        VerticalLayout {
                            width: Design.width-label-col;
                            alignment: center;
                            Text {
                                text: "Current";
                                color: Theme.text;
                                font-size: Design.font-body;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            ComboBox {
                                model: root.tv.available-input-ids;
                                current-value: root.tv.current-input == "" ? "—" : root.tv.current-input;
                                enabled: root.tv.connected
                                      && root.tv.available-input-ids.length > 0;
                                selected(v) => { Daemon.switch-input(root.tv.id, v); }
                            }
                        }
                    }

                    FormRow {
                        label: "Primary";
                        // helper: "Which input this PC uses; affects on-primary automation.";
                        ComboBox {
                            model: root.tv.available-input-ids;
                            current-value: root.tv.primary-input == "" ? "—" : root.tv.primary-input;
                            enabled: root.tv.available-input-ids.length > 0;
                            selected(v) => { Daemon.set-primary-input(root.tv.id, v); }
                        }
                    }
                }

                // -- Info --
                Group {
                    title: "INFO";

                    LabeledRow { label: "TV ID"; value: root.tv.id; mono: true; }
                    LabeledRow { label: "Manufacturer"; value: root.tv.hw-manufacturer; }
                    LabeledRow { label: "Model"; value: root.tv.hw-model; }
                    LabeledRow { label: "Serial"; value: root.tv.hw-serial; mono: true; }
                    LabeledRow { label: "DRM connector"; value: root.tv.desktop-connector; mono: true; }
                }

                // -- Danger zone --
                Group {
                    title: "DANGER ZONE";

                    HorizontalLayout {
                        spacing: Design.gap-row;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "Removes this TV from the daemon's configuration. Pairing must be redone.";
                                color: Theme.text-dim;
                                font-size: Design.font-meta;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            DangerBtn {
                                text: "Remove TV";
                                clicked => { root.request-remove(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component TvDetailEmpty inherits Rectangle {
    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Design.gap-stack;

        HorizontalLayout {
            alignment: center;
            Text {
                text: "Select a TV";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: "Pick a TV from the list, or pair a new one with the + button.";
                color: Theme.text-dim;
                font-size: Design.font-meta;
                horizontal-alignment: center;
            }
        }
    }
}

// =============================================================================
// Confirm-remove modal (shared with the TVs pane).
// =============================================================================

component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "OK";
    callback confirmed();
    callback cancelled();

    visible: open;
    background: #00000080;
    width: 100%;
    height: 100%;

    TouchArea {
        clicked => { root.cancelled(); }
    }

    Rectangle {
        background: Theme.surface;
        border-radius: Design.radius-card;
        border-color: Theme.border;
        border-width: Design.border-thin;
        width: 380px;
        height: 170px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        TouchArea {}

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 18px;
            spacing: 12px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Design.font-title-3;
                font-weight: 700;
            }
            Text {
                text: root.message;
                color: Theme.text-dim;
                font-size: Design.font-body;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: Design.gap-stack;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
                DangerBtn {
                    text: root.confirm-label;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

// =============================================================================
// TvsPane — top-level pane composition.
// =============================================================================

export component TvsPane {
    in property <[TvViewModel]> tvs;
    in property <bool> daemon-available;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in-out property <int> selected-index: -1;

    // Wizard state and callbacks live on the `PairingWizard` global
    // (`globals/pairing_wizard.slint`); user-input dispatch goes
    // through the `Daemon` global (`globals/daemon.slint`). TvsPane
    // doesn't forward callbacks anymore — leaf widgets call the
    // globals directly.

    property <string> pending-remove-id: "";
    property <string> pending-remove-name: "";

    // Pairing wizard takes over the whole pane when active.
    if PairingWizard.active: PairingWizardPane {
        width: 100%;
        height: 100%;
        system-profiles: root.system-profiles;
    }

    if !PairingWizard.active: HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        TvList {
            tvs: root.tvs;
            daemon-available: root.daemon-available;
            selected-index <=> root.selected-index;
        }

        // Detail column — fills remaining width.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface-alt;

            // Empty placeholder when no TV selected.
            if root.selected-index < 0 || root.selected-index >= root.tvs.length: TvDetailEmpty {
                width: 100%;
                height: 100%;
            }

            // One TvDetail per TV, only the selected one is visible. Keeps
            // per-TV state (slider scroll position, etc.) intact when
            // switching selections.
            for tv[i] in root.tvs: TvDetail {
                width: parent.width;
                height: parent.height;
                visible: i == root.selected-index;
                tv: tv;
                system-profiles: root.system-profiles;
                user-profiles: root.user-profiles;

                request-remove => {
                    root.pending-remove-id = tv.id;
                    root.pending-remove-name = tv.name;
                }
            }
        }
    }

    ConfirmDialog {
        open: root.pending-remove-id != "";
        title: "Remove TV";
        message: "Remove '" + root.pending-remove-name
            + "' from the daemon's configuration? Pairing must be redone if you re-add it.";
        confirm-label: "Remove";
        confirmed => {
            Daemon.remove-tv(root.pending-remove-id);
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
        cancelled => {
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
    }
}
