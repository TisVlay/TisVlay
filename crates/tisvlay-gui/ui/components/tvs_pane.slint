// TVs pane — master/detail layout.
//
// Implements the design at
//   .claude/ui/design_handoff_tisvlay_gui/tvs-pane.jsx
// using the global Theme tokens from ../theme.slint. Stick to stock
// std-widgets (Button, Switch, Slider, ComboBox, ScrollView, ListView)
// plus a handful of bespoke primitives — shared ones (Chip,
// VendorTile, Group, …) come from ../widgets.slint; pane-local
// helpers like `FormRow` and `LabeledRow` live further down.

import { Button, ListView, ScrollView, VerticalBox, HorizontalBox, Switch } from "std-widgets.slint";
import { ThemedSelect } from "../globals/select.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { Daemon } from "../globals/daemon.slint";
import { PairingWizard, WizardDiscoveredTv, VendorOption } from "../globals/pairing_wizard.slint";
import { EditPane } from "../globals/edit_pane.slint";
import { Icons } from "../globals/icons.slint";
import { Profiles, ProfileKind } from "../globals/profiles.slint";
import { DangerBtn, Chip, ConfirmDialog, ContextualHelpButton, Group, InlineError, OptimisticSlider, CopyBtn, IconBtn, LineEditField, VendorTile } from "../widgets.slint";
import { HelpScrollView, HelpTrigger } from "../globals/help.slint";
import { Errors } from "../globals/errors.slint";
import { PairingWizardPane } from "pairing_wizard.slint";
import { SchemaForm } from "schema_form.slint";

export { WizardDiscoveredTv, VendorOption, DangerBtn, Chip, Group }

/// One vendor-specific diagnostic row from `Tv1.VendorInfo`.
/// Rendered in the TVs pane's INFO group alongside the cross-vendor
/// identity columns (TV ID, manufacturer, model, …). Backends
/// decide what to surface; LG returns IP + MAC.
export struct VendorInfoRow {
    label: string,
    value: string,
}

export struct TvViewModel {
    uuid: string,
    name: string,
    vendor: string,
    /// Canonical vendor for branding the tile (`Tv1.Brand`): the device's
    /// resolved vendor for CEC (e.g. `lg`), else the backend vendor.
    brand: string,
    primary-descriptor: string,
    connected: bool,
    power-state: string,
    /// Whether the TV is powered on (connected *and* not in a standby /
    /// off / cooling-down state). The power button keys its label and
    /// action on this rather than `connected`, because a CEC TV stays
    /// reachable in standby — `connected` there does not mean "on".
    is-on: bool,
    /// Whether the vendor backend can wake the TV from standby
    /// (LG: has a MAC). The Power-on button is disabled when both
    /// `connected == false` AND `supports-wake == false` — that's
    /// the only state where Power-on has no path to succeed.
    /// Sourced from `Tv1.Power.SupportsWake` D-Bus property.
    supports-wake: bool,
    /// Per-capability flags from `Tv1.Capabilities`. Used to hide
    /// controls a backend can't drive — a CEC TV, for instance, has no
    /// volume, mute, backlight, or screen-blank. Static per vendor:
    /// populated whether or not the TV is connected, so controls don't
    /// flicker in and out as the connection comes and goes.
    has-screen: bool,
    has-volume: bool,
    has-mute: bool,
    has-input: bool,
    has-backlight: bool,
    is-screen-on: bool,
    volume: int,
    muted: bool,
    backlight: int,
    current-input: string,
    available-input-ids: [string],
    /// Friendly name resolved Rust-side from `system-profile-uuid`
    /// for the ComboBox `current-value`. Empty when no assignment
    /// exists (Slint binding falls back to "default" in that case).
    system-profile: string,
    /// Immutable UUID for the navigation pencil. Pre-resolved Rust-
    /// side so an empty assignment surfaces as the
    /// `DEFAULT_SYSTEM_PROFILE_UUID` sentinel rather than `""`,
    /// keeping the Slint click handler free of fallback logic.
    system-profile-uuid: string,
    user-profile: string,
    user-profile-uuid: string,
    primary-input: string,
    managed: bool,
    automated: bool,
    hw-manufacturer: string,
    hw-model: string,
    hw-serial: string,
    desktop-connector: string,
    /// User-editable `(label, value)` rows from
    /// `Tv1.VendorConfig` (LG: IP, MAC). Rendered in the CONFIG
    /// group's view-mode list; the edit form replaces these with
    /// `EditPane.fields` while the user is editing. Empty for
    /// backends without any `UserInput` schema fields.
    vendor-config: [VendorInfoRow],
    /// Backend-discovered diagnostic `(label, value)` rows from
    /// `Tv1.VendorInfo` (LG: WebSocket scheme). Read-only;
    /// rendered in the INFO group alongside the cross-vendor
    /// identity rows. Empty for backends without any `Diagnostic`
    /// schema fields.
    vendor-info: [VendorInfoRow],
    /// Empty when no power-on is in flight; otherwise the latest
    /// phase string from the TV's `progress/power` key
    /// ("wol_sent" / "connecting" / "awaiting_network" / "connected" /
    /// "failed").
    power-cycle-phase: string,
}

// =============================================================================
// FormRow — labeled config row with optional helper text below.
// =============================================================================
//
// Layout:
//   [ 140px label ] [ control flex ]
//                   [ helper      ]

component FormRow {
    in property <string> label;
    in property <string> helper;
    // Optional longer / optional help, revealed by a trailing "i"
    // ContextualHelpButton.
    in property <string> help;
    in property <length> label-width: Design.width-label-col;

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-row;

        VerticalLayout {
            width: root.label-width;
            // No helper → label sits in the row's vertical center so
            // it visually aligns with the control. With a helper, the
            // right column stacks `control + helper` taller than the
            // control itself, so the label top-aligns to track the
            // control's top edge (standard inline-form pattern).
            alignment: root.helper != "" ? start : center;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Design.font-body;
                vertical-alignment: root.helper != "" ? top : center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Design.gap-form;

            // No `width: 100%` here. Verified via minimal repro
            // (HorizontalLayout/VerticalLayout chain, MCP element
            // tree): a `width: 100%` binding sets `min_percent: 100`,
            // which the parent layout's `box_layout_info_ortho` merge
            // bubbles up to the wrapping VL, then `solve_box_layout`
            // converts back to absolute via `min_percent * content_size
            // / 100` — yielding an effective min equal to the full
            // row width. The right column then claims the whole row,
            // overshooting by exactly the label-width. Layouts already
            // fill their parent's available width by default, so the
            // explicit `width: 100%` is both unnecessary and harmful.
            HorizontalLayout {
                spacing: Design.gap-row;
                @children
                // Trailing "i" toggletip (right of the control). Matches
                // the PROFILES rows' trailing edit-pencil wrapper so all
                // right-side row buttons share one layout + spacing.
                if root.help != "": VerticalLayout {
                    alignment: center;
                    width: 24px;
                    ContextualHelpButton {
                        text: root.help;
                    }
                }
            }

            if root.helper != "": Text {
                text: root.helper;
                color: Theme.text-faint;
                font-size: Design.font-mini;
                wrap: word-wrap;
            }
        }
    }
}

// =============================================================================
// Master list — left column, 260px.
// =============================================================================

component TvListRow inherits Rectangle {
    in property <TvViewModel> tv;
    in property <bool> selected;
    callback clicked();

    height: 64px;
    background: selected ? Theme.row-selected
              : (touch.has-hover ? Theme.row-hover : transparent);
    animate background { duration: 150ms; }

    // 3px left accent stripe when selected.
    Rectangle {
        x: 0;
        width: 3px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            width: Design.size-tile-sm;
            alignment: center;
            VendorTile {
                vendor: root.tv.brand;
                tile-size: Design.size-tile-sm;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.tv.name;
                color: root.selected ? Theme.row-selected-text : Theme.text;
                font-size: Design.font-body;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Design.gap-tight;
                alignment: start;

                // Connection status dot — mirrors the detail-header
                // "Connected" chip: green when connected, dimmed when
                // not.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Design.size-status-dot;
                    height: Design.size-status-dot;
                    border-radius: 3px;
                    background: root.tv.connected ? Theme.success : Theme.text-faint;
                }

                // Management state — mirrors the detail-header
                // "Managed/Automated/Unmanaged" chip's color scheme.
                Text {
                    text: !root.tv.managed
                        ? @tr("Unmanaged")
                        : (root.tv.automated ? @tr("Automated") : @tr("Managed"));
                    color: !root.tv.managed
                        ? Theme.warn-text
                        : (root.tv.automated ? Theme.success-text : Theme.info-text);
                    font-size: Design.font-mini;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TvList inherits Rectangle {
    in property <[TvViewModel]> tvs;
    in property <int> connected-count;
    in property <bool> daemon-available;
    in-out property <int> selected-index;

    width: Design.width-master;
    background: Theme.surface-alt;

    // Left separator — divides the column (and its header band) from
    // the sidebar.
    Rectangle {
        x: 0;
        width: Design.border-thin;
        background: Theme.border;
    }

    // Right separator.
    Rectangle {
        x: parent.width - 1px;
        width: Design.border-thin;
        background: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        // -- Header band --
        Rectangle {
            height: 40px;
            // Header band — a distinct surface from the surface-alt
            // master panel below, so the fill contrast sets the band
            // off (no bottom rule).
            background: Theme.surface;

            // Left / right separators. The header's fill covers the
            // master column's edge borders, so re-draw them here to keep
            // the frame continuous across the band.
            Rectangle {
                x: 0;
                width: Design.border-thin;
                background: Theme.border;
            }
            Rectangle {
                x: parent.width - 1px;
                width: Design.border-thin;
                background: Theme.border;
            }

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 12px;
                padding-right: Design.gap-stack;
                spacing: Design.gap-stack;
                alignment: stretch;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        // "N/M CONNECTED" — N connected of M configured.
                        // Connected count comes from Rust via the
                        // `tvs-connected-count` plumb on AppWindow,
                        // since Slint can't aggregate `tv.connected`
                        // across the model in a pure-binding context.
                        text: root.connected-count + "/" + root.tvs.length + " CONNECTED";
                        color: Theme.text-dim;
                        font-size: Design.font-mini;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                    }
                }

                // "+" Pair-new-TV button. Disabled when the daemon is
                // offline — pairing requires an active daemon
                // connection, so without one the wizard is futile.
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: !root.daemon-available
                        ? Theme.text-faint
                        : (pair-touch.has-hover ? Theme.accent-pressed : Theme.accent);
                    animate background { duration: 150ms; }

                    Text {
                        text: "+";
                        color: white;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    // Hover hint: a bare "+" doesn't convey that it
                    // pairs (network discovery), not just adds a row.
                    pair-help := HelpTrigger {
                        width: 100%;
                        height: 100%;
                        text: @tr("Pair a new TV — opens the pairing wizard.");
                    }
                    pair-touch := TouchArea {
                        enabled: root.daemon-available;
                        // Clear on click: the click swaps to the pairing
                        // wizard, removing this button before it could
                        // dismiss its own tip.
                        clicked => {
                            Daemon.request-pair();
                            pair-help.hover-leave();
                        }
                        changed has-hover => {
                            pair-help.set-hover(self.has-hover);
                        }
                    }
                }
            }
        }

        // -- Empty / offline / list states --
        if root.tvs.length == 0 && !root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-pane;
                Text {
                    text: @tr("Daemon offline");
                    color: Theme.danger-text;
                    font-size: Design.font-body;
                    horizontal-alignment: center;
                }
            }
        }

        if root.tvs.length == 0 && root.daemon-available: Rectangle {
            VerticalLayout {
                width: 100%;
                alignment: center;
                padding: Design.gap-pane;
                Text {
                    text: @tr("No TVs configured");
                    color: Theme.text-faint;
                    font-size: Design.font-body;
                    horizontal-alignment: center;
                }
            }
        }

        ListView {
            for tv[i] in root.tvs: TvListRow {
                tv: tv;
                selected: i == root.selected-index;
                clicked => { root.selected-index = i; }
            }
        }

    }
}

// =============================================================================
// Detail — right column, fills remaining width.
// =============================================================================

component LabeledRow {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;

    HorizontalLayout {
        width: 100%;
        spacing: Design.gap-stack;
        padding-top: Design.gap-form;
        padding-bottom: Design.gap-form;

        // Both text columns vertical-center so they align with the
        // CopyBtn's centered position when a value-side button is
        // present (24px button vs ~14px text — top-alignment would
        // leave the texts hanging ~5px above the button's middle).
        VerticalLayout {
            width: Design.width-label-col;
            alignment: center;
            Text {
                text: root.label;
                color: Theme.text-dim;
                font-size: Design.font-meta;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.value == "" ? "—" : root.value;
                color: Theme.text;
                font-size: Design.font-meta;
                font-family: root.mono ? Theme.mono-font : "";
                overflow: elide;
            }
        }

        // Copy button — only when there's a real value to copy
        // ("—" placeholder for empty fields gets nothing). The row's
        // already-translated `label` flows through so the success
        // toast can name the field ("Copied MAC address.").
        if root.value != "": VerticalLayout {
            alignment: center;
            CopyBtn {
                value: root.value;
                label: root.label;
            }
        }
    }
}

component TvDetailHeader inherits Rectangle {
    in property <TvViewModel> tv;
    callback request-remove();

    height: header-layout.preferred-height;
    background: Theme.surface;

    // Bottom separator.
    Rectangle {
        y: parent.height - 1px;
        height: Design.border-thin;
        background: Theme.border;
    }

    header-layout := HorizontalLayout {
        width: 100%;
        padding-left: Design.pad-pane;
        padding-right: Design.pad-pane;
        padding-top: Design.pad-header-top;
        padding-bottom: Design.gap-row;
        spacing: Design.gap-row;
        alignment: stretch;

        VerticalLayout {
            width: Design.size-tile-md;
            alignment: center;
            VendorTile {
                vendor: root.tv.brand;
                tile-size: Design.size-tile-md;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Design.gap-form;

            Text {
                text: root.tv.name;
                color: Theme.text;
                font-size: Design.font-title-3;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Design.gap-meta;
                alignment: start;
                Text {
                    text: root.tv.primary-descriptor == "" ? "—" : root.tv.primary-descriptor;
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                    font-family: Theme.mono-font;
                    // primary-descriptor is the connection address;
                    // a v6 form would otherwise push the hw-model off
                    // the row in the master/detail header.
                    overflow: elide;
                }
                Text {
                    text: "·";
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                }
                Text {
                    text: root.tv.hw-model == "" ? "—" : root.tv.hw-model;
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                }
            }
        }

        // Status badges.
        VerticalLayout {
            alignment: center;
            spacing: Design.gap-tight;
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: root.tv.connected ? @tr("Connected") : @tr("Disconnected");
                    tone: root.tv.connected ? "success" : "neutral";
                }
            }
            HorizontalLayout {
                alignment: end;
                Chip {
                    label: !root.tv.managed
                        ? @tr("Unmanaged")
                        : (root.tv.automated ? @tr("Automated") : @tr("Managed"));
                    tone: !root.tv.managed
                        ? "warn"
                        : (root.tv.automated ? "success" : "info");
                }
            }
        }
    }
}

component TvDetail inherits Rectangle {
    in property <TvViewModel> tv;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;

    /// True when the INFO group should render the edit form for
    /// this specific TV. Tracks `EditPane.tv-uuid` against this
    /// pane's TV — only one TV is edited at a time, so all other
    /// `TvDetail` instances stay in view mode regardless of state.
    property <bool> in-edit-mode: EditPane.tv-uuid == root.tv.uuid;

    /// Local — fires when the user hits "Remove TV". TvsPane catches
    /// this and shows the confirm-remove dialog (which calls
    /// `Daemon.remove-tv(...)` on confirm). All other writes go
    /// straight to the Daemon global from the leaf widgets.
    callback request-remove();
    /// Local — fires when the user hits "Re-pair". TvsPane catches
    /// this and shows the confirm dialog (re-pair disconnects the
    /// active connection and requires user interaction on the TV).
    callback request-re-pair();

    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Sticky-ish header.
        TvDetailHeader {
            tv: root.tv;
        }

        // Scrollable body. HelpScrollView pins content-width (so a row
        // wider than the viewport — e.g. a stretched Slider — clips at
        // the card, not the window) and confines help bubbles to this
        // viewport on scroll/resize. See globals/help.slint.
        HelpScrollView {
            VerticalLayout {
                width: 100%;
                padding-left: Design.pad-pane;
                padding-right: Design.pad-pane;
                padding-top: Design.pad-body-top;
                padding-bottom: Design.pad-pane;
                spacing: Design.gap-pane;

                // -- Status --
                Group {
                    title: @tr("STATUS");

                    power-row := HorizontalLayout {
                        spacing: Design.gap-row;
                        alignment: stretch;

                        // Power-on has two viable paths: direct-connect
                        // (TV reachable already) or Wake-on-LAN (TV in
                        // standby + we have a MAC). When the TV is
                        // offline AND the backend can't wake it, neither
                        // path works — disable the button and tell the
                        // user why. Today this manifests for LG TVs
                        // discovered before the ARP-enrichment fix that
                        // never captured a MAC.
                        property <bool> power-cycle-in-flight:
                               root.tv.power-cycle-phase != ""
                            && root.tv.power-cycle-phase != "connected"
                            && root.tv.power-cycle-phase != "failed";
                        property <bool> can-power-on:
                            root.tv.connected || root.tv.supports-wake;

                        Button {
                            // Keyed on `is-on`, not `connected`: a CEC TV
                            // reachable in standby is connected-but-off, and
                            // must still offer "Power on".
                            text: root.tv.is-on ? @tr("Power off") : @tr("Power on");
                            icon: Icons.shutdown;
                            colorize-icon: true;
                            primary: !root.tv.is-on;
                            enabled: !power-row.power-cycle-in-flight && power-row.can-power-on;
                            clicked => {
                                if (root.tv.is-on) {
                                    Daemon.power-off(root.tv.uuid);
                                } else {
                                    Daemon.power-on(root.tv.uuid);
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.tv.power-cycle-phase == "wol_sent" ? @tr("Sending wake-up…")
                                    : root.tv.power-cycle-phase == "connecting" ? @tr("Connecting…")
                                    : root.tv.power-cycle-phase == "awaiting_network" ? @tr("Waiting for the network…")
                                    : root.tv.power-cycle-phase == "connected" ? @tr("Connected")
                                    : root.tv.power-cycle-phase == "failed" ? @tr("Wake failed")
                                    : root.tv.connected
                                        ? (root.tv.power-state == "warming_up" ? @tr("Warming up…")
                                            : root.tv.power-state == "cooling_down" ? @tr("Cooling down…")
                                            : @tr("Power state: {}", root.tv.power-state))
                                        : !power-row.can-power-on
                                            ? @tr("Wake-on-LAN unavailable — no MAC configured. Pair the TV again or edit the config to add one.")
                                            : @tr("Reconnect, or wake from standby with WoL.");
                                color: root.tv.power-cycle-phase == "failed" ? Theme.danger-text
                                     : root.tv.power-cycle-phase == "connected" ? Theme.success-text
                                     : (!power-row.can-power-on && !root.tv.connected) ? Theme.warn-text
                                     : Theme.text-dim;
                                font-size: Design.font-helper;
                                wrap: word-wrap;
                            }
                        }
                    }

                    FormRow {
                        label: @tr("Managed");
                        help: @tr("Activate both System and User profile automation.");
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.tv.managed;
                                    toggled => { Daemon.set-managed(root.tv.uuid, self.checked); }
                                }
                            }
                        }
                    }
                }

                // -- Profiles --
                Group {
                    title: @tr("PROFILES");

                    // Each row pairs the profile picker with a trailing
                    // pencil shortcut that hands off to the Profiles
                    // pane with the assigned profile pre-selected —
                    // symmetric with the Profiles pane's "Used by"
                    // chips that route the other way. Trailing-icon
                    // placement matches the INFO group's CopyBtn and
                    // the Profiles-pane field-row reset glyph.
                    FormRow {
                        label: @tr("system profile" => "System");
                        help: @tr("Drives daemon lifecycle (boot / shutdown / sleep).");
                        HorizontalLayout {
                            spacing: Design.gap-row;
                            ThemedSelect {
                                model: root.system-profiles;
                                current-value: root.tv.system-profile == "" ? "default" : root.tv.system-profile;
                                enabled: root.system-profiles.length > 0;
                                selected(v) => { Daemon.set-system-profile(root.tv.uuid, v); }
                            }
                            VerticalLayout {
                                alignment: center;
                                width: 24px;
                                IconBtn {
                                    source: Icons.edit;
                                    accessible-label: @tr("Edit system profile");
                                    tip: @tr("Edit system profile");
                                    enabled: root.system-profiles.length > 0;
                                    clicked => {
                                        Profiles.open-profile-by-uuid(
                                            ProfileKind.system,
                                            root.tv.system-profile-uuid,
                                        );
                                    }
                                }
                            }
                        }
                    }

                    FormRow {
                        label: @tr("user profile" => "User");
                        help: @tr("Drives session events (lock / unlock / idle).");
                        HorizontalLayout {
                            spacing: Design.gap-row;
                            ThemedSelect {
                                model: root.user-profiles;
                                current-value: root.tv.user-profile == "" ? "default" : root.tv.user-profile;
                                enabled: root.user-profiles.length > 0;
                                selected(v) => { Daemon.set-user-profile(root.tv.uuid, v); }
                            }
                            VerticalLayout {
                                alignment: center;
                                width: 24px;
                                IconBtn {
                                    source: Icons.edit;
                                    accessible-label: @tr("Edit user profile");
                                    tip: @tr("Edit user profile");
                                    enabled: root.user-profiles.length > 0;
                                    clicked => {
                                        Profiles.open-profile-by-uuid(
                                            ProfileKind.user,
                                            root.tv.user-profile-uuid,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }

                // -- Picture --
                //
                // Capability gating uses `if` (not `visible`): a hidden
                // `visible` element still reserves its layout slot and the
                // surrounding `spacing`, leaving empty rows inside a group and
                // an empty group's gap in the pane. `if` removes it from the
                // layout so the whitespace collapses. The flags are static per
                // vendor, so this still doesn't flicker across connect/reconnect.
                if root.tv.has-backlight || root.tv.has-screen: Group {
                    title: @tr("PICTURE");

                    if root.tv.has-backlight: FormRow {
                        label: @tr("Backlight");
                        help: @tr("Control power draw and/or reduce burn-in risk.");
                        OptimisticSlider {
                            model-value: root.tv.backlight;
                            enabled: root.tv.connected;
                            value-visible: root.tv.connected;
                            committed(v) => { Daemon.set-backlight(root.tv.uuid, v); }
                        }
                    }

                    if root.tv.has-screen: FormRow {
                        label: @tr("screen power" => "Screen");
                        help: @tr("Turn off the display — a dedicated screen-blank with instant resume where the TV supports it, otherwise emulated by powering the set off and on.");
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: root.tv.is-screen-on;
                                    enabled: root.tv.connected;
                                    toggled => { Daemon.set-screen(root.tv.uuid, self.checked); }
                                }
                            }
                        }
                    }
                }

                // -- Audio --
                if root.tv.has-volume || root.tv.has-mute: Group {
                    title: @tr("AUDIO");

                    if root.tv.has-volume: FormRow {
                        label: @tr("Volume");
                        OptimisticSlider {
                            model-value: root.tv.volume;
                            enabled: root.tv.connected && !root.tv.muted;
                            value-visible: root.tv.connected;
                            committed(v) => { Daemon.set-volume(root.tv.uuid, v); }
                        }
                    }

                    if root.tv.has-mute: FormRow {
                        label: @tr("Mute");
                        Switch {
                            checked: root.tv.muted;
                            enabled: root.tv.connected;
                            toggled => { Daemon.set-mute(root.tv.uuid, self.checked); }
                        }
                    }
                }

                // -- Input --
                if root.tv.has-input: Group {
                    title: @tr("INPUT");

                    FormRow {
                        label: @tr("current input" => "Current");
                        help: @tr("Current input shown now; changing it switches the live input.");
                        ThemedSelect {
                            model: root.tv.available-input-ids;
                            current-value: root.tv.current-input == "" ? "—" : root.tv.current-input;
                            enabled: root.tv.connected
                                  && root.tv.available-input-ids.length > 0;
                            selected(v) => { Daemon.switch-input(root.tv.uuid, v); }
                        }
                    }

                    FormRow {
                        label: @tr("primary input" => "Primary");
                        help: @tr("Primary input gating automation; E.g. input used for display.");
                        ThemedSelect {
                            model: root.tv.available-input-ids;
                            current-value: root.tv.primary-input == "" ? "—" : root.tv.primary-input;
                            enabled: root.tv.available-input-ids.length > 0;
                            selected(v) => { Daemon.set-primary-input(root.tv.uuid, v); }
                        }
                    }
                }

                // -- Config --
                //
                // Address-book contact pattern: a small pencil on
                // the CONFIG header line flips Name + vendor
                // `UserInput` rows to editable inputs (LG: IP,
                // MAC); ✓/✗ replace the pencil while editing.
                //
                // Inlines the `Group` widget's title-band + card
                // structure rather than wrapping `Group` so the
                // action icons can sit on the title row itself
                // (Slint v1 has no multi-`@children` slot, so a
                // generic `Group { actions: ... }` API isn't
                // available). Mirrors `Group`'s band exactly —
                // `size-card-header` min-height + `gap-stack` layout
                // spacing — so the action IconBtns fit the reserved
                // band without dropping the card below the Group cards.
                VerticalLayout {
                    spacing: Design.gap-stack;

                    // Title band — same structure as `Group`'s title,
                    // plus right-aligned action icons.
                    HorizontalLayout {
                        min-height: Design.size-card-header;
                        padding-left: 2px;
                        spacing: Design.gap-form;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("CONFIG");
                                color: Theme.text-dim;
                                font-size: Design.font-mini;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                            }
                        }
                        // Spacer pushes action icons to the right.
                        Rectangle { horizontal-stretch: 1; }
                        if !root.in-edit-mode: IconBtn {
                            source: Icons.edit;
                            label: @tr("Edit");
                            accessible-id: "tv-detail-" + root.tv.uuid + "-edit-button";
                            clicked => { EditPane.start(root.tv.uuid); }
                        }
                        if root.in-edit-mode: IconBtn {
                            source: Icons.cancel;
                            label: @tr("Cancel");
                            enabled: !EditPane.saving;
                            accessible-id: "tv-detail-" + root.tv.uuid + "-cancel-button";
                            clicked => { EditPane.cancel(); }
                        }
                        if root.in-edit-mode: IconBtn {
                            source: Icons.save;
                            label: @tr("Save");
                            enabled: EditPane.valid;
                            loading: EditPane.saving;
                            accessible-id: "tv-detail-" + root.tv.uuid + "-save-button";
                            clicked => { EditPane.save(); }
                        }
                    }

                    // Card — same surface treatment as `Group`'s
                    // body, with the edit form / read-only rows.
                    Rectangle {
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: Design.border-thin;
                        border-radius: Design.radius-card;

                        VerticalLayout {
                            width: 100%;
                            padding: Design.pad-card;
                            spacing: Design.gap-block;

                            if root.in-edit-mode && EditPane.error != "": InlineError {
                                title: @tr("Couldn't save TV config");
                                message: EditPane.error;
                                dismissable: false;
                            }

                            // Edit mode: friendly name input +
                            // vendor `UserInput` schema fields. The
                            // schema form is the same component the
                            // pairing wizard uses, so per-field
                            // validation + server-side error
                            // routing are shared.
                            if root.in-edit-mode: VerticalLayout {
                                spacing: Design.gap-row;

                                VerticalLayout {
                                    spacing: Design.gap-form;
                                    Text {
                                        text: @tr("Friendly name");
                                        color: Theme.text;
                                        font-size: Design.font-meta;
                                        font-weight: 500;
                                    }
                                    LineEditField {
                                        placeholder-text: @tr("e.g. Living Room G4");
                                        text <=> EditPane.name;
                                        edited(v) => { EditPane.name-edited(v); }
                                    }
                                }

                                SchemaForm {
                                    schema-fields: EditPane.fields;
                                    value-edited(i, v) => { EditPane.field-edited(i, v); }
                                }
                            }

                            // View mode: name + vendor `UserInput`
                            // rows as read-only labels. Same set
                            // the edit form mutates.
                            if !root.in-edit-mode: VerticalLayout {
                                LabeledRow { label: @tr("Name"); value: root.tv.name; }
                                for entry in root.tv.vendor-config: LabeledRow {
                                    label: entry.label;
                                    value: entry.value;
                                    mono: true;
                                }
                            }
                        }
                    }
                }

                // -- Info --
                //
                // Read-only identity rows that the user can never
                // edit through this surface: TV UUID + hardware
                // identity + DRM connector + backend-discovered
                // diagnostics (LG: WebSocket scheme). Diagnostics
                // refresh only on re-pair.
                Group {
                    title: @tr("INFO");
                    // Read-only data-table — LabeledRow's own
                    // `padding-form` (4+4=8px) is enough vertical
                    // breathing room; Group's default 12px stacks
                    // on top would feel airy next to CONFIG's
                    // view-mode rows.
                    body-spacing: 0;

                    LabeledRow { label: @tr("TV ID"); value: root.tv.uuid; mono: true; }
                    LabeledRow { label: @tr("manufacturer" => "Make"); value: root.tv.hw-manufacturer; }
                    LabeledRow { label: @tr("Model"); value: root.tv.hw-model; }
                    LabeledRow { label: @tr("Serial"); value: root.tv.hw-serial; mono: true; }
                    LabeledRow { label: @tr("Connector"); value: root.tv.desktop-connector; mono: true; }
                    for entry in root.tv.vendor-info: LabeledRow {
                        label: entry.label;
                        value: entry.value;
                        mono: true;
                    }
                }

                // -- Danger zone --
                //
                // Re-pair sits above Remove because both are
                // destructive-ish actions (disconnect → handshake)
                // but re-pair preserves top-level config while
                // Remove drops everything. The vertical order
                // matches escalation: try re-pair first if creds
                // are stale, then Remove as last resort.
                Group {
                    title: @tr("DANGER ZONE");

                    HorizontalLayout {
                        spacing: Design.gap-row;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: @tr("Refreshes vendor credentials by running the pairing handshake again. Top-level settings (name, profile, primary input) are preserved.");
                                color: Theme.text-dim;
                                font-size: Design.font-meta;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Re-pair");
                                clicked => { root.request-re-pair(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Design.gap-row;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: @tr("Removes this TV from the daemon's configuration. Pairing must be redone.");
                                color: Theme.text-dim;
                                font-size: Design.font-meta;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            DangerBtn {
                                text: @tr("Remove TV");
                                clicked => { root.request-remove(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component TvDetailEmpty inherits Rectangle {
    background: Theme.surface-alt;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Design.gap-stack;

        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Select a TV");
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Pick a TV from the list, or pair a new one with the + button.");
                color: Theme.text-dim;
                font-size: Design.font-meta;
                horizontal-alignment: center;
            }
        }
    }
}

// =============================================================================
// TvsPane — top-level pane composition.
// =============================================================================

export component TvsPane {
    in property <[TvViewModel]> tvs;
    in property <int> tvs-connected-count;
    in property <bool> daemon-available;
    in property <[string]> system-profiles;
    in property <[string]> user-profiles;
    in-out property <int> selected-index: -1;

    // Wizard state and callbacks live on the `PairingWizard` global
    // (`globals/pairing_wizard.slint`); user-input dispatch goes
    // through the `Daemon` global (`globals/daemon.slint`). TvsPane
    // doesn't forward callbacks anymore — leaf widgets call the
    // globals directly.

    property <string> pending-remove-id: "";
    property <string> pending-remove-name: "";
    property <string> pending-re-pair-id: "";
    property <string> pending-re-pair-name: "";

    // Pairing wizard takes over the whole pane when active.
    if PairingWizard.active: PairingWizardPane {
        width: 100%;
        height: 100%;
        system-profiles: root.system-profiles;
    }

    if !PairingWizard.active: VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Pane-level inline error surface (Kirigami inline-message
        // pattern). Rust pushes failed user-initiated daemon
        // callbacks here via `Errors.tvs`; the widget is sticky
        // until the user dismisses or the slot clears.
        if Errors.tvs.title != "" || Errors.tvs.message != "": Rectangle {
            background: Theme.surface-alt;
            HorizontalLayout {
                width: 100%;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 0;
                InlineError {
                    tone: Errors.tvs.tone == "" ? "error" : Errors.tvs.tone;
                    title: Errors.tvs.title;
                    message: Errors.tvs.message;
                    action-label: Errors.tvs.action-label;
                    action-clicked => { Errors.tvs-action(); }
                    dismissed => {
                        Errors.tvs = { kind: "", tone: "", title: "", message: "", action-label: "" };
                    }
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            spacing: 0;
            vertical-stretch: 1;

            TvList {
                tvs: root.tvs;
                connected-count: root.tvs-connected-count;
                daemon-available: root.daemon-available;
                selected-index <=> root.selected-index;
            }

            // Detail column — fills remaining width.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-alt;

                // Empty placeholder when no TV selected.
                if root.selected-index < 0 || root.selected-index >= root.tvs.length: TvDetailEmpty {
                    width: 100%;
                    height: 100%;
                }

                // One TvDetail per TV, only the selected one is visible. Keeps
                // per-TV state (slider scroll position, etc.) intact when
                // switching selections.
                for tv[i] in root.tvs: TvDetail {
                    width: parent.width;
                    height: parent.height;
                    visible: i == root.selected-index;
                    tv: tv;
                    system-profiles: root.system-profiles;
                    user-profiles: root.user-profiles;

                    request-remove => {
                        root.pending-remove-id = tv.uuid;
                        root.pending-remove-name = tv.name;
                    }
                    request-re-pair => {
                        root.pending-re-pair-id = tv.uuid;
                        root.pending-re-pair-name = tv.name;
                    }
                }
            }
        }
    }

    ConfirmDialog {
        open: root.pending-remove-id != "";
        title: @tr("Remove TV");
        message: @tr("Remove '{}' from the daemon's configuration? Pairing must be redone if you re-add it.", root.pending-remove-name);
        confirm-label: @tr("Remove");
        confirmed => {
            Daemon.remove-tv(root.pending-remove-id);
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
        cancelled => {
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
    }

    ConfirmDialog {
        open: root.pending-re-pair-id != "";
        title: @tr("Re-pair TV");
        message: @tr("Re-pair '{}'? This will briefly disconnect the TV and prompt you to confirm the pairing on the TV screen. Your TV name, profile, and other settings are preserved.", root.pending-re-pair-name);
        confirm-label: @tr("Re-pair");
        confirmed => {
            Daemon.request-re-pair(root.pending-re-pair-id);
            root.pending-re-pair-id = "";
            root.pending-re-pair-name = "";
        }
        cancelled => {
            root.pending-re-pair-id = "";
            root.pending-re-pair-name = "";
        }
    }
}
