// Schema-driven config form — shared between the pairing wizard's
// step-2 panel and the TVs-pane edit-mode toggle.
//
// Both consumers feed the same `[PairingFieldRow]` model: rows
// generated from a vendor schema (`Manager1.GetPairingSchema` for
// pairing, the daemon's stored schema for editing) plus per-row
// validation lifecycle. The Rust side bridges (`schema_form.rs`)
// owns parse / validate / build-json / autofill; the components
// below own the rendering.
//
// `field-type` is the kebab-case wire string from
// `tisvlay_core::pairing_schema::PairingFieldType` ("string" /
// "password" / "ip" / "mac" / "port" / "int" / "bool" / "select" /
// "path"). `FieldRenderer` switches on it to pick the right widget.

import { CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { PairingFieldRow } from "../globals/pairing_wizard.slint";
import { LineEditField } from "../widgets.slint";

// =============================================================================
// FieldRenderer — renders one row of the dynamic schema.
// =============================================================================
//
// Switches on `row.field-type` to pick the right widget. All edits
// round-trip through `value-edited(string)` — Slint can't mutate
// struct fields inside a `[T]` list, so the parent emits an indexed
// writeback to Rust which mutates the model row.
//
// Only renders the input control + optional helper. The label is
// rendered by the parent layout so all fields have visually-aligned
// labels (matching the existing TisVlay form-label rhythm).
export component FieldRenderer {
    in property <PairingFieldRow> field;
    callback value-edited(string);

    property <bool> is-line-edit:
           root.field.field-type == "string"
        || root.field.field-type == "ip"
        || root.field.field-type == "mac"
        || root.field.field-type == "port"
        || root.field.field-type == "int"
        || root.field.field-type == "path";

    property <bool> is-mono:
           root.field.field-type == "ip"
        || root.field.field-type == "mac"
        || root.field.field-type == "path";

    VerticalLayout {
        spacing: Design.gap-form;

        // Input control (label is rendered by parent so all rows align).
        if root.is-line-edit: LineEditField {
            placeholder-text: root.field.placeholder;
            text: root.field.value;
            font-family: root.is-mono ? "ui-monospace, monospace" : "";
            edited(v) => { root.value-edited(v); }
        }
        if root.field.field-type == "password": LineEdit {
            placeholder-text: root.field.placeholder;
            text: root.field.value;
            input-type: password;
            edited(v) => { root.value-edited(v); }
        }
        if root.field.field-type == "bool": CheckBox {
            text: root.field.label;
            checked: root.field.value == "true";
            toggled => { root.value-edited(self.checked ? "true" : "false"); }
        }
        if root.field.field-type == "select": ComboBox {
            model: root.field.options;
            current-value: root.field.value;
            selected(v) => { root.value-edited(v); }
        }

        // Helper / error text. `error` (typed validation failure
        // — client-side from `PairingField::validate` or
        // server-side from a `ConfigInvalidVendorConfig` D-Bus
        // error) replaces the default helper when set, with a
        // danger tone so it reads as the field-level message.
        if root.field.error != "": Text {
            text: root.field.error;
            color: Theme.danger-text;
            font-size: Design.font-mini;
            wrap: word-wrap;
        }
        if root.field.error == "" && root.field.helper != "": Text {
            text: root.field.helper;
            color: Theme.text-faint;
            font-size: Design.font-mini;
            wrap: word-wrap;
        }
    }
}

// =============================================================================
// SchemaForm — full list of `FieldRenderer` rows with aligned labels.
// =============================================================================
//
// Drops in wherever a schema-driven form is needed. Bool fields
// render their own label inside the checkbox; the rest get a label
// rendered above the input here so all rows have a consistent
// rhythm. Required fields get a trailing "*" appended to the label.
//
// `value-edited(int, string)` is the writeback channel — Slint
// emits it when a row's value changes; Rust side mutates the model
// row in place and recomputes `compute_schema_valid` so the
// consumer's submit-button gating stays in sync.
export component SchemaForm {
    in property <[PairingFieldRow]> schema-fields;
    callback value-edited(int, string);

    VerticalLayout {
        spacing: Design.gap-row;

        for f[i] in root.schema-fields: VerticalLayout {
            spacing: Design.gap-form;
            if f.field-type != "bool": Text {
                text: f.required ? f.label + " *" : f.label;
                color: Theme.text;
                font-size: Design.font-meta;
                font-weight: 500;
            }
            FieldRenderer {
                field: f;
                value-edited(v) => { root.value-edited(i, v); }
            }
        }
    }
}
