// Notices pane — third-party FOSS attribution surface.
//
// Reachable only via the "View third-party notices" button in the
// About pane's LICENSE group; not a sidebar entry (it's reference
// material, not navigation). The pane is its own entry in the
// `Pane` enum to reuse the existing pane-switching plumbing —
// no overlay/popup framework needed.
//
// `back-clicked` returns to the About pane. Sidebar nav stays
// visible alongside; the back button is the canonical return.
//
// `notices-lines` is the build-time-embedded plain-text bundle
// produced by tisvlay-gui's build.rs (cargo-about over the workspace
// dep graph), pre-split line-by-line on the Rust side. See
// `about.txt.hbs` at repo root for the format and Plan 2 Commit B2
// in `docs/plan2.md` for the full pipeline.
//
// Why a `ListView` over a `[string]` model rather than `TextEdit`:
// `TextEdit` is an editable widget that lays out every line for
// cursor / selection bounds, which crashes FPS on the ~9k-line
// bundle. `ListView` is the only virtualised primitive Slint exposes
// (see `internal/core/model/repeater.rs::update_visible_instances`
// in the upstream tree) — it materialises only the rows in the
// viewport. Per the upstream constraint
// `internal/compiler/object_tree.rs:1761` ("A ListView can just have
// a single 'for' as children"), the body is exactly one Repeater.
// Per-row height is pinned so the offset estimator stays stable;
// `overflow: clip` on the Text guards against an unexpectedly long
// line widening the row.

import { Button, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";

export component NoticesPane inherits Rectangle {
    in property <[string]> notices-lines;
    callback back-clicked();

    // Pinned row height — Design.font-helper (12px) at a 1.33x
    // line-height. ListView's offset-estimator assumes uniform row
    // heights; a one-off literal beats promoting a token nothing
    // else needs.
    property <length> row-height: 16px;

    background: Theme.surface-alt;

    VerticalLayout {
        padding-left: Design.pad-pane;
        padding-right: Design.pad-pane;
        padding-top: Design.pad-pane-top;
        padding-bottom: Design.pad-pane;
        spacing: Design.gap-pane;

        // Header row: back button (left) + pane title.
        HorizontalLayout {
            alignment: start;
            spacing: Design.gap-row;
            vertical-stretch: 0;

            Button {
                // KDE HIG: in-app navigation, default arrow cursor —
                // use std-widgets `Button`, not `UriBtn`.
                text: @tr("← Back");
                clicked => { root.back-clicked(); }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Third-Party Licenses");
                    color: Theme.text;
                    font-size: Design.font-title-2;
                    font-weight: 700;
                }
            }
        }

        // Body: virtualised one-row-per-line listing of the bundle.
        // Each Text is a leaf; selection and copy across rows isn't
        // possible (an explicit Copy button would be a follow-up if
        // demand surfaces — for now reaching for the .html shipped
        // at /usr/share/doc/tisvlay/ is the canonical "give me the
        // whole text" path).
        ListView {
            vertical-stretch: 1;
            for line in root.notices-lines: Text {
                text: line;
                color: Theme.text;
                font-family: "ui-monospace, monospace";
                font-size: Design.font-helper;
                height: root.row-height;
                overflow: clip;
            }
        }
    }
}
