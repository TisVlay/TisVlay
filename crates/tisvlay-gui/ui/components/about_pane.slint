import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { Group, Chip, UriBtn, IconBtn } from "../widgets.slint";
import { Clipboard } from "../globals/clipboard.slint";
import { Icons } from "../globals/icons.slint";
import { HelpTrigger } from "../globals/help.slint";

// One row in the COMPONENTS table. Two visual lines per row: title
// (friendly name + monospace bus address in parens) above a rich
// description, with a single state-pill anchored at the top-right
// (version when the peer is online, `offline` when it isn't).
//
// Field semantics:
//   - `name`: binary name (`tisvlayd` etc.) — kept for the diagnostic
//     blob lookup that pulls per-binary versions out of the live
//     model. Not displayed.
//   - `friendly_name`: human-readable label ("Daemon" / "Session" /
//     "Tray" / "GUI" / "CLI") shown as the row title.
//   - `bus_address`: D-Bus well-known name in monospace parens
//     (`(org.tisvlay.Daemon)`). Empty for CLI (no D-Bus surface).
//   - `description`: rich one-line sentence describing what this
//     component does ("Device management, WoL at boot, …").
//   - `version`: probed runtime version. Always populated when
//     `online` is true (D-Bus const property / `--version` parse);
//     unread when offline.
//   - `tone`: drift-tone ("info" / "warn" / "danger") for the
//     version chip vs the running GUI's compile-time version.
//   - `online`: true if the surface answered (D-Bus peer reachable,
//     or `tisvlay --version` parsed cleanly). Drives both the
//     status circle and the right-column chip's content (version
//     pill vs `offline` pill).
//   - `config_path`: absolute path to the peer's config file.
//     Drives the folder-open IconBtn — present and enabled when
//     non-empty, present-but-disabled (40% opacity) for D-Bus peers
//     without a config file (e.g., GUI today), absent for the CLI
//     (which has no config of its own).
export struct AboutComponentRow {
    name: string,
    friendly_name: string,
    bus_address: string,
    description: string,
    version: string,
    tone: string,
    online: bool,
    config_path: string,
}

// Single row of the COMPONENTS table. Two-line layout: title row
// (friendly name + bus address + folder-open IconBtn) and description
// row (rich sentence). Left: 28px ✓/✗ status circle. Right: single
// chip slot — version pill when online, `offline` pill when not.
// The status circle already conveys presence, so a separate "online"
// pill would duplicate the green check; consolidating to one chip
// keeps the slot's vertical anchor steady across both states.
//
// `show-divider` draws a 1px hairline above the row using
// `Theme.border` — the parent for-loop sets it on every entry except
// the first, restoring the inter-row separators the old CONNECTIONS
// group used to render via interleaved `Rectangle`s.
//
// `open-config-folder(path)` fires when the title-row IconBtn is
// clicked. AboutPane re-emits it; main.rs lands it on the
// FileManager1.ShowItems helper.
component ComponentRow {
    in property <AboutComponentRow> entry;
    in property <bool> show-divider;
    callback open-config-folder(string);

    VerticalLayout {
        // Mirrors `Group`'s internal between-children spacing so the
        // divider sits exactly halfway between the previous row's
        // content and this row's content — equal whitespace above
        // and below the line. Using `Design.gap-stack` (8px) here
        // would render asymmetrically against `gap-block`'s 12px.
        spacing: Design.gap-block;

        if root.show-divider: Rectangle {
            height: Design.border-thin;
            background: Theme.border;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: stretch;

            // Status indicator — coloured circle with ✓/✗ glyph,
            // vertically centered in the row so it reads as the
            // row's at-a-glance marker rather than an anchor on
            // the title line. Wrapper VerticalLayout owns the
            // alignment (same intrinsic-stretch discipline the
            // right-column chip uses, just centered instead of
            // top). For D-Bus peers it indicates "service
            // responding"; for the CLI it indicates "binary on
            // PATH and `--version` parsed cleanly".
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Rectangle {
                    width: Design.size-tile-md;
                    height: Design.size-tile-md;
                    border-radius: self.width / 2;
                    background: entry.online ? Theme.success-soft : Theme.danger-soft;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;

                    Text {
                        text: entry.online ? "✓" : "✗";
                        color: entry.online ? Theme.success-text : Theme.danger-text;
                        font-weight: 700;
                        // Glyph scale tracks the circle: half the
                        // parent's width keeps the proportion stable
                        // whatever `size-tile-md` is set to.
                        font-size: parent.width / 1.5;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Left column: title + description, stacked.
            VerticalLayout {
                spacing: Design.gap-form;
                horizontal-stretch: 1;

                // Title row: friendly name + bus address + (for D-Bus
                // peers) a folder-open IconBtn that reveals the peer's
                // config file in the user's file manager. The button
                // is rendered disabled (40% opacity, no click) for
                // peers that don't have a config file on disk yet —
                // GUI today, others if the daemon's `ConfigPath`
                // property is empty. CLI rows skip the button entirely
                // (no D-Bus surface, no per-binary config of its own).
                HorizontalLayout {
                    spacing: Design.gap-tight;
                    alignment: start;
                    Text {
                        text: entry.friendly_name;
                        color: Theme.text;
                        font-size: Design.font-body;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if entry.bus_address != "": Text {
                        text: entry.bus_address;
                        color: Theme.text-dim;
                        font-size: Design.font-helper;
                        font-family: "ui-monospace, monospace";
                        vertical-alignment: center;
                    }
                    if entry.bus_address != "": IconBtn {
                        source: Icons.folder-open;
                        label: @tr("Config");
                        tip: @tr("Open config via file browser");
                        enabled: entry.config_path != "";
                        opacity: entry.config_path != "" ? 1 : Design.opacity-disabled;
                        accessible-id: "about-component-" + entry.name + "-config-button";
                        clicked => { root.open-config-folder(entry.config_path); }
                    }
                }

                Text {
                    text: entry.description;
                    color: Theme.text-dim;
                    font-size: Design.font-helper;
                    wrap: word-wrap;
                }
            }

            // Right column: single chip, top-aligned to the title
            // row. Online → version pill with drift-tone; offline →
            // `offline` pill in danger tone. Same anchor, same width
            // band, content is what flips — so the column reads as a
            // stable status column whether the row's peer is up or
            // down. The CLI's old "invisible online chip" trick is no
            // longer needed: under the new rule a CLI row that probes
            // cleanly just shows its version pill outright.
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: start;

                HorizontalLayout {
                    alignment: end;
                    Chip {
                        label: entry.online ? "v" + entry.version : @tr("offline");
                        tone: entry.online ? entry.tone : "danger";
                    }
                }
            }
        }
    }
}

export component AboutPane inherits Rectangle {
    in property <string> gui-version;
    in property <[AboutComponentRow]> components;
    in property <image> logo;

    callback view-source-clicked();
    callback view-release-clicked();
    callback view-notices-clicked();
    callback report-issue-clicked();
    callback copy-diagnostic-clicked();
    callback open-config-folder(string);

    background: Theme.surface-alt;

    ScrollView {
        VerticalLayout {
            width: 100%;
            padding-left: Design.pad-pane;
            padding-right: Design.pad-pane;
            padding-top: Design.pad-pane-top;
            padding-bottom: Design.pad-pane;
            spacing: Design.gap-pane;
            // Pack all sections at the top instead of stretch-
            // distributing extra vertical space when the window is
            // taller than the content. Without this, the default
            // `alignment: stretch` lets the first Group (whose
            // wrap: word-wrap descendants give it an unbounded
            // vertical-stretch hint) absorb the entire surplus —
            // visible as a huge gap between the page header and the
            // CONNECTIONS card on a tall window.
            alignment: start;

            // -- Header row: clickable [logo · title + tagline] (opens
            // repo URL — same target as the old "View source" button)
            // and a right-aligned column with version chip stacked
            // over the action buttons. `padding-right: pad-card`
            // matches the body padding inside the Groups below, so
            // the header's right column shares an x-coord with the
            // per-row chips. (Slint's border doesn't inset content,
            // so no `+ border-thin` adjustment is needed — the
            // Groups' 1px border sits flush with the card's outer
            // edge.)
            HorizontalLayout {
                spacing: Design.gap-pane;
                padding-right: Design.pad-card;

                // Brand area is the click target for "View source".
                // The whole region — logo + text — gets a hand
                // cursor; the title brightens to accent on hover so
                // the affordance reads even before the cursor change
                // registers.
                Rectangle {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: Design.gap-pane;
                        Image {
                            source: root.logo;
                            // Brand-area asset size — one-off larger
                            // than any `size-*` token. Not promoted.
                            width: 56px;
                            height: 56px;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                        }
                        VerticalLayout {
                            // Tighter than `gap-form` (4px) — the
                            // tagline reads as a continuation of the
                            // title rather than a separate field.
                            spacing: 2px;
                            horizontal-stretch: 1;
                            alignment: center;
                            // Title line: brand name + a trailing
                            // external-link glyph hinting the brand area
                            // is a link. Both track the hover accent so
                            // the affordance reads as one unit.
                            HorizontalLayout {
                                spacing: Design.gap-tight;
                                alignment: start;
                                Text {
                                    // Brand name; intentionally not translated.
                                    text: "TisVlay";
                                    font-size: Design.font-title-1;
                                    font-weight: 700;
                                    color: brand-touch.has-hover ? Theme.accent : Theme.text;
                                    animate color { duration: 150ms; }
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: Icons.open-link;
                                        width: Design.size-glyph;
                                        height: Design.size-glyph;
                                        colorize: brand-touch.has-hover ? Theme.accent : Theme.text;
                                        animate colorize { duration: 150ms; }
                                    }
                                }
                            }
                            Text {
                                text: @tr("TV Display control for Linux.");
                                color: Theme.text-dim;
                                font-size: Design.font-body;
                            }
                        }
                    }
                    // Hover hint for the brand-area "View source" target.
                    brand-help := HelpTrigger {
                        width: 100%;
                        height: 100%;
                        text: @tr("Open TisVlay site via web browser");
                    }
                    brand-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.view-source-clicked(); }
                        changed has-hover => {
                            if (self.has-hover) {
                                brand-help.hover-enter();
                            } else {
                                brand-help.hover-leave();
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    spacing: Design.gap-stack;
                    HorizontalLayout {
                        alignment: end;
                        Chip {
                            label: "v" + root.gui-version;
                            // `info` tone matches the COMPONENTS chips
                            // when versions agree — visual continuity
                            // for the running build's identifier.
                            tone: "info";
                            interactive: true;
                            tip: @tr("Open release notes via web browser");
                            accessible-id: "about-version-chip";
                            clicked => { root.view-release-clicked(); }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Design.gap-stack;
                        IconBtn {
                            source: Clipboard.copy-icon;
                            label: @tr("Diagnostics");
                            tip: @tr("Copy diagnostics to clipboard");
                            // Match the neighboring `Report issue`
                            // UriBtn's row height. Width auto-grows
                            // from the labeled-mode HorizontalLayout.
                            height: Design.size-input;
                            framed: true;
                            accessible-id: "about-diagnostics-button";
                            clicked => { root.copy-diagnostic-clicked(); }
                        }
                        UriBtn {
                            text: @tr("Report issue");
                            tip: @tr("Open issue tracker via web browser");
                            icon: Icons.open-link;
                            accessible-id: "about-issue-button";
                            clicked => { root.report-issue-clicked(); }
                        }
                    }
                }
            }

            // -- COMPONENTS (data-driven; one row per peer with stacked status + version pills) --
            Group {
                title: @tr("COMPONENTS");

                for c[i] in root.components: ComponentRow {
                    entry: c;
                    show-divider: i > 0;
                    open-config-folder(p) => { root.open-config-folder(p); }
                }
            }

            // -- LICENSE (project copyright + Slint upstream
            // attribution; actions live in the header) --
            Group {
                title: @tr("LICENSE");

                // Copyright row with the third-party-notices entry
                // point on the right. `UriBtn`, not `Button`: the
                // click is a URL-open affordance from the user's
                // perspective (it opens HTML in their browser), so
                // per KDE HIG / Plan 4 the pointer-cursor +
                // URL-affordance visual treatment is correct.
                HorizontalLayout {
                    spacing: Design.gap-row;
                    alignment: stretch;
                    Text {
                        // Year range and project name; intentionally not translated.
                        text: "Apache-2.0 · © 2026 TisVlay contributors";
                        color: Theme.text;
                        font-size: Design.font-helper;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    UriBtn {
                        text: @tr("View third-party notices");
                        accessible-id: "about-notices-button";
                        clicked => { root.view-notices-clicked(); }
                    }
                }

                // Slint Royalty-free 2.0 license requires an `AboutSlint`
                // widget to appear in the application's About pane.
                // Tracks slint-ui/slint LicenseRef-Slint-Royalty-free-2.0.
                //
                // The widget's source declares `preferred-width: 100%;
                // preferred-height: 100%;` so without bounds it scales
                // to fill whatever space is left in the pane —
                // overwhelming the rest of the page on a maximized
                // window. Bound it to badge-like dimensions and centre
                // horizontally; matches the visual weight Slint
                // upstream uses in their own demo pane.
                HorizontalLayout {
                    alignment: center;
                    AboutSlint {
                        max-width: 280px;
                        max-height: 96px;
                    }
                }
            }
        }
    }
}
