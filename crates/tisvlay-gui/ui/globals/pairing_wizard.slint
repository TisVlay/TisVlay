// Pairing wizard state + callbacks. The wizard is a multi-step
// flow with significant Rust-driven state (discovered TVs,
// streaming flag, pair phase) and user-driven state (selected
// index, name edits, vendor/IP/MAC for manual entry). All of it
// lives on this global so the wizard's pane and sub-components
// access state directly without prop-drilling through TvsPane /
// AppWindow.

// Types co-located here so the global owns the dependency chain:
// `components/pairing_wizard.slint` (the view) imports both the
// global and its struct types from this file, never the other
// direction.

export struct WizardDiscoveredTv {
    id: string,
    name: string,
    vendor: string,
    /// Canonical vendor for branding the tile (CEC's resolved device vendor,
    /// e.g. `lg`; else the backend id). Distinct from `vendor`, which stays
    /// the backend id used for pairing.
    brand: string,
    address: string,
    hw-model: string,
    /// Discovery-source label for the row's status chip (e.g. `SSDP`,
    /// `CEC`), derived from the daemon's `vendor_data["source"]`. A
    /// machine/protocol identifier — shown verbatim, not translated.
    source-label: string,
    /// The daemon could enumerate this device node but not open it
    /// (insufficient permissions). Flips the status chip to a warning.
    access-warning: bool,
}

// `supports-ipv4` / `supports-ipv6` mirror the vendor's
// `Capabilities::IPV4` / `Capabilities::IPV6` bits, fetched via
// `Manager1.GetVendorCapabilities` at vendor-list-publish time and
// kept on the option so any vendor-aware UX (placeholder text,
// validator hints, badges) reads them directly from the
// currently-selected option rather than round-tripping the daemon
// on every keystroke.
export struct VendorOption {
    id: string,
    name: string,
    supports-ipv4: bool,
    supports-ipv6: bool,
    // The vendor's primary descriptor — its pairing schema's first
    // field (LG: IP, CEC: device path, mock: address). Drives the
    // manual-entry panel's label/placeholder so onboarding isn't
    // hardcoded to IP-addressed vendors; `primary-is-ip` gates the
    // manual-entry MAC enrichment (an ARP lookup only makes sense
    // for an IP).
    primary-label: string,
    primary-placeholder: string,
    primary-is-ip: bool,
}

// One row in the dynamic pairing-form schema. Mirrors
// `tisvlay_core::pairing_schema::PairingField` plus a `value` slot
// for the user's current input and per-row validation state.
// The wizard's step-2 form renders
// `for row in PairingWizard.schema-fields: FieldRenderer { row; ... }`.
//
// `field-type` is the kebab-case wire string from
// `PairingFieldType` ("string" / "password" / "ip" / "mac" / "port" /
// "int" / "bool" / "select" / "path"); `FieldRenderer` switches on
// this to pick the right widget.
//
// `value` is two-way synced via `PairingWizard.field-value-edited`
// — Slint can't mutate struct fields inside a `[T]` directly, so
// edits round-trip through Rust which writes the new row back into
// the model.
//
// `state` is the field's lifecycle position:
//   "pristine" — never edited, no opinion (initial blank fields)
//   "valid"    — current `value` parses correctly per `field-type`
//   "invalid"  — current `value` fails canonical validation
// `error` is a human-readable failure reason, populated either by
// client-side validation or by routing a server-side
// `ConfigInvalidVendorConfig` D-Bus error back to the row whose
// `name` matches.
export struct PairingFieldRow {
    name: string,
    label: string,
    helper: string,
    field-type: string,
    required: bool,
    placeholder: string,
    options: [string],
    value: string,
    state: string,
    error: string,
    /// Set true when the row's `value` was populated by
    /// `autofill_schema` (SSDP discovery or manual-entry MAC
    /// enrichment) rather than typed by the user. Drives the
    /// "auto-detected" badge in `SchemaForm`; flipped to false by
    /// Rust on the first `field-value-edited` for this row.
    autofilled: bool,
}

export global PairingWizard {
    // -- Driven from Rust --
    /// Whether the wizard is currently displayed. Set true on
    /// `Daemon.request-pair()` and false on cancel/finish.
    in-out property <bool> active;
    in-out property <int> step: 1;
    in-out property <[WizardDiscoveredTv]> discovered;
    in-out property <bool> discovery-streaming;
    in-out property <string> discovery-error;
    /// True while a manual-entry MAC enrichment RPC is in flight
    /// (after the user clicks Add manually, before the wizard
    /// transitions to step 2). Drives a distinct loading state —
    /// *not* `discovery-streaming`, which means "Scanning for
    /// TVs" — and gates the Continue button so double-clicks
    /// can't fan out parallel RPCs.
    in-out property <bool> manual-lookup-streaming;
    in-out property <string> pair-phase;
    in-out property <string> pair-message;
    /// TV id of the currently-running pair handshake, used by the
    /// wizard's `cancel` callback to invoke `Manager1.CancelPair`.
    /// Set immediately at handshake invoke time on both flows:
    /// - For re-pair, from the caller-provided argument (the GUI
    ///   knows the tv_id before opening the wizard).
    /// - For AddTv, from the `Manager1.AddTv` RPC return — since
    ///   AddTv is async-spawn, the RPC returns the reserved tv_id
    ///   right after sync validation, before any progress signal
    ///   would arrive. No "first signal wins" race window.
    /// Cleared by `reset_wizard`. Empty means no pair in flight.
    in-out property <string> pair-tv-id;
    /// What the done step says about the MAC the TV reported at pairing:
    /// "" (nothing to say), "filled" (stored, the field was blank),
    /// "differs" (kept the entered one — offer the reported), or "saved"
    /// (the reported one was adopted). Set from the pairing terminal.
    in-out property <string> mac-notice;
    in-out property <string> mac-reported;
    in-out property <string> mac-configured;
    /// Inline error when adopting the reported MAC fails.
    in-out property <string> mac-error;
    /// Vendors registered on the running daemon, fetched via
    /// `Manager1.GetSupportedVendors`. Pushed once at startup.
    in-out property <[VendorOption]> supported-vendors;
    in-out property <[string]> supported-vendor-names;
    /// Mirrors the currently-selected discovered TV's fields.
    /// Published as separate properties (instead of indexing into
    /// the model from Slint) because struct-from-model bindings
    /// have been unreliable across step transitions.
    in-out property <string> selected-vendor;
    // Display name for `selected-vendor` (e.g. "LG WebOS"), looked
    // up from `supported-vendors` by Rust at every setter site.
    // Slint can't iterate a model in pure-binding context, so this
    // parallel property avoids hardcoding `id → name` mappings on
    // the UI side.
    in-out property <string> selected-vendor-name;
    in-out property <string> selected-address;
    in-out property <string> selected-hw-model;

    /// Dynamic pairing-form schema for the currently-selected vendor.
    /// Populated by Rust on entry to step 2 by fetching
    /// `Manager1.GetPairingSchema(vendor)` and applying autofill
    /// from each row's `vendor_data` map (per
    /// `PairingField::autofill = "discovery.<key>"`).
    /// `field-value-edited(index, value)` is the writeback channel
    /// — Slint emits it when a `FieldRenderer`'s value changes;
    /// Rust mutates the model row in place.
    in-out property <[PairingFieldRow]> schema-fields;
    /// Whether every required schema field currently has a non-empty
    /// value AND no field is in `state == "invalid"`. Computed
    /// Rust-side on each `field-value-edited` (Slint can't fold over
    /// a `[T]` model from a property expression). Step 2's `Pair`
    /// button binds `enabled` to this — disabled until the user has
    /// filled (or autofill provided) all required fields.
    in-out property <bool> schema-valid;
    callback field-value-edited(int, string);

    // -- Two-way: Rust seeds, the wizard's controls write back --
    in-out property <int> selected-index: -1;
    in-out property <string> tv-name;
    // The name the wizard last auto-filled from a picked entry. A pick
    // replaces `tv-name` while it still equals this (the user hasn't
    // typed over it), so going Back and picking another TV doesn't keep
    // the previous TV's name.
    in-out property <string> tv-name-autofilled;
    in-out property <string> system-profile;
    in-out property <bool> managed: true;
    // Index into `supported-vendors` for the vendor the user picked
    // in the manual-add path's vendor select. Default 0 = first
    // alphabetically-sorted vendor (the `state_watch` publisher
    // sorts before publishing). The ThemedSelect shows
    // `supported-vendor-names[manual-vendor-index]` and writes picks
    // back here via its `selected-index` callback; Rust at `manual-add`
    // time reads `supported-vendors[manual-vendor-index]` to recover the
    // id + display name. Single source of truth replaces the prior
    // `manual-vendor` (id) + `manual-vendor-name` (display) pair.
    in-out property <int> manual-vendor-index: 0;
    in-out property <string> manual-ip;

    // -- Callbacks --
    callback cancel();
    callback step-next();
    callback step-back();
    callback retry-pair();
    callback back-to-discovery();
    /// Done step, "differs": write the reported MAC to the TV's config.
    callback use-reported-mac();
    /// Done step, "differs": keep the entered MAC (dismiss the notice).
    callback keep-configured-mac();
    callback finish();
    callback selected-changed(int);
    callback name-edited(string);
    callback profile-selected(string);
    callback managed-toggled(bool);
    callback manual-ip-edited(string);
    callback manual-add();
}
