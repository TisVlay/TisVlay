// Couch mode: the layout for a TV across the room, driven by a remote.
// Rust decides `active` from the preference and the session (the
// `couch` module), applies the window side (maximized, the scale on top
// of the compositor's) and persists the preference the Settings pane
// edits through the callbacks. The panes read `active` for what changes
// in the layout and the keys.
export global Couch {
    /// The 10-foot layout is on.
    in-out property <bool> active;
    /// The preference: "auto" (follow the session), "on" or "off".
    in-out property <string> mode: "auto";
    /// The scale on top of the display's own, in percent.
    in-out property <int> scale-percent: 140;
    /// The user picked a mode in Settings.
    callback mode-changed(string);
    /// The user set a scale in Settings.
    callback scale-changed(int);
}
