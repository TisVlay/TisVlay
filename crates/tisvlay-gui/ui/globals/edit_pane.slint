// Edit-mode state for the TVs pane's INFO group.
//
// Only one TV is edited at a time. `tv-uuid` is the empty string
// when no edit session is active; setting it via `start(uuid)` puts
// the matching TV's INFO group into edit mode (pencil → Cancel/Save,
// labels → inputs). Mirrors the multi-step wizard's global-state
// pattern so views stay declarative and Rust drives the lifecycle.
//
// Submit semantics match the pairing wizard: per-field validation
// runs on every edit (`PairingField::validate`); `valid` gates the
// Save button; server-side schema errors surface inline on the
// originating field.

import { PairingFieldRow } from "pairing_wizard.slint";

export global EditPane {
    /// UUID of the TV currently being edited. Empty string when no
    /// edit session is active. The TVs pane reads this to switch
    /// the matching `TvDetail`'s INFO group between view-mode and
    /// edit-mode rendering.
    in-out property <string> tv-uuid;

    /// Editable display name. Two-way bound to a `LineEditField` in
    /// edit mode; Rust-seeded from `Tv1.GetConfig` on `start()`.
    in-out property <string> name;

    /// Schema-driven vendor-config field rows. Same shape as the
    /// pairing wizard's `schema-fields`; rendered through the
    /// shared `SchemaForm` component.
    in-out property <[PairingFieldRow]> fields;

    /// Whether the current draft passes per-field validation. Gates
    /// the Save button. Recomputed Rust-side on every
    /// `name-edited` / `field-edited` callback.
    in-out property <bool> valid;

    /// Generic error banner copy — populated when `Tv1.UpdateConfig`
    /// fails for reasons that don't map to a single field
    /// (network, daemon-side I/O, etc.). Cleared on next `start()`
    /// or `cancel()`.
    in-out property <string> error;

    /// Set while a Save is in flight so the form can disable inputs
    /// and the button can show "applying…". Cleared on completion
    /// regardless of success/failure.
    in-out property <bool> saving;

    /// Begin an edit session for the given TV. Rust prefetches
    /// `Tv1.GetConfig`, populates `name` + `fields` from the
    /// vendor's `config_schema`, and sets `tv-uuid` last so the
    /// view doesn't flash a half-populated form.
    callback start(string);

    /// Discard the draft and exit edit mode. No daemon call.
    callback cancel();

    /// Submit the draft to `Tv1.UpdateConfig`. On success, clears
    /// the session. On per-field failure, marks the offending row
    /// invalid and stays in edit mode so the user can correct it.
    callback save();

    /// User edited the name field. Rust updates `name` and
    /// recomputes `valid`.
    callback name-edited(string);

    /// User edited a vendor field. Rust validates the new value,
    /// mutates the matching row in `fields`, and recomputes
    /// `valid`. Mirrors the pairing wizard's `field-value-edited`.
    callback field-edited(int, string);
}
