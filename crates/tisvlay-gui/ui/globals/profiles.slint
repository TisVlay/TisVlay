// Profiles-pane state + callbacks.
//
// The pane is master-detail with two stacked sections (System / User)
// in the left column. Selection is global across sections — one
// `(kind, uuid)` pair at a time, regardless of which list it came
// from. Rust pushes the section row lists + holds the current
// selection in the global so the detail can re-render without
// prop-drilling through the pane.
//
// Identity is the immutable UUID minted at create time on the
// daemon side; the friendly name is a mutable body field and can
// change without breaking references. Click handlers and `confirm-*`
// callbacks all carry the UUID; the friendly name is for display
// only.

/// Which catalog a profile belongs to. `none` is the unselected
/// sentinel — the detail shows the "Select a profile" empty state
/// while this is `none`.
export enum ProfileKind {
    none,
    system,
    user,
}

/// One TV that references a profile. Carries the UUID for
/// click-through navigation (`Profiles.open-tv(uuid)`), the
/// friendly name for the Used-by-row LinkText, and the per-TV
/// `automated` state — drives the LinkText's `text-color` tint
/// (success/info) so the Used-by row reads the same 3-state
/// classification the master-list row aggregate uses.
export struct ProfileTvRef {
    uuid: string,
    name: string,
    automated: bool,
}

/// One inheritable field rendered as a row in the detail editor.
/// Built Rust-side per-field from the selected profile's body.
/// `kind` is the dispatch tag — `"enum"` (ComboBox) or `"number"`
/// (SpinBox); `"bool"` and `"text"` are reserved placeholders for
/// future field shapes. Variant-specific fields below are populated
/// by Rust only for the matching kind; inactive variants are
/// zeroed / empty.
///
/// Every field of every variant lands on the struct up front rather
/// than growing the schema later — Slint generates Rust types at
/// `include_modules!` time, so retroactively adding a field would
/// trigger a full Slint reload in a later commit that produced no
/// visual change.
///
/// `current-value` carries a trailing inherit overlay (the resolved
/// token plus a presentation-only marker) when an enum field is
/// inheriting — both signals the state visually and ensures picking
/// the same-as-resolved value still fires `selected(v)` (no ComboBox
/// no-op). Number rows skip the overlay; gutter accent + reset glyph
/// carry the inherit signal.
export struct ProfileFieldEntry {
    field-name: string,
    label: string,
    kind: string,
    /// ComboBox model for `kind == "enum"`.
    options: [string],
    /// ComboBox displayed text for `kind == "enum"` (with possible
    /// inherit-overlay suffix while inheriting — see above).
    current-value: string,
    /// SpinBox value + bounds + step + unit for `kind == "number"`.
    /// Rust clamps `number-value` to `[min-value, max-value]` at
    /// row-build time.
    number-value: int,
    min-value: int,
    max-value: int,
    step: int,
    unit: string,
    /// Switch state for `kind == "bool"`.
    bool-value: bool,
    /// Drives the 2 px left gutter accent + reset-glyph visibility.
    is-locally-set: bool,
    /// This row carries the restore-input + stream-gate toggle slots —
    /// true on every `SessionAction` action row (never on `automate_when`,
    /// number, or bool rows). Both toggles always render on such rows; the
    /// `*-enabled` flags decide whether each is interactive or inert.
    has-toggles: bool,
    /// The mapping's resolved `restore_input` modifier (the toggle's
    /// pressed/glyph state).
    restore-value: bool,
    /// Restore-input is interactive on this row (resolved verb is not
    /// `none`). When false the toggle renders inert + dimmed.
    restore-enabled: bool,
    /// The resolved `restore_input` differs from the field's floor
    /// default — drives the accent tint (locally-changed language),
    /// distinct from the toggle's on/off value.
    restore-differs: bool,
    /// The mapping's resolved `while_streaming` gate — `true` fires while
    /// armed by a stream, `false` suppresses. Drives the toggle's
    /// pressed/glyph state.
    stream-gate-value: bool,
    /// The gate is interactive on this row (resolved verb is not `none`
    /// and this is not a connect/disconnect event). When false the toggle
    /// renders inert + dimmed.
    stream-gate-enabled: bool,
    /// The resolved `while_streaming` gate differs from the field's floor
    /// default — drives the accent tint. Neutral at the floor (`false`
    /// for wake events, `true` for the exempted system events), accented
    /// when changed either way.
    stream-gate-differs: bool,
}

/// One profile entry in either section. Read-only from Slint;
/// populated by Rust via `Profiles.set-system(...)` /
/// `set-user(...)`.
export struct ProfileRow {
    /// Hyphenated UUID string — the daemon-side identity. Used as
    /// the selection key and on the wire for catalog calls.
    uuid: string,
    /// Bare profile name from the body's `name` field. Used by the
    /// rename-pencil input prefill (the bare value the daemon will
    /// validate against). Read-only display surfaces should bind
    /// `display-name` instead — that's the form with the localized
    /// "default" word and the default-indicator glyph applied.
    name: string,
    /// Read-only display form of the name. For the reserved-default
    /// profile this is `format!("{}\u{00A0}\u{2713}", gettext("default"))`
    /// — localized "default" with a trailing CHECK MARK. For every
    /// other profile this matches `name` verbatim. Synthesized in
    /// `state.rs::display_profile_name`. Bind this in master-list
    /// rows, the detail-header read-only Text, and TVs-pane profile-
    /// selector ComboBox models / current-values.
    display-name: string,
    /// True for the reserved default profile
    /// (`DEFAULT_SYSTEM_PROFILE_UUID` /
    /// `DEFAULT_USER_PROFILE_UUID`). Gates the Delete-button enabled
    /// state in the detail header.
    is-default: bool,
    /// TVs referencing this profile, resolved client-side from the
    /// in-memory TV list via the shared `references_of` helper.
    /// Drives the master-list "Nx" trailing count and the detail
    /// header's "Used by [chip]…" row. Click-through routes via
    /// `Profiles.open-tv(uuid)`.
    referenced-by: [ProfileTvRef],
    /// Pre-built comma-joined TV-name list. Empty when nothing
    /// references this profile. The delete-confirm dialog uses
    /// this to render an inline "still used by X, Y, Z" message
    /// — Slint has no array-join expression, so Rust pre-computes
    /// the summary.
    referenced-by-summary: string,
    /// True iff at least one referencing TV is currently automated.
    /// Combined with `referenced-by.length` to derive the 3-state
    /// row classification: Unassigned (empty), Assigned (non-empty,
    /// `!active`), Active (non-empty, `active`).
    active: bool,
}

export global Profiles {
    /// Master-list row clicked. `kind` disambiguates which section
    /// the row came from so the Rust handler can route per-bus.
    /// Argument 2 is the UUID.
    callback select(ProfileKind, string);
    /// "+" button on a section header → user typed a name in the
    /// `NameInputDialog` → Confirm. Rust dispatches to
    /// `Manager1.CreateSystemProfile(name)` /
    /// `Session1.CreateUserProfile(name)`. Duplicate-name rejection
    /// surfaces as a toast (Slint pure functions can't iterate
    /// existing names for client-side validation).
    callback confirm-create(ProfileKind, string);
    /// Detail-header Delete after the user clicks through the
    /// confirm-delete dialog. Argument 2 is the UUID. Rust routes
    /// to `Manager1.DeleteSystemProfile` /
    /// `Session1.DeleteUserProfile`.
    callback confirm-delete(ProfileKind, string);
    /// Confirm-duplicate from the name-input dialog. Args:
    /// `(kind, source_uuid, new_name)`. Rust routes to
    /// `Manager1.DuplicateSystemProfile` /
    /// `Session1.DuplicateUserProfile`. The new profile's locally-
    /// set fields mirror the source; the daemon validates the new
    /// name (non-empty, reserved-name, uniqueness) and surfaces
    /// rejections as a toast.
    callback confirm-duplicate(ProfileKind, string, string);
    /// "Used by" chip clicked — navigate to the TVs pane and
    /// select the named TV. Rust flips `AppWindow.active-pane` +
    /// sets `selected-tv-index`.
    callback open-tv(string);
    /// TVs pane PROFILES-row pencil clicked — navigate to the
    /// Profiles pane and open the profile by UUID (the reverse of
    /// `open-tv`: TVs → Profiles instead of Profiles → TVs). Routed
    /// by UUID rather than friendly name so a rename race or
    /// transient duplicate name can't misroute the navigation —
    /// UUIDs are immutable. Rust looks up the matching `ProfileRow`
    /// in this global's `system` / `user` model, populates the
    /// selection triple (`selected-kind` / `selected-uuid` /
    /// `selected-row`), flips `AppWindow.active-pane` to the
    /// Profiles pane, then spawns the same editor-priming task the
    /// master-list `select` callback runs.
    callback open-profile-by-uuid(ProfileKind, string);
    /// A ComboBox selection committed in a `ProfileFieldRow`. Args
    /// are `(field_name, value)` — the wire-id of the field plus
    /// the picked concrete enum value. Rust dispatches the field
    /// patch through `UpdateSystemProfile` / `UpdateUserProfile`.
    /// Reverting to inheriting goes through `reset-field`, not here.
    callback value-edited(string, string);
    /// The restore-input checkbox on an on-ish action row toggled.
    /// Args: field name, new checked state.
    callback restore-edited(string, bool);
    /// The stream gate toggle on an action row toggled. Args:
    /// field name, new `while_streaming` value (true fires while armed).
    /// Rust writes the whole event table (verb + modifiers) — the gate
    /// is a per-event modifier, not a separate field.
    callback stream-gated(string, bool);
    /// Numeric counterpart to `value-edited`. Arg 2 is the picked
    /// integer; Rust clamps to the field's `[min, max]` and casts to
    /// `u32` before dispatching the field patch.
    callback value-edited-number(string, int);
    /// Boolean counterpart to `value-edited` (the Switch rows). Args:
    /// field name, new checked state.
    callback value-edited-bool(string, bool);
    /// Reset glyph on a `ProfileFieldRow` clicked. Arg is the
    /// field-name; Rust dispatches a body patch that sets the field
    /// to `None` (the inherit-from-chain signal).
    callback reset-field(string);
    /// Bottom-of-pane "Reset all" toolbar button clicked. Rust
    /// dispatches a body patch zeroing every inheritable field on
    /// the selected profile.
    callback reset-all();
    /// Detail-header pencil → user committed a new friendly name via
    /// the inline edit affordance. Routes to a `name`-only field
    /// patch through `UpdateSystemProfile` / `UpdateUserProfile`. The
    /// daemon-side validation rules (empty / reserved / duplicate /
    /// rename-default) surface as a toast; the master list +
    /// detail header redraw from the echoed `SystemProfileChanged` /
    /// `UserProfileChanged` signal.
    callback rename-selected(string);

    in property <[ProfileRow]> system;
    in property <[ProfileRow]> user;
    /// False when `tisvlay-session` isn't connected — the User
    /// section renders a "Session service unavailable" hint instead
    /// of the list, and the User-section `+` is disabled.
    in property <bool> session-available: false;

    /// `selected-kind` + `selected-uuid` are written by the master
    /// list's click handlers (so the row highlight updates instantly)
    /// AND by Rust (when the selection is cleared because the
    /// selected profile was deleted out from under us, or when
    /// auto-selecting after create). `selected-row` is written both
    /// from Slint (master-list click handler hands off the `r`
    /// loop-variable so the detail header materializes on the same
    /// frame as the click — no Rust round-trip needed) and from
    /// Rust (`push_profiles` re-asserts it whenever the underlying
    /// lists refresh so `referenced-by` counts and the friendly
    /// name stay in sync after a daemon-side change).
    in-out property <ProfileKind> selected-kind: ProfileKind.none;
    in-out property <string> selected-uuid;
    in-out property <ProfileRow> selected-row;

    /// Field-editor rows for the currently selected profile. Rust
    /// primes this whenever the selection changes (master-list
    /// click, auto-select after add, refresh after `ReloadConfig`),
    /// and refreshes individual rows on a `SystemProfileChanged` /
    /// `UserProfileChanged` signal echo. Empty when no profile is
    /// selected.
    in property <[ProfileFieldEntry]> editor-fields;
    /// The STREAMING card's rows for the selected profile —
    /// the while-streaming overrides (plus the screencast-arms switch on
    /// user profiles). Primed and refreshed alongside `editor-fields`;
    /// empty when no profile is selected.
    in property <[ProfileFieldEntry]> editor-stream-fields;
    /// True when the selected profile has at least one
    /// locally-set field (across both cards) — drives the "Reset
    /// all" button's enabled state. Greys out when there's nothing
    /// to reset so the affordance reads as inert rather than
    /// performing a no-op round-trip.
    in property <bool> editor-can-reset-all: false;
}
