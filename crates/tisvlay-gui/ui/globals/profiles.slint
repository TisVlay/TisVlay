// Profile-pane state + callbacks.
//
// The pane is master-detail with two stacked sections (System / User)
// in the left column. Selection is global across sections — one
// `(kind, name)` pair at a time, regardless of which list it came
// from. Rust pushes the section row lists + holds the current
// selection in the global so the detail can re-render without
// prop-drilling through the pane.
//
// Each row carries the count + identity of the TVs referencing it so
// the master list can show the trailing "Nx" hint and the detail
// header can render "Used by [chip][chip]" with click-through to the
// TVs pane.

/// Which catalog a profile belongs to. `none` is the unselected
/// sentinel — the detail shows the "Select a profile" empty state
/// while this is `none`.
export enum ProfileKind {
    none,
    system,
    user,
}

/// One TV that references a profile. Carries the UUID for navigation
/// (`Profiles.open-tv(uuid)`) and the friendly name for chip rendering.
export struct ProfileTvRef {
    uuid: string,
    name: string,
}

/// One profile entry in either section. Read-only from Slint;
/// populated by Rust via `Profiles.set_system(...)` / `set_user(...)`.
export struct ProfileRow {
    name: string,
    /// True for the reserved `default` profile — drives the
    /// `(default)` badge in the list and disables the Delete button
    /// in the detail header.
    is-default: bool,
    /// TVs referencing this profile, precomputed Rust-side from the
    /// TV list. Drives the master-list "Nx" trailing count and the
    /// detail header's "Used by [chip]…" row. Click-through routes
    /// via `Profiles.open-tv(uuid)`.
    referenced-by: [ProfileTvRef],
    /// Pre-built comma-joined TV-name list. Empty when nothing
    /// references this profile. The delete-confirm dialog uses this
    /// to render an inline "used by X, Y, Z" message — Slint has no
    /// array-join expression, so Rust pre-computes the summary.
    referenced-by-summary: string,
}

/// One row in the field editor for the currently-selected profile.
///
/// The combobox model on the row is `[inherit-placeholder, ...concrete
/// options]` — Rust precomputes the placeholder string
/// (`(inherit: power_on)` etc.) so the Slint side doesn't need to
/// concat arrays in a binding. Selecting the placeholder, or clicking
/// the row's reset glyph, both surface as
/// `field-edited(field-name, "")` to keep one wire shape for "clear
/// this field". `current-value` is the empty string when the field
/// inherits, else the literal locally-set value (e.g. `"power_off"`).
export struct ProfileField {
    /// Wire identifier — matches the `SystemProfileConfig` /
    /// `UserProfileConfig` field name. Round-trips back to Rust on
    /// `field-edited` so the handler knows which field to patch.
    field-name: string,
    /// Display label for the row's left column. Pre-translated.
    label: string,
    /// Full combobox model: first entry is the inherit placeholder,
    /// the rest are concrete enum variants in the order they should
    /// render. Pre-translated where applicable.
    options: [string],
    /// Currently locally-set value, or `""` when the field inherits.
    /// Drives the 2 px gutter accent + reset-glyph visibility.
    current-value: string,
}

export global Profiles {
    /// Master-list row clicked. `kind` disambiguates which section
    /// the row came from so the Rust handler knows whether to fetch
    /// via `Manager1.GetSystemProfile` or `Session1.GetUserProfile`.
    callback select(ProfileKind, string);
    /// "+" button on a section header (Slint opens the
    /// `NameInputDialog` directly; this is the post-confirm call
    /// that fires `Manager1.CreateSystemProfile` /
    /// `Session1.CreateUserProfile`).
    callback confirm-create(ProfileKind, string);
    /// Detail-header Delete after the user clicks through the
    /// confirm-delete dialog. Rust routes to the correct daemon
    /// based on the kind.
    callback confirm-delete(ProfileKind, string);
    /// Detail-header Duplicate. Rust reads the selected profile
    /// body from the editor cache, generates `<orig>-copy[-N]`,
    /// and calls the matching `Create*Profile`. No dialog because
    /// the auto-generated name is deterministic.
    callback duplicate-selected();
    /// "Used by" chip clicked — navigate to the TVs pane and select
    /// the named TV. Rust flips `AppWindow.active-pane` + sets
    /// `selected-tv-index`.
    callback open-tv(string);
    /// A field in the currently-selected profile was edited or
    /// reset. `value` is the locally-set value, or `""` to clear the
    /// field back to inheriting. Rust routes to the matching daemon
    /// `Update*Profile` call (which lands wired in the next commit).
    callback field-edited(string, string);

    in property <[ProfileRow]> system;
    in property <[ProfileRow]> user;
    /// False when `tisvlay-session` isn't connected — the User
    /// section renders a "User profiles unavailable" hint instead of
    /// the list, and `create-user` is disabled.
    in property <bool> session-available: false;

    /// `selected-kind` + `selected-name` are written by the master
    /// list's click handlers (so the row highlight updates instantly)
    /// AND by Rust (when the selection is cleared because the selected
    /// profile was deleted out from under us). `selected-row` is
    /// Rust-only — pushed whenever the lists or selection change so
    /// the detail can re-render its header + chips without doing a
    /// list-walk in Slint expressions (Slint pure functions don't
    /// support `for` loops).
    in-out property <ProfileKind> selected-kind: ProfileKind.none;
    in-out property <string> selected-name;
    in property <ProfileRow> selected-row;
    /// Field rows for the currently-selected profile. Empty when no
    /// profile is selected or before the daemon `Get*Profile` fetch
    /// completes. Rust pushes the resolved field list on selection
    /// change + on `*ProfileChanged` / `ConfigReloaded` signals.
    in property <[ProfileField]> current-fields;
}
