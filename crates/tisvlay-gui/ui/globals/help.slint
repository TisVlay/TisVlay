// Contextual-help popover, rendered as an in-window overlay (NOT a
// Slint PopupWindow). A PopupWindow steals focus (→ hover flicker),
// can't read the window size (→ no edge-aware placement), and its
// focus grab made a clicked-open bubble undismissable. An overlay at
// the AppWindow root sidesteps all three: it escapes the detail's
// clipping ScrollView, sees the window size for placement, and never
// grabs focus.
//
// Triggers (ContextualHelpButton, IconBtn) don't render the bubble.
// They push their content + absolute anchor geometry to the `Help`
// global; a single `HelpOverlay` at the root reads it and draws the
// bubble — centered over the anchor, shifted to stay on screen, and
// flipped below when there's no room above.

import { Theme } from "../theme.slint";
import { Design } from "../design.slint";

// Absolute (window-space) geometry of the control the help describes.
export struct HelpAnchor {
    x: length,
    y: length,
    width: length,
    height: length,
}

export global Help {
    // Active request (empty `text` ⇒ nothing shown).
    in-out property <string> text;
    in-out property <[string]> bullets;
    in-out property <HelpAnchor> anchor;
    // The region (in window coords) the bubble is confined to — the
    // originating ScrollView's viewport, pushed by that ScrollView. So
    // an anchor scrolled past the viewport edge pins the bubble to the
    // ScrollView's edge, not the window's, keeping it clear of chrome
    // outside the scroll area (header, sidebar). `width == 0` ⇒ unset,
    // fall back to the whole window.
    in-out property <HelpAnchor> clip;
    // Which trigger owns the active request (so a trigger only closes
    // its own help, and a re-click toggles the right one).
    in-out property <int> owner;
    in-out property <int> next-id: 1;
    // Click-latched (persists until dismissed) vs transient hover.
    in-out property <bool> pinned;
    // The owning trigger's live hover (post-delay) and the bubble's own
    // hover — either keeps a transient (unpinned) help open. Moving from
    // the glyph onto the bubble to read it must not dismiss it.
    in-out property <bool> requester-hovered;
    in-out property <bool> bubble-hovered;
    // Bumped on scroll / window-resize so the owning button re-pushes
    // its live `anchor` (the overlay then re-clamps). Read lazily in the
    // buttons' change handlers — not a geometry property itself — so it
    // never forces an `absolute-position` read during layout.
    in-out property <int> reposition-tick;

    out property <bool> shown: root.text != ""
        && (root.pinned || root.requester-hovered || root.bubble-hovered);

    // Hand each trigger a stable id once, at init.
    public function claim-id() -> int {
        root.next-id += 1;
        return root.next-id - 1;
    }

    // Transient hover open; never overrides a pinned bubble.
    public function hover-open(id: int, t: string, b: [string], a: HelpAnchor) {
        if (!root.pinned) {
            root.owner = id;
            root.text = t;
            root.bullets = b;
            root.anchor = a;
            // Start each request with a clean bubble-hover flag: a
            // `visible: false` bubble doesn't emit `has-hover = false`,
            // so a stale `true` from a prior bubble could otherwise keep
            // this one latched open after the pointer has left.
            root.bubble-hovered = false;
            root.requester-hovered = true;
        }
    }
    public function hover-close(id: int) {
        if (root.owner == id && !root.pinned) {
            root.requester-hovered = false;
        }
    }

    // Click toggle: re-clicking the same trigger dismisses; otherwise
    // pin this trigger's help open.
    public function toggle(id: int, t: string, b: [string], a: HelpAnchor) {
        if (root.pinned && root.owner == id) {
            root.dismiss();
        } else {
            root.owner = id;
            root.text = t;
            root.bullets = b;
            root.anchor = a;
            root.pinned = true;
            root.requester-hovered = false;
            root.bubble-hovered = false;
        }
    }

    public function dismiss() {
        root.pinned = false;
        root.requester-hovered = false;
        root.bubble-hovered = false;
        root.text = "";
        // Clear the owner too, so no stale trigger reads as the owner
        // between bubbles (every owner check is paired with `shown`
        // today, but a bare `owner` read would otherwise mis-attribute).
        root.owner = 0;
        // Reset the clip so the next bubble (which may not live in a
        // ScrollView) falls back to the whole window until its own
        // ScrollView, if any, re-pushes a region.
        root.clip = { x: 0, y: 0, width: 0, height: 0 };
    }
}

// The bubble body: a shadowed, bordered card with a wrapped paragraph
// and optional bullet rows. Fixed width so text wraps; height flows. An
// outer transparent inset gives the drop shadow room.
component HelpBubble inherits Rectangle {
    in property <string> text;
    in property <[string]> bullets;
    // Cap on the text column. The bubble shrinks BELOW this to fit
    // short text, and only grows to (and wraps at) the cap for long
    // text — so a one-liner gets a snug box, not a fixed-width one.
    in property <length> max-text-width: 320px;
    property <length> pad: 10px;   // card inner padding, each side
    property <length> inset: 8px;  // shadow breathing room, each side

    // Slint reports a word-wrap Text's preferred-width as its NoWrap
    // (natural single-line) width, so `col.preferred-width` is the
    // widest line in the content. Fit the column to it, clamped to the
    // cap; the Texts then wrap within `text-w` only once it has to
    // clamp. (Same result as Qt's hidden 1-line measuring Text, native.)
    property <length> text-w: min(col.preferred-width, root.max-text-width);

    width: root.text-w + root.pad * 2 + root.inset * 2;
    height: card.height + root.inset * 2;
    background: transparent;

    card := Rectangle {
        x: root.inset;
        y: root.inset;
        width: root.text-w + root.pad * 2;
        height: col.preferred-height + root.pad * 2;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: Design.border-thin;
        border-radius: Design.radius-card;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.drop-shadow;
        drop-shadow-offset-y: 4px;

        col := VerticalLayout {
            x: root.pad;
            y: root.pad;
            width: root.text-w;
            spacing: Design.gap-tight;
            if root.text != "": Text {
                text: root.text;
                wrap: word-wrap;
                width: 100%;
                color: Theme.text;
                font-size: Design.font-helper;
            }
            for bullet in root.bullets: HorizontalLayout {
                spacing: Design.gap-tight;
                Text {
                    text: "•";
                    color: Theme.text-faint;
                    font-size: Design.font-helper;
                }
                Text {
                    text: bullet;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    color: Theme.text;
                    font-size: Design.font-helper;
                }
            }
        }
    }
}

// Rendered once at the AppWindow root. Fills the window so it can read
// the window size and place the bubble edge-aware.
export component HelpOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: Help.shown;

    property <length> margin: 8px;
    property <length> gap: 6px;

    // Clamp region: the originating ScrollView's viewport (Help.clip)
    // when set, else the whole window. Confining to the ScrollView keeps
    // a scrolled-away bubble from riding up over the header / sidebar.
    property <bool> has-clip: Help.clip.width > 0;
    property <length> clip-x: root.has-clip ? Help.clip.x : 0;
    property <length> clip-y: root.has-clip ? Help.clip.y : 0;
    property <length> clip-w: root.has-clip ? Help.clip.width : root.width;
    property <length> clip-h: root.has-clip ? Help.clip.height : root.height;

    // Centered over the anchor, clamped into the clip region.
    property <length> anchor-cx: Help.anchor.x + Help.anchor.width / 2;
    property <length> place-x: clamp(
        root.anchor-cx - bubble.width / 2,
        root.clip-x + root.margin,
        max(root.clip-x + root.margin, root.clip-x + root.clip-w - bubble.width - root.margin));
    // Above the anchor if it fits within the region, else flip below;
    // then clamp into the region so a scrolled-off anchor pins the
    // bubble to the region's edge rather than the window's.
    property <bool> room-above: Help.anchor.y - bubble.height - root.gap >= root.clip-y + root.margin;
    property <length> raw-y: root.room-above
        ? Help.anchor.y - bubble.height - root.gap
        : Help.anchor.y + Help.anchor.height + root.gap;
    // A bubble taller than the clip region would collapse the y-clamp
    // range (lo == hi) and pin to the region top, covering the anchor.
    // Fall back to the window for the vertical clamp so it stays fully
    // visible (a bubble taller than the scroll viewport is degenerate).
    property <bool> y-fits-region: root.clip-h >= bubble.height + root.margin * 2;
    property <length> bound-y: root.y-fits-region ? root.clip-y : 0;
    property <length> bound-h: root.y-fits-region ? root.clip-h : root.height;
    property <length> place-y: clamp(
        root.raw-y,
        root.bound-y + root.margin,
        max(root.bound-y + root.margin, root.bound-y + root.bound-h - bubble.height - root.margin));

    // No full-window scrim: a Slint TouchArea can't catch clicks while
    // passing hover through, so a scrim would freeze the cursor over
    // every control (including other info buttons) until dismissed —
    // pseudo-modal, unlike KDE's non-modal popup. Instead the overlay
    // intercepts nothing but the bubble itself, so the cursor stays
    // live everywhere. A pinned bubble is dismissed by re-clicking its
    // (highlighted) "i" or switching to another.
    bubble := HelpBubble {
        x: root.place-x;
        y: root.place-y;
        text: Help.text;
        bullets: Help.bullets;

        // Keep an unpinned bubble open while the pointer is on it.
        TouchArea {
            changed has-hover => {
                Help.bubble-hovered = self.has-hover;
            }
        }
    }
}
