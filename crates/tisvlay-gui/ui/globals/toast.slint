// Top-center ephemeral toast for short "action succeeded" feedback.
// Distinct from `Errors` (sticky, in-pane Kirigami inline-message)
// — toast is a window-overlay, auto-clears after a short timeout
// driven by Rust (no Slint-side timer; tokio + on_ui from main.rs).
//
// Convention here: the toast is success-only. Clipboard failures and
// similar errors stay silent (matching KDE/Plasma's "no toast for
// failures" default); use `Errors` for surfaces that need user
// attention. The one window-level failure surface is the notice: a
// sticky inline message for an action that isn't tied to a pane (the
// sidebar's Reload), so it shows whichever pane is open and stays
// until dismissed.
//
// Usage:
//   - Slint side: `Toast.show("Copied to clipboard.")` from any
//     callback. The Rust handler at `Toast.on_show` schedules the
//     auto-clear.
//   - Rust side: `show_toast(&app_weak, "...", duration_ms)` helper
//     in `main.rs` for symmetry from non-Slint paths (e.g., the
//     `Clipboard.on_copy` chokepoint, where every CopyBtn press
//     and the diagnostic-copy button converge).

import { Theme } from "../theme.slint";
import { Design } from "../design.slint";
import { InlineError } from "../widgets.slint";

export global Toast {
    in-out property <string> message;
    /// The sticky failure notice: an empty title hides it, and the
    /// user's dismiss clears it. Set from Rust (`show_notice`).
    in-out property <string> notice-title;
    in-out property <string> notice-message;
    callback show(string);
}

// The notice, sized by the parent's width; its message renders
// monospace, since what lands here is diagnostic text (a TOML parse
// error draws a caret under the offending column).
export component NoticeView inherits Rectangle {
    visible: Toast.notice-title != "";
    height: self.visible ? inline.height : 0;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.drop-shadow;
    drop-shadow-offset-y: 6px;
    border-radius: Design.radius-card;

    inline := InlineError {
        width: 100%;
        tone: "error";
        title: Toast.notice-title;
        message: Toast.notice-message;
        message-font-family: "monospace";
        dismissed => {
            Toast.notice-title = "";
            Toast.notice-message = "";
        }
    }
}

export component ToastView inherits Rectangle {
    visible: Toast.message != "";

    // Toasts surface short success messages dynamically; AT users
    // need the text announced when it appears. Slint 1.16 doesn't
    // expose `accessible-live` (slint-ui/slint#11646 landed
    // post-release); the role + label combination at least makes
    // the content readable when the AT client polls.
    accessible-role: text;
    accessible-label: Toast.message;

    // Window-level children inherit the Window's full size unless
    // bound explicitly, so size to the inner Text's preferred
    // dimensions plus padding rather than relying on
    // horizontal-stretch (which only applies inside a layout).
    width: msg.preferred-width + 32px;
    height: msg.preferred-height + 16px;

    // Solid surface base so the toast doesn't reveal whatever the
    // panes below are showing through. `accent-soft` (the same
    // low-alpha tint used for selection backgrounds) is layered on
    // top via the inner Rectangle, picking up the user's DE accent
    // color without bleeding the pane through. Border and drop
    // shadow live on the outer so they render over the tint.
    background: Theme.surface;
    border-color: Theme.accent;
    border-width: 1.5px;
    border-radius: Design.radius-pill;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.drop-shadow;
    drop-shadow-offset-y: 6px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.accent-soft;
        border-radius: Design.radius-pill;
    }

    msg := Text {
        x: 16px;
        y: 8px;
        text: Toast.message;
        color: Theme.text;
        font-size: Design.font-body;
    }
}
