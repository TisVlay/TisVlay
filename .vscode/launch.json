{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: daemon",
            "cargo": {
                "args": ["build", "--profile", "test", "--bin", "tisvlay"]
            },
            "args": ["service", "daemon", "--ephemeral"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug,zbus=warn,rustls=warn,tungstenite=warn"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: session service",
            "cargo": {
                "args": ["build", "--profile", "test", "--bin", "tisvlay"]
            },
            "args": ["service", "session", "--ephemeral"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug,zbus=warn"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: tray",
            "cargo": {
                "args": ["build", "--profile", "test", "--bin", "tisvlay"]
            },
            "args": ["service", "tray"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug,zbus=warn,ksni=warn"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: CLI status",
            "cargo": {
                "args": ["build", "--profile", "test", "--bin", "tisvlay"]
            },
            "args": ["status"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug,zbus=warn"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: CLI list",
            "cargo": {
                "args": ["build", "--profile", "test", "--bin", "tisvlay"]
            },
            "args": ["list"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug,zbus=warn"
            }
        }
    ]
}
