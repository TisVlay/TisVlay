{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "daemon: start",
            "type": "shell",
            "command": "cargo run --bin tisvlayd -- --session --config docs/configs/daemon.toml",
            "isBackground": true,
            "options": {
                "env": {
                    "RUST_LOG": "debug,zbus=warn,rustls=warn,tungstenite=warn"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "tisvlay"
            }
        },
        {
            "label": "daemon: start (system bus)",
            "type": "shell",
            "command": "cargo build --bin tisvlayd && sudo -E ./target/debug/tisvlayd --config docs/configs/daemon.toml",
