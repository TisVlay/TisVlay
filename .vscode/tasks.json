        {
            "label": "all: stop",
            "type": "shell",
            "command": "pkill -f 'target/debug/tisvlayd' ; pkill -f 'target/debug/tisvlay-session' ; pkill -f 'target/debug/tisvlay-tray' ; echo 'All stopped'",
