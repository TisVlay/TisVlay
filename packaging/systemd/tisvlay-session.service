[Unit]
Description=TisVlay Session Event Monitor
Documentation=https://github.com/TisVlay/TisVlay
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# System socket explicit: the packaged daemon listens in /run/tisvlay,
# not the per-user runtime dir the dev default points at. The per-user
# socket (user profiles) keeps its $XDG_RUNTIME_DIR default.
ExecStart=/usr/bin/tisvlay service session --system-socket /run/tisvlay/zenoh.sock
SyslogIdentifier=tisvlay-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
