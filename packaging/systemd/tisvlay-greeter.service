[Unit]
Description=tisvlay greeter idle client (plasma-login-manager)
Documentation=https://github.com/ruffsl/tisvlay
# A systemd *user* unit for the greeter user (e.g. plasmalogin). The greeter
# compositor must be up so its Wayland socket and the ext-idle-notify-v1
# global exist before connect_to_env(); WAYLAND_DISPLAY/XDG_RUNTIME_DIR are
# inherited from the greeter user manager (no Environment= needed).
After=plasma-login-kwin_wayland.service
Requires=plasma-login-kwin_wayland.service
# Tie our lifetime to the greeter session: when the target stops (the user
# logs in), we stop too. BindsTo also stops us if the compositor dies.
PartOf=plasma-login-wayland.target
BindsTo=plasma-login-wayland.target

[Service]
Type=simple
ExecStart=/usr/bin/tisvlay-greeter
# on-failure (not always): a clean exit when the compositor disconnects at
# login must not restart-loop.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-login-wayland.target
