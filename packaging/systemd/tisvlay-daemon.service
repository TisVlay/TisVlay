[Unit]
Description=TisVlay TV Control Daemon
Documentation=https://github.com/TisVlay/TisVlay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The zenoh listener lives in RuntimeDirectory; clients connect with
# membership in the tisvlay group (the daemon chmods the socket 0660
# after bind). State (TV table, pairing credentials) persists in
# StateDirectory. --greeter-access adds a POSIX ACL for the display
# manager's greeter group (auto-detected: gdm / Debian-gdm) so the
# login-screen greeter client can reach the socket; it is a quiet no-op
# on non-GDM desktops where no such group exists.
ExecStart=/usr/bin/tisvlay service daemon --socket /run/tisvlay/zenoh.sock --config /var/lib/tisvlay/daemon.toml --greeter-access
SyslogIdentifier=tisvlay-daemon
# `systemctl reload` applies a hand edit of the store file (the daemon
# treats SIGHUP as its reload rpc).
ExecReload=/bin/kill -HUP $MAINPID
User=tisvlay
Group=tisvlay
Restart=on-failure
RestartSec=5

# Config and state in /var/lib/tisvlay/ (writable, persists across restarts).
# Works on immutable root filesystems (Silverblue, Bazzite, etc.).
StateDirectory=tisvlay
StateDirectoryMode=0750

# Socket dir. Group-traversable so tisvlay-group clients can reach the
# socket; preserved across restarts so connect-only clients redial the
# same path.
RuntimeDirectory=tisvlay
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart

# --- Security hardening ---
# Kept in sync with packaging/nix/module.nix.
# Baseline filesystem / privilege confinement.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# PrivateDevices gives a minimal private /dev with no /dev/cecN. To drive
# a TV over HDMI-CEC, comment this out and instead add:
#   DeviceAllow=char-cec rw
# then grant this unit's user rw on the nodes with a udev rule, e.g.
#   KERNEL=="cec[0-9]*", GROUP="tisvlay", MODE="0660"
# The NixOS module gates exactly this behind services.tisvlay.cec.enable.
PrivateDevices=true
NoNewPrivileges=true

# Network: UNIX (zenoh socket), INET{4,6} (WebSocket to TVs, WoL, SSDP),
# NETLINK (carrier / route monitoring for NIC failover). No PACKET/BLUETOOTH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# No mmap+x, no realtime scheduling, no setuid, no namespace creation.
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Kernel surface: deny /proc/sys writes, module load, kmsg reads,
# cgroup edits, and hostname/clock mutation.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid

# Daemon needs no capabilities — runs as an unprivileged system user.
CapabilityBoundingSet=
AmbientCapabilities=

# System-call allowlist: @system-service set is designed for
# long-running daemons; strip the riskier subsets.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources

# Files the daemon creates (pairing credentials, state rewrites)
# should not be world-readable. StateDirectoryMode already enforces
# 0750 on the directory; UMask takes care of files within. The zenoh
# socket is the one exception — the daemon chmods it 0660 after bind.
UMask=0077

# Clean up any SysV IPC left by the service user at shutdown.
RemoveIPC=true

[Install]
WantedBy=multi-user.target
