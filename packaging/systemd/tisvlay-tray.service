[Unit]
Description=TisVlay System Tray
Documentation=https://github.com/TisVlay/TisVlay
After=graphical-session.target tisvlay-session.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tisvlay-tray --socket /run/tisvlay/zenoh.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
