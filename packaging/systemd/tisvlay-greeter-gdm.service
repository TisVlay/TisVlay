[Unit]
Description=TisVlay greeter idle client (GDM)
Documentation=https://github.com/TisVlay/TisVlay
# A systemd *user* unit for GDM's greeter session. GDM launches the greeter via
# `gnome-session --session=gnome-login`, which reaches
# `gnome-session@gnome-login.target` — the greeter-only attach point (the GDM
# analogue of plasma-login-wayland.target). The greeter's primary group is `gdm`
# (`Debian-gdm` on Debian), whether the account is static or GDM's dynamic-userdb
# one, and the daemon's greeter-group ACL (--greeter-access) admits that group to
# the 0660 socket; a greeter it doesn't admit finds the socket unreadable and
# exits cleanly instead of looping. The target being up implies Mutter is up, so
# the idle transport (ext-idle-notify or Mutter.IdleMonitor) is available;
# WAYLAND_DISPLAY / XDG_RUNTIME_DIR are inherited from the greeter user manager.
After=gnome-session@gnome-login.target
PartOf=gnome-session@gnome-login.target

[Service]
Type=simple
ExecStart=/usr/bin/tisvlay service greeter --socket /run/tisvlay/zenoh.sock
SyslogIdentifier=tisvlay-greeter
# on-failure (not always): a clean exit — compositor disconnect at login, the
# timeout-disabled early exit, or an unreadable socket — must not restart-loop.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=gnome-session@gnome-login.target
