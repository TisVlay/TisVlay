<!--
Handlebars template for THIRD-PARTY-LICENSES.html — the bundled
attribution shipped at /usr/share/doc/tisvlay/ in each nfpm package.
Regenerated by `just licenses-html` before packaging; gitignored.

Iterates `overview` for license sections (one per SPDX id, with the
canonical `text` field from cargo-about's `LicenseSet`) and `crates`
for the per-crate manifest. We skip the `licenses` array here because
subtle text variations between crates of the same license produce
visual duplicates that aren't what an end-user attribution bundle
should surface. See `docs/cargo-about/src/generate.rs:31-43` for the
LicenseSet shape.

`prefers-color-scheme` so the page works in both light and dark
distro browsers without any user toggle.
-->
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <style>
        @media (prefers-color-scheme: dark) {
            body {
                background: #1e1e1e;
                color: #d4d4d4;
            }
            a {
                color: #4ec9b0;
            }
            .license-text, .crate-table {
                background: #252526;
            }
            .crate-table td {
                border-color: #3c3c3c;
            }
        }
        @media (prefers-color-scheme: light) {
            body {
                background: #ffffff;
                color: #1e1e1e;
            }
            .license-text, .crate-table {
                background: #f5f5f5;
            }
            .crate-table td {
                border-color: #e0e0e0;
            }
        }
        .container {
            font-family: ui-sans-serif, system-ui, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            padding: 24px;
        }
        .intro {
            text-align: center;
            margin-bottom: 32px;
        }
        .licenses-overview {
            list-style-type: none;
            margin: 0;
            padding: 0;
            columns: 2;
        }
        .crate-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 16px;
            border-radius: 4px;
            overflow: hidden;
            font-size: 0.9em;
        }
        .crate-table td, .crate-table th {
            padding: 6px 12px;
            border-bottom: 1px solid;
            text-align: left;
        }
        .crate-table th {
            font-weight: 600;
        }
        .license-section {
            margin-top: 32px;
        }
        .license-text {
            white-space: pre-wrap;
            padding: 12px;
            border-radius: 4px;
            font-family: ui-monospace, monospace;
            font-size: 0.85em;
            max-height: 360px;
            overflow-y: auto;
        }
    </style>
    <title>TisVlay — Third-Party Licenses</title>
</head>

<body>
    <main class="container">
        <div class="intro">
            <h1>TisVlay — Third-Party Licenses</h1>
            <p>This page lists every crate transitively used to build TisVlay's binaries, alongside the canonical text of each license that appears in the dependency graph.</p>
        </div>

        <h2>Overview</h2>
        <ul class="licenses-overview">
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <h2>Crates</h2>
        <table class="crate-table">
            <thead>
                <tr><th>Name</th><th>Version</th><th>License</th></tr>
            </thead>
            <tbody>
                {{#each crates}}
                <tr>
                    <td><a href="{{#if package.repository}}{{package.repository}}{{else}}https://crates.io/crates/{{package.name}}{{/if}}">{{package.name}}</a></td>
                    <td>{{package.version}}</td>
                    <td>{{license}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h2>License texts</h2>
        {{#each overview}}
        <section class="license-section">
            <h3 id="{{id}}">{{name}} <small>({{id}}, {{count}} crate(s))</small></h3>
            <pre class="license-text">{{text}}</pre>
        </section>
        {{/each}}
    </main>
</body>

</html>
