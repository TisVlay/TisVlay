[Unit]
Description=LG WebOS TV Control Daemon
Documentation=https://github.com/ruffsl/tisvlay
After=network-online.target
Wants=network-online.target

[Service]
Type=dbus
BusName=org.tisvlay.Daemon
ExecStart=/usr/bin/tisvlayd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Runtime state (boot marker in /run/tisvlay/)
RuntimeDirectory=tisvlay

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

# Allow access to config directory
ReadWritePaths=/etc/tisvlay

[Install]
WantedBy=multi-user.target
