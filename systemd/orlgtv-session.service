[Unit]
Description=LG WebOS TV Session Service
Documentation=https://github.com/ruffsl/orlgtv
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/orlgtv-session
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Run in user session context
Slice=session.slice

[Install]
WantedBy=graphical-session.target
