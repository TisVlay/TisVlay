[Unit]
Description=tisvlay TV Control System Tray
Documentation=https://github.com/ruffsl/tisvlay
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tisvlay-tray
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=graphical-session.target
