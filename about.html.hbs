<!--
Handlebars template for THIRD-PARTY-LICENSES.html — the bundled
attribution shipped at /usr/share/doc/tisvlay/ in each nfpm package.
Regenerated by `just licenses-html` before packaging; gitignored.

Layout follows cargo-about's upstream default (docs/cargo-about/about.hbs):
- Overview list at the top with anchors to each license section.
- Per-license blocks with the full text, listing every crate using
  that license under "Used by:".

`prefers-color-scheme` so the page works in both light and dark
distro browsers without any user toggle.
-->
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <style>
        @media (prefers-color-scheme: dark) {
            body {
                background: #1e1e1e;
                color: #d4d4d4;
            }
            a {
                color: #4ec9b0;
            }
            .license-text {
                background: #252526;
            }
        }
        @media (prefers-color-scheme: light) {
            body {
                background: #ffffff;
                color: #1e1e1e;
            }
            .license-text {
                background: #f5f5f5;
            }
        }
        .container {
            font-family: ui-sans-serif, system-ui, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            padding: 24px;
        }
        .intro {
            text-align: center;
            margin-bottom: 32px;
        }
        .licenses-overview {
            list-style-type: none;
            margin: 0;
            padding: 0;
            columns: 2;
        }
        .licenses-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        .license {
            margin-bottom: 32px;
        }
        .license-used-by {
            margin-top: -8px;
            font-size: 0.9em;
        }
        .license-text {
            max-height: 360px;
            overflow-y: scroll;
            white-space: pre-wrap;
            padding: 12px;
            border-radius: 4px;
            font-family: ui-monospace, monospace;
            font-size: 0.85em;
        }
    </style>
    <title>TisVlay — Third-Party Licenses</title>
</head>

<body>
    <main class="container">
        <div class="intro">
            <h1>TisVlay — Third-Party Licenses</h1>
            <p>This page lists the licenses of every crate transitively used to build TisVlay's binaries.</p>
        </div>

        <h2>Overview</h2>
        <ul class="licenses-overview">
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <h2>License texts</h2>
        <ul class="licenses-list">
            {{#each licenses}}
                <li class="license">
                    {{#if first_of_kind}}
                        <h3 id="{{id}}">{{name}}</h3>
                    {{/if}}
                    <h4 id="{{id}}-{{@index}}">{{name}}</h4>
                    <h5>Used by:</h5>
                    <ul class="license-used-by">
                        {{#each used_by}}
                        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
                        {{/each}}
                    </ul>
                    <pre class="license-text">{{text}}</pre>
                </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>
